#!/bin/sh
# @req FR-222 -- Codex wrapper: run codex, then report its latest session's
#   usage (FR-221), never letting the report change codex's own exit code.
# @spec ADR-087 D7
# @tested tests/unit/zuri-harness-plugin.test.js
set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
START_TIME=$(node -e "process.stdout.write(new Date().toISOString())")

codex "$@"
CODEX_EXIT=$?

node "$SCRIPT_DIR/zuri-harness.mjs" report --codex-latest --since "$START_TIME" >/dev/null 2>&1 || true

exit "$CODEX_EXIT"
