  @@index([businessId, status])
}

model BusinessRoadmapHorizon {
  id          String    @id @default(uuid())
  roadmapId   String
  key         String
  label       String
  position    Int
  description String?
  targetAt    DateTime?
  createdAt   DateTime  @default(now())

  roadmap BusinessRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  goals   BusinessGoal[]

  @@unique([roadmapId, key])
  @@unique([roadmapId, position])
  @@index([roadmapId])
}

model BusinessGoal {
  id          String    @id @default(uuid())
  businessId  String
  roadmapId   String?
  horizonId   String?
  code        String    @unique
  title       String
  description String?
  status      String    @default("PLANNED")
  priority    String    @default("MEDIUM")
  progress    Float     @default(0)
  startAt     DateTime?
  targetAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)

  business Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roadmap  BusinessRoadmap?        @relation(fields: [roadmapId], references: [id])
  horizon  BusinessRoadmapHorizon? @relation(fields: [horizonId], references: [id])
  projects ProjectGoal[]

  @@index([businessId, status])
  @@index([roadmapId])
  @@index([horizonId])
}

model ProjectGoal {
  projectId String
  goalId    String
  createdAt DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal    BusinessGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([projectId, goalId])
  @@index([goalId])
}

model Workstream {
  id                      String    @id @default(uuid())
  code                    String    @unique
  projectId               String
  name                    String
  executionMode           String
  executionModeId         String?
  // @req FR-090 — same reason as PersonCredential above: the column is live on
  // the Supabase database with a distinct value on every Workstream row, so
  // leaving it undeclared made a DROP COLUMN the diff's recommendation.
  laneId                  String?
  executionContractId     String?
  contractVersion         String?
  primaryDomainId         String?
  supportingDomainIdsJson String    @default("[]")
  technicalOwnerDomainId  String?
  identityRefsJson        String    @default("{}")
  progressStrategy        String
  progressWeight          Float     @default(1)
  status                  String    @default("PLANNED")
  progressCache           Float     @default(0)
  viewConfigJson          String    @default("{}")
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  version                 Int       @default(1)

  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  containers       WorkContainer[]
  items            WorkItem[]
  milestones       Milestone[]
  gates            Gate[]
  assetAllocations AssetProjectAllocation[]

  @@index([projectId])
  @@index([executionMode])
  @@index([executionModeId])
  @@index([laneId])
}

// @req FR-069, FR-070 — server-owned import identity and idempotency receipt.
// One receipt binds a client idempotency key to the exact normalized payload
// and execution run. It is not a second Plan model.
model PlanImportReceipt {
  idempotencyKey          String   @id
  payloadHash             String
  executionRunId          String   @unique
  executionStepId         String?
  attemptId               String?
  stepKey                 String   @default("plan.import.commit")
  status                  String   @default("SUCCEEDED")
  correlationId           String
  schemaVersion           String
  projectId               String
  replayOfExecutionRunId  String?
  replayOfExecutionStepId String?
  auditEventId            String?
  createdAt               DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([correlationId])
  @@index([replayOfExecutionRunId])
}

model WorkContainer {
  id           String    @id @default(uuid())
  code         String    @unique
  workstreamId String
  parentId     String?
  subtype      String
  title        String
  status       String    @default("PLANNED")
  startAt      DateTime?
  targetAt     DateTime?
  metadataJson String    @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  version      Int       @default(1)

  workstream Workstream      @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  parent     WorkContainer?  @relation("ContainerHierarchy", fields: [parentId], references: [id])
  children   WorkContainer[] @relation("ContainerHierarchy")
  items      WorkItem[]

  @@index([workstreamId])
  @@index([parentId])
  @@index([subtype])
}

model WorkItem {
  id             String    @id @default(uuid())
  code           String    @unique
  workstreamId   String
  containerId    String?
  subtype        String
  title          String
  status         String    @default("PLANNED")
  assigneeRef    String?
  weight         Float     @default(1)
  numericValue   Float?
  probability    Float?
  metricDataJson String    @default("{}")
  metadataJson   String    @default("{}")
  startAt        DateTime?
  targetAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)

  workstream Workstream     @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  container  WorkContainer? @relation(fields: [containerId], references: [id])
  files      ProjectFile[]
  fileAssets FileAsset[]

  @@index([workstreamId])
  @@index([containerId])
  @@index([subtype])
  @@index([status])
}

model Milestone {
  id           String    @id @default(uuid())
  code         String    @unique
  projectId    String
  workstreamId String?
  title        String
  status       String    @default("PLANNED")
  weight       Float     @default(1)
  targetAt     DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream Workstream? @relation(fields: [workstreamId], references: [id])

  @@index([projectId])
  @@index([workstreamId])
}

model Gate {
  id           String    @id @default(uuid())
  code         String    @unique
  projectId    String
  workstreamId String?
  title        String
  status       String    @default("OPEN")
  required     Boolean   @default(true)
  evidenceJson String    @default("{}")
  targetAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream Workstream? @relation(fields: [workstreamId], references: [id])

  @@index([projectId])
  @@index([workstreamId])
}

model Dependency {
  id             String   @id @default(uuid())
  sourceType     String
  sourceId       String
  targetType     String
  targetId       String
  dependencyType String
  createdAt      DateTime @default(now())

  @@unique([sourceType, sourceId, targetType, targetId, dependencyType])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}

model Repository {
  id             String   @id @default(uuid())
  code           String   @unique
  // The owning Business. Nullable for the same reason Project.businessId was
  // (FR-043): the column is additive over rows that predate it. A Repository
  // with no Business is governed by nobody and is refused for every principal
  // (FR-073), which is why the backfill exists — see
  // scripts/backfill-repository-business.mjs.
  //
  // Business rather than Tenant or Portfolio, and that is forced rather than
  // chosen: the viewer contract carries only Business-keyed grants, so no
  // principal can hold authority above Business (SDD-037). A Tenant-scoped
  // Repository would be ungovernable — the same dead end that keeps
  // /api/scope and /api/backup/import unrepayable.
  businessId     String?
  provider       String
  externalRepoId String?
  ownerName      String?
  repoName       String?
  fullName       String?
  url            String?
  defaultBranch  String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business?           @relation(fields: [businessId], references: [id])
  projects ProjectRepository[]

  @@index([provider, fullName])
  @@index([businessId])
}

model ProjectRepository {
  id        String   @id @default(uuid())
  projectId String
  repoId    String
  role      String
  pathScope String?
  branch    String?
  createdAt DateTime @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo    Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([projectId, repoId, role])
  @@index([repoId])
}

// FR-037 — metadata/reference record for a Project document or attachment.
// Binary bytes are intentionally outside the offline MVP. `url`/`blobRef` are
// storage references, never identifiers; the record keeps its own UUID + code.
model ProjectFile {
  id         String   @id @default(uuid())
  code       String   @unique
  projectId  String
  workItemId String?
  name       String
  mime       String
  size       Int
  url        String?
  blobRef    String?
  version    Int      @default(1)
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([workItemId])
}

// @req FR-045 - device-local root for the authoritative SQLite file metadata graph.
// @spec ADR-016, SDD-023, ZV2-CR-001
model LocalWorkspaceMount {
  id         String    @id @default(uuid())
  tenantId   String
  businessId String
  deviceKey  String
  rootPath   String
  status     String    @default("ACTIVE")
  lastScanAt DateTime?
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, deviceKey])
  @@index([tenantId])
}

// @req FR-045 - authoritative, portable metadata identity for managed local files.
// @spec ADR-016, SDD-023, ZV2-CR-001
model FileAsset {
  id           String    @id @default(uuid())
  code         String    @unique
  tenantId     String
  businessId   String
  projectId    String?
  workItemId   String?
  storageKind  String
  relativePath String?
  externalUrl  String?
  blobRef      String?
  name         String
  mime         String
  size         Int
  sha256       String?
  status       String    @default("ACTIVE")
  version      Int       @default(1)
  uploadedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  business      Business        @relation(fields: [businessId], references: [id])
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workItem      WorkItem?       @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  links         FileLink[]
  assetEvidence AssetEvidence[]
  lineOaRichMenuVersions LineOaRichMenuVersion[]
  paymentSlips  Payment[]

  @@index([tenantId])
  @@index([businessId])
  @@index([projectId])
  @@index([workItemId])
}

// @req FR-045 - typed secondary FileAsset relation with indexed entity lookup.
// @spec ADR-016, SDD-023, ZV2-CR-001
model FileLink {
  id           String   @id @default(uuid())
  fileId       String
  entityType   String
  entityId     String
  relationType String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  file FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, entityType, entityId, relationType])
  @@index([entityType, entityId])
}

// @req FR-133 — physical identity and lifecycle root; never FileAsset content.
// @req FR-135 — current pointers never replace the temporal child histories.
// @spec SDD-078, SDD-080, BR-023, SEC-023, ADR-055
// @tested tests/unit/asset-management-schema-contract.test.js
model RegisteredAsset {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String
  intakeId          String?   @unique
  lotId             String?
  assetCode         String
  name              String
  categoryCode      String
  description       String?
  brand             String?
  model             String?
  serialNumber      String?
  status            String    @default("ACTIVE")
  condition         String    @default("GOOD")
  acquisitionAmount String?
  currency          String?
  receivedOn        DateTime?
  registeredAt      DateTime?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant                 Tenant                       @relation(fields: [tenantId], references: [id])
  business               Business                     @relation(fields: [businessId], references: [id])
  intake                 AssetIntake?                 @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  lot                    AssetLot?                    @relation(fields: [lotId], references: [id], onDelete: SetNull)
  evidence               AssetEvidence[]
  procurementRefs        AssetProcurementRef[]
  responsibilities       AssetResponsibility[]
  locations              AssetLocationHistory[]
  projectAllocations     AssetProjectAllocation[]
  depreciationCandidates AssetDepreciationCandidate[]

  @@unique([businessId, assetCode])
  @@index([tenantId, businessId, status])
  @@index([businessId, serialNumber])
  @@index([lotId])
}

// @req FR-134 — source/channel and validation state for one converged envelope.
// @spec SDD-079, BR-024, SEC-023, ADR-055
model AssetIntake {
  id                     String    @id @default(uuid())
  tenantId               String
  businessId             String
  intakeCode             String
  schemaVersion          String
  sourceChannel          String
  sourceCorrelationId    String
  origin                 String
  status                 String    @default("DRAFT")
  payloadSha256          String?
  normalizedEnvelopeJson String    @default("{}")
  validationJson         String    @default("{}")
  validatedAt            DateTime?
  pipelineRunId          String?
  submittedByPersonId    String?
  submittedAt            DateTime?
  approvedByPersonId     String?
  approvedAt             DateTime?
  version                Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  tenant                 Tenant                       @relation(fields: [tenantId], references: [id])
  business               Business                     @relation(fields: [businessId], references: [id])
  registeredAsset        RegisteredAsset?
  evidence               AssetEvidence[]
  procurementRefs        AssetProcurementRef[]
  depreciationCandidates AssetDepreciationCandidate[]

  @@unique([businessId, intakeCode])
  @@unique([businessId, sourceChannel, sourceCorrelationId])
  @@index([tenantId, businessId, status])
  @@index([businessId, payloadSha256])
  @@index([pipelineRunId])
}

// @req FR-134 — Asset owns evidence role/review while FileAsset owns content.
// @spec SDD-078, SDD-079, SEC-023
model AssetEvidence {
  id                 String    @id @default(uuid())
  tenantId           String
  businessId         String
  intakeId           String
  registeredAssetId  String?
  fileAssetId        String
  role               String
  status             String    @default("ACTIVE")
  sha256             String?
  paymentReference   String?
  extractionJson     String    @default("{}")
  reviewJson         String    @default("{}")
  reviewedByPersonId String?
  reviewedAt         DateTime?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  intake          AssetIntake          @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  registeredAsset RegisteredAsset?     @relation(fields: [registeredAssetId], references: [id], onDelete: SetNull)
  fileAsset       FileAsset            @relation(fields: [fileAssetId], references: [id])
  extractionJobs  AssetExtractionJob[]

  @@unique([intakeId, fileAssetId, role])
  @@index([tenantId, businessId, status])
  @@index([registeredAssetId])
  @@index([businessId, sha256])
  @@index([businessId, paymentReference])
}

// @req FR-134 — typed Asset-side references; Procurement remains the writer.
// @spec SDD-078, BR-023, BR-024
model AssetProcurementRef {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String
  intakeId          String
  registeredAssetId String?
  type              String
  system            String
  value             String
  lineValue         String?
  status            String    @default("UNRESOLVED")
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  intake          AssetIntake      @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  registeredAsset RegisteredAsset? @relation(fields: [registeredAssetId], references: [id], onDelete: SetNull)

  @@unique([intakeId, type, system, value, lineValue])
  @@index([tenantId, businessId, type])
  @@index([registeredAssetId])
}

// @req FR-135 — controlled lot identity and expiry within one Business.
// @spec SDD-078, SDD-080, BR-024
model AssetLot {
  id             String    @id @default(uuid())
  tenantId       String
  businessId     String
  lotCode        String
  manufacturedOn DateTime?
  expiresOn      DateTime
  status         String    @default("ACTIVE")
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  business Business          @relation(fields: [businessId], references: [id])
  assets   RegisteredAsset[]

  @@unique([businessId, lotCode])
  @@index([tenantId, businessId, expiresOn])
}

// @req FR-135 — accountable/custodian/user roles are effective intervals.
// @spec SDD-080, BR-023, SEC-023
model AssetResponsibility {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String
  registeredAssetId String
  role              String
  personId          String
  orgUnitSystem     String?
  orgUnitRef        String?
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  acknowledgedAt    DateTime?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  registeredAsset RegisteredAsset @relation(fields: [registeredAssetId], references: [id], onDelete: Cascade)
  person          Person          @relation(fields: [personId], references: [id])

  @@index([tenantId, businessId, role])
  @@index([registeredAssetId, role, effectiveTo])
  @@index([personId, effectiveTo])
}

// @req FR-135 — Branch is referenced; physical detail and movement history are Asset-owned.
// @spec SDD-080, BR-023, SEC-023
model AssetLocationHistory {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String
  registeredAssetId String
  branchId          String?
  locationCode      String
  locationName      String
  isPrimary         Boolean   @default(true)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  registeredAsset RegisteredAsset @relation(fields: [registeredAssetId], references: [id], onDelete: Cascade)
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, businessId, effectiveTo])
  @@index([registeredAssetId, isPrimary, effectiveTo])
  @@index([branchId])
}

// @req FR-135 — Asset owns the effective allocation; Project Inventory reads a projection.
// @spec SDD-080, BR-023, SEC-023, ADR-034
model AssetProjectAllocation {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String
  registeredAssetId String
  projectId         String
  workstreamId      String?
  quantity          Float     @default(1)
  exclusive         Boolean   @default(true)
  status            String    @default("ACTIVE")
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  registeredAsset RegisteredAsset @relation(fields: [registeredAssetId], references: [id], onDelete: Cascade)
  project         Project         @relation(fields: [projectId], references: [id])
  workstream      Workstream?     @relation(fields: [workstreamId], references: [id], onDelete: SetNull)

  @@index([tenantId, businessId, status])
  @@index([registeredAssetId, exclusive, effectiveTo])
  @@index([projectId, effectiveTo])
  @@index([workstreamId])
}

// @req FR-136 — versioned deterministic preview; never an accounting posting.
// @spec SDD-080, NFR-021, BR-023, ADR-055
model AssetDepreciationCandidate {
  id                 String    @id @default(uuid())
  tenantId           String
  businessId         String
  intakeId           String?
  registeredAssetId  String?
  method             String
  acquisitionAmount  String
  residualValue      String
  currency           String
  usefulLifeMonths   Int
  startDate          DateTime
  calculationVersion String
  scheduleJson       String
  status             String    @default("PREVIEW")
  reviewedByPersonId String?
  reviewedAt         DateTime?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  intake          AssetIntake?     @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  registeredAsset RegisteredAsset? @relation(fields: [registeredAssetId], references: [id], onDelete: SetNull)

  @@index([tenantId, businessId, status])
  @@index([intakeId])
  @@index([registeredAssetId])
}

// FR-019 — Enterprise integration: a customer's own core id mapped onto our
// internal UUID. Generalizes LegalEntityIdentifier / Repository.externalRepoId.
// An external value is NEVER a primary key and never becomes our `code`
// (code = our namespace, value = the customer's namespace).
// @req FR-021 — a channel/auth identity (a LINE user) mapped to a Person (the
// principal), tenant-scoped. Because V2 unified identity into Person (ADR-003 §D10),
// principalId is a real FK to Person — no polymorphic CUSTOMER|EMPLOYEE landmine.
// providerSubject (the lineUserId) is an attribute, never a PK (BR-002).
model ExternalIdentity {
  id              String    @id @default(uuid())
  tenantId        String
  personId        String
  provider        String // 'LINE' (later FACEBOOK | GOOGLE)
  providerSubject String // the lineUserId
  verifiedAt      DateTime?
  linkedAt        DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider, providerSubject])
  @@index([personId])
}

// FR-022 — account linking: a single-use, expiring nonce that binds a channel
// subject (a LINE user) to an EXISTING Person, instead of minting a fresh one.
// Persisted because redemption crosses a stateless webhook boundary.
model IdentityLinkToken {
  id         String    @id @default(uuid())
  tenantId   String
  personId   String
  provider   String    @default("LINE")
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([personId])
  @@index([tenantId])
}

model ExternalRef {
  id         String    @id @default(uuid())
  entityType String // PROJECT | WORKSTREAM | WORK_CONTAINER | WORK_ITEM | MILESTONE | GATE
  entityId   String // internal UUID
  system     String // "SAP" | "SALESFORCE" | "LEGACY_POS" | ...
  value      String // the customer's core id, e.g. CUST-88421
  labelAs    Boolean   @default(true) // show value as the display label
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([system, value])
  @@index([entityType, entityId])
}

// @req FR-023 — the Zuri Backend Slice's CRM core (ADR-007 P2). A Customer is a
// per-tenant CRM record linked to a Person principal (personId), so businesses in
// one tenant share the customer (the CRM-sharing decision) while the channel
// identity stays on ExternalIdentity. Soft-delete + version like other aggregates.
model Customer {
  id             String    @id @default(uuid())
  code           String    @unique
  tenantId       String
  businessId     String?
  personId       String
  displayName    String
  lifecycleStage String    @default("LEAD")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  version        Int       @default(1)

  // @req FR-103 — SEC-005 PDPA consent. Lives directly on Customer rather than a
  // separate per-business join: the FR-023 docstring above already makes this row
  // the CRM-sharing unit ("businesses in one tenant share the customer"), so a
  // second table keyed by (Customer, Business) would duplicate a scope this row
  // already carries. `consentStatus` defaults to PENDING for every new Customer;
  // `GRANDFATHERED` is the one-time backfill value for rows that predate this
  // column (see the paired migration) — it is never written by the service.
  consentStatus             String    @default("PENDING")
  consentRecordedAt         DateTime?
  consentRecordedByPersonId String?
  consentNote               String?

  tenant                Tenant                         @relation(fields: [tenantId], references: [id])
  business              Business?                      @relation(fields: [businessId], references: [id])
  person                Person                         @relation(fields: [personId], references: [id])
  consentRecordedBy     Person?                        @relation("CustomerConsentRecordedBy", fields: [consentRecordedByPersonId], references: [id])
  conversations         Conversation[]
  importProvenance      CustomerImportProvenance[]     @relation("CustomerImportProvenanceCustomer")
  importReviewDecisions CustomerImportReviewDecision[] @relation("CustomerImportReviewDecisionTargetCustomer")
  salesTasks            SalesTask[]
  salesOrders           SalesOrder[]

  @@unique([tenantId, personId])
  @@index([businessId])
  @@index([consentStatus])
}

model CustomerImportBatch {
  id                 String   @id @default(uuid())
  contractId         String
  missionId          String
  versionId          String
  tenantId           String
  businessId         String
  sourceRef          String
  snapshotSha256     String
  sourceRowCount     Int
  publishRowCount    Int      @default(0)
  heldRowCount       Int      @default(0)
  status             String
  approvedByPersonId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant      Tenant                     @relation(fields: [tenantId], references: [id])
  business    Business                   @relation(fields: [businessId], references: [id])
  approvedBy  Person?                    @relation("CustomerImportBatchApprover", fields: [approvedByPersonId], references: [id])
  provenance  CustomerImportProvenance[]
  reviewCases CustomerImportReviewCase[]

  @@unique([contractId, missionId, versionId, snapshotSha256])
  @@index([tenantId, businessId, status])
}

model CustomerImportProvenance {
  id               String   @id @default(uuid())
  batchId          String
  sourceSystem     String
  sourceTable      String
  sourceRecordKey  String
  sourceRow        Int?
  sourceSha256     String
  snapshotSha256   String
  idempotencyKey   String   @unique
  resolutionStatus String
  matchMethod      String
  disposition      String
  personId         String?
  customerId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  batch              CustomerImportBatch            @relation(fields: [batchId], references: [id])
  person             Person?                        @relation("CustomerImportProvenancePerson", fields: [personId], references: [id])
  customer           Customer?                      @relation("CustomerImportProvenanceCustomer", fields: [customerId], references: [id])
  reviewCase         CustomerImportReviewCase?      @relation(fields: [reviewCaseId], references: [id])
  reviewDecisions    CustomerImportReviewDecision[]
  reviewCaseId       String?
  reviewReasonCode   String?
  reviewEvidenceJson String?

  @@unique([sourceSystem, sourceTable, sourceRecordKey, snapshotSha256])
  @@index([batchId, resolutionStatus, disposition])
  @@index([personId, customerId])
  @@index([reviewCaseId])
}

model CustomerImportReviewCase {
  id                  String   @id @default(uuid())
  batchId             String
  tenantId            String
  businessId          String
  reasonCode          String
  groupFingerprint    String
  status              String   @default("OPEN")
  itemCount           Int      @default(0)
  evidenceSummaryJson String   @default("{}")
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  batch     CustomerImportBatch            @relation(fields: [batchId], references: [id])
  tenant    Tenant                         @relation(fields: [tenantId], references: [id])
  business  Business                       @relation(fields: [businessId], references: [id])
  items     CustomerImportProvenance[]
  decisions CustomerImportReviewDecision[]

  @@unique([batchId, groupFingerprint])
  @@index([tenantId, businessId, status])
}

model CustomerImportReviewDecision {
  id                String   @id @default(uuid())
  reviewCaseId      String
  provenanceId      String
  decisionVersion   Int      @default(1)
  action            String
  targetCustomerId  String?
  decidedByPersonId String
  decidedAt         DateTime @default(now())
  note              String?
  createdAt         DateTime @default(now())

  reviewCase     CustomerImportReviewCase @relation(fields: [reviewCaseId], references: [id])
  provenance     CustomerImportProvenance @relation(fields: [provenanceId], references: [id])
  targetCustomer Customer?                @relation("CustomerImportReviewDecisionTargetCustomer", fields: [targetCustomerId], references: [id])
  decidedBy      Person                   @relation("CustomerImportReviewDecisionActor", fields: [decidedByPersonId], references: [id])

  @@unique([provenanceId, decisionVersion])
  @@index([reviewCaseId, provenanceId, decisionVersion])
  @@index([targetCustomerId])
}

model Conversation {
  id               String   @id @default(uuid())
  tenantId         String
  businessId       String?
  customerId       String
  channel          String // LINE | FACEBOOK | WEB
  channelAccountId String   @default("LEGACY:LINE")
  externalThreadId String
  status           String   @default("OPEN")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]
  analyses ConversationAnalysis[]
  salesTasks SalesTask[]
  salesOrders SalesOrder[]

  // @spec BR-002, SEC-001 — a provider thread id is envelope data, not a key. Scoping
  // it by tenant, channel and account isolates the external namespace:
  // a global unique let one tenant's thread id resolve another tenant's conversation.
  // @req FR-148 — legacy rows stay unassigned; each known OA has its own thread.
  @@unique([tenantId, channel, channelAccountId, externalThreadId], map: "Conversation_account_thread_key")
  @@index([customerId])
  @@index([tenantId])
}

model Message {
  id                String   @id @default(uuid())
  conversationId    String
  direction         String // INBOUND | OUTBOUND
  body              String
  externalMessageId String?
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lineJob LineConversationJob?

  // @spec BR-002, SEC-001 — scoped to the conversation that owns the message rather
  // than to a tenant column: a Message has no tenant of its own, and denormalising one
  // would create a second copy of the truth that could drift from its Conversation.
  // The conversation is already tenant-scoped, so isolation follows and cannot drift.
  // NULL stays non-conflicting in both engines, so unkeyed outbound messages are free.
  @@unique([conversationId, externalMessageId])
  @@index([conversationId])
}

// @req FR-127 — each recomputable, advisory analysis run belongs to an internal
// Conversation. Tenant/business scope is inherited through Conversation;
// external provider thread ids are never used as identity. analyzedDate is a
// grouping field, while this model's generated id identifies the run.
// @spec ADR-054 D3-D6, BR-001, SEC-005
// @tested tests/integration/crm-conversation-analysis.test.js
model ConversationAnalysis {
  id             String   @id @default(uuid())
  conversationId String
  analyzedDate   DateTime
  analyzedAt     DateTime @default(now())
  contactType    String
  state          String
  cta            String?
  tags           String
  summary        String
  rawOutputJson  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, analyzedDate])
  @@index([analyzedDate])
  @@index([contactType])
  @@index([state])
}

model AuditEvent {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      String
  payloadJson String   @default("{}")
  actorType   String   @default("LOCAL_USER")
  actorId     String?
  occurredAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([occurredAt])
}

// @req FR-149 — one scope-bound, append-only execution journal for Agent turns.
// @spec ADR-061, SEC-001 — tenant/business are stored explicitly so trace reads
// never infer isolation through an external conversation or provider identifier.
// @tested tests/integration/execution-trace.test.js
model AgentTraceEvent {
  id             String   @id @default(uuid())
  tenantId       String
  businessId     String
  turnId         String
  executionId    String?
  kind           String
  idempotencyKey String
  payloadJson    String
  occurredAt     DateTime
  createdAt      DateTime @default(now())
  version        Int      @default(1)

  @@unique([tenantId, businessId, idempotencyKey], map: "AgentTraceEvent_scope_idempotency_key")
  @@index([tenantId, businessId, turnId, occurredAt])
  @@index([tenantId, businessId, turnId, createdAt])
}

// @req FR-071 — server-owned full data-pipeline execution ledger.
// @spec ADR-030 D2-D6, SDD-042, SEC-003, SEC-008
// @tested tests/unit/platform/pipeline-tracking-service.test.js, tests/unit/platform/pipeline-tracking-migration.test.js
model PipelineRun {
  id                       String    @id @default(uuid())
  executionRunId           String    @unique
  dataPipelineDefinitionId String
  executionContractId      String
  tenantId                 String
  businessId               String?
  status                   String    @default("QUEUED")
  currentStageId           String?
  sourceRef                String?
  sourceSha256             String?
  artifactRef              String?
  artifactSha256           String?
  bootstrapBatchId         String?
  correlationId            String
  idempotencyKey           String    @unique
  requestHash              String
  expectedCount            Int       @default(0)
  actualCount              Int       @default(0)
  insertedCount            Int       @default(0)
  updatedCount             Int       @default(0)
  unchangedCount           Int       @default(0)
  failedCount              Int       @default(0)
  rejectedCount            Int       @default(0)
  duplicateCount           Int       @default(0)
  tagIdsJson               String    @default("[]")
  identityRefsJson         String    @default("{}")
  primaryFailureCode       String?
  primaryErrorRef          String?
  primaryRetryable         Boolean?
  auditEventId             String?
  replayScope              String?
  replayOfExecutionRunId   String?
  replayOfExecutionStepId  String?
  replayOfPipelineRecordId String?
  startedAt                DateTime?
  finishedAt               DateTime?
  lastHeartbeatAt          DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business        Business?                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  steps           PipelineStep[]
  eventReceipts   PipelineEventReceipt[]   @relation("PipelineRunEventReceipts")
  recordEvents    PipelineRecordEvent[]    @relation("PipelineRunRecordEvents")
  reconciliations PipelineReconciliation[] @relation("PipelineRunReconciliations")
  gateDecisions   PipelineGateDecision[]   @relation("PipelineRunGateDecisions")

  @@index([tenantId, status])
  @@index([businessId, status, createdAt])
  @@index([correlationId])
  @@index([replayOfExecutionRunId])
}

model PipelineStep {
  id                      String    @id @default(uuid())
  executionStepId         String    @unique
  runId                   String
  pipelineStageId         String
  sequence                Int
  attemptId               String    @unique
  status                  String    @default("NOT_STARTED")
  inputHash               String?
  outputHash              String?
  expectedCount           Int       @default(0)
  actualCount             Int       @default(0)
  insertedCount           Int       @default(0)
  updatedCount            Int       @default(0)
  unchangedCount          Int       @default(0)
  failedCount             Int       @default(0)
  skippedCount            Int       @default(0)
  failureCode             String?
  errorRef                String?
  retryable               Boolean?
  tagIdsJson              String    @default("[]")
  identityRefsJson        String    @default("{}")
  auditEventId            String?
  replayOfExecutionStepId String?
  startedAt               DateTime?
  finishedAt              DateTime?
  lastHeartbeatAt         DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  run             PipelineRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  recordEvents    PipelineRecordEvent[]    @relation("PipelineStepRecordEvents")
  reconciliations PipelineReconciliation[] @relation("PipelineStepReconciliations")

  @@index([runId, pipelineStageId, sequence])
  @@index([runId, status])
}

model PipelineEventReceipt {
  id             String   @id @default(uuid())
  runId          String
  idempotencyKey String   @unique
  eventType      String
  eventHash      String
  resultJson     String   @default("{}")
  auditEventId   String?
  createdAt      DateTime @default(now())

  run PipelineRun @relation("PipelineRunEventReceipts", fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, eventType])
}

model PipelineRecordEvent {
  id                       String   @id @default(uuid())
  runId                    String
  stepId                   String?
  attemptId                String
  pipelineRecordId         String
  sourceRecordKey          String?
  sourceRowNumber          Int?
  sourceSha256             String?
  docId                    String?
  picId                    String?
  factId                   String?
  sourceDocIdsJson         String   @default("[]")
  sourcePicIdsJson         String   @default("[]")
  destinationRecordId      String?
  status                   String
  failureCode              String?
  errorRef                 String?
  retryable                Boolean?
  tagIdsJson               String   @default("[]")
  identityRefsJson         String   @default("{}")
  idempotencyKey           String   @unique
  auditEventId             String?
  replayOfPipelineRecordId String?
  occurredAt               DateTime @default(now())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  run  PipelineRun   @relation("PipelineRunRecordEvents", fields: [runId], references: [id], onDelete: Cascade)
  step PipelineStep? @relation("PipelineStepRecordEvents", fields: [stepId], references: [id], onDelete: SetNull)

  @@index([runId, status])
  @@index([pipelineRecordId])
  @@index([docId])
  @@index([picId])
  @@index([factId])
}

model PipelineReconciliation {
  id              String   @id @default(uuid())
  runId           String
  stepId          String?
  expectedCount   Int      @default(0)
  actualCount     Int      @default(0)
  insertedCount   Int      @default(0)
  updatedCount    Int      @default(0)
  unchangedCount  Int      @default(0)
  rejectedCount   Int      @default(0)
  duplicateCount  Int      @default(0)
  sourceSha256    String?
  artifactSha256  String?
  stagingHash     String?
  destinationHash String?
  rlsProbeResult  String?
  isolationResult String?
  result          String
  evidenceJson    String   @default("{}")
  auditEventId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  run  PipelineRun   @relation("PipelineRunReconciliations", fields: [runId], references: [id], onDelete: Cascade)
  step PipelineStep? @relation("PipelineStepReconciliations", fields: [stepId], references: [id], onDelete: SetNull)

  @@index([runId, result])
  @@index([stepId])
}

model PipelineGateDecision {
  id                String   @id @default(uuid())
  runId             String
  gateId            String?
  status            String
  required          Boolean  @default(true)
  decidedByPersonId String?
  reason            String?
  evidenceJson      String   @default("{}")
  auditEventId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  run PipelineRun @relation("PipelineRunGateDecisions", fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([gateId])
}

// @req FR-110 — the puller's own cursor into GKS's `gks_stage_evidence_export`,
// one row per KnowledgeScope pulled (ADR-068 D2): cursor ownership is
// zuri-ai's, per scope with no wildcard scope, and it advances only after a
// page's ledger writes have committed — so a crash mid-page replays from the
// last durable cursor and the receiver's idempotency makes the replay a no-op.
// Not a ledger model: the ledger stays the six Pipeline* tables (ADR-050 D4);
// this is the integration lane's bookkeeping for one scheduled pull.
// @spec ADR-068 D2, ADR-050 D3, SDD-057, SEC-001
// @tested tests/integration/fr110-knowledge-evidence-importer.test.js
model KnowledgeEvidenceCursor {
  id           String    @id @default(uuid())
  portfolioId  String
  tenantId     String
  businessId   String
  workspaceId  String
  projectId    String
  sharing      String
  cursor       Int       @default(0)
  lastPulledAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([portfolioId, tenantId, businessId, workspaceId, projectId, sharing])
  @@index([tenantId])
}

// @req FR-079 — provider-neutral Business-scoped runtime connection metadata.
// @spec ADR-031 §D2/D3, SDD-043, SEC-015 — opaque secret references only;
// the production partial active-primary invariant is an additive Postgres DDL gate.
// @tested tests/unit/fr079-schema-contract.test.js
model IntegrationProvider {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  status           String   @default("ACTIVE")
  capabilitiesJson String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  version          Int      @default(1)

  connections IntegrationConnection[]
}

model IntegrationConnection {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String?
  providerId        String
  name              String
  authorizationType String    @default("SECRET_MANAGER")
  externalAccountId String?
  purpose           String    @default("GENERAL")
  role              String    @default("SECONDARY")
  status            String    @default("DRAFT")
  metadataJson      String    @default("{}")
  lastSyncAt        DateTime?
  lastSuccessAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  version           Int       @default(1)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  business      Business?              @relation(fields: [businessId], references: [id])
  provider      IntegrationProvider    @relation(fields: [providerId], references: [id])
  credential    IntegrationCredential?
  ingestionRuns IngestionRun[]
  rawRecords    RawExternalRecord[]
  cursors       SyncCursor[]
  externalRefs  ExternalEntityRef[]
  deadLetters   DeadLetterRecord[]
  // @req FR-146 — at most one LINE OA Studio account operates a connection.
  lineOaAccount LineOaAccount?

  @@unique([tenantId, providerId, externalAccountId])
  @@index([tenantId, businessId, purpose, status, role])
}

model IntegrationCredential {
  id                    String    @id @default(uuid())
  connectionId          String    @unique
  secretRef             String
  status                String    @default("ACTIVE")
  expiresAt             DateTime?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  rotatedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  version               Int       @default(1)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model IngestionRun {
  id             String    @id @default(uuid())
  tenantId       String
  businessId     String?
  connectionId   String
  lane           String
  resourceType   String
  runType        String    @default("INCREMENTAL")
  status         String    @default("RUNNING")
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  fetchedCount   Int       @default(0)
  createdCount   Int       @default(0)
  updatedCount   Int       @default(0)
  unchangedCount Int       @default(0)
  failedCount    Int       @default(0)
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  business    Business?             @relation(fields: [businessId], references: [id])
  connection  IntegrationConnection @relation(fields: [connectionId], references: [id])
  rawRecords  RawExternalRecord[]
  deadLetters DeadLetterRecord[]

  @@index([tenantId, status])
  @@index([businessId])
  @@index([connectionId, resourceType])
  @@index([startedAt])
}

model RawExternalRecord {
  id               String    @id @default(uuid())
  tenantId         String
  businessId       String?
  connectionId     String
  ingestionRunId   String?
  provider         String
  lane             String
  entityType       String
  externalId       String
  sourceType       String
  sourceUri        String?
  schemaVersion    String
  payloadJson      String
  payloadHash      String
  idempotencyKey   String    @unique
  // FR-109 AC-109.3 — the id a downstream knowledge-ingestion run carries as
  // `artifactRef`/`identityRefs.artifactIds`. Nullable: most raw records are
  // never fed into knowledge ingestion, and the two ids are assigned by
  // different callers at different times (this row is written by FR-081's own
  // ingestion path; the artifact id is minted by whoever builds the FR-109
  // run input). Not @unique — a caller that never sets it must be able to
  // insert more than one such row.
  artifactId       String?
  receivedAt       DateTime
  processingStatus String    @default("RECEIVED")
  processingError  String?
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  business     Business?             @relation(fields: [businessId], references: [id])
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id])
  ingestionRun IngestionRun?         @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)
  deadLetters  DeadLetterRecord[]

  @@index([tenantId, entityType])
  @@index([businessId])
  @@index([connectionId, entityType, externalId])
  @@index([ingestionRunId])
  @@index([processingStatus])
  @@index([artifactId])
}

model SyncCursor {
  id            String    @id @default(uuid())
  tenantId      String
  businessId    String?
  connectionId  String
  resourceType  String
  strategy      String
  cursorValue   String?
  watermarkAt   DateTime?
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  business   Business?             @relation(fields: [businessId], references: [id])
  connection IntegrationConnection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, resourceType])
  @@index([tenantId, resourceType])
  @@index([businessId])
}

model ExternalEntityRef {
  id                 String    @id @default(uuid())
  tenantId           String
  businessId         String?
  connectionId       String
  provider           String
  entityType         String
  externalId         String
  internalEntityType String?
  internalEntityId   String?
  externalCode       String?
  documentNumber     String?
  payloadHash        String?
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  business   Business?             @relation(fields: [businessId], references: [id])
  connection IntegrationConnection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, entityType, externalId])
  @@index([tenantId, entityType])
  @@index([businessId])
  @@index([internalEntityType, internalEntityId])
}

model DeadLetterRecord {
  id             String    @id @default(uuid())
  tenantId       String
  businessId     String?
  connectionId   String
  ingestionRunId String?
  rawRecordId    String?
  lane           String
  entityType     String
  externalId     String
  failureStage   String
  failureOwner   String
  errorCode      String
  errorMessage   String
  retryCount     Int       @default(0)
  status         String    @default("OPEN")
  nextRetryAt    DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  business     Business?             @relation(fields: [businessId], references: [id])
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id])
  ingestionRun IngestionRun?         @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)
  rawRecord    RawExternalRecord?    @relation(fields: [rawRecordId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([businessId])
  @@index([connectionId, status])
  @@index([ingestionRunId])
  @@index([rawRecordId])
}

// @req FR-092 — provider-neutral translated market evidence owned by Market Intelligence.
// @spec SDD-049, BR-019, SEC-017 — scalar provenance refs preserve the Integration boundary;
// unique lineage serializes concurrent replay without making Market own the source records.
model MarketObservation {
  id                       String   @id @default(uuid())
  tenantId                 String
  businessId               String?
  rawRecordId              String
  connectionId             String
  provider                 String
  sourceEntityType         String
  externalId               String
  sourcePayloadHash        String
  sourceUri                String?
  translationSchemaVersion String
  observationType          String
  candidateJson            String
  canonicalProductRef      String?
  canonicalCategoryRef     String?
  resolutionStatus         String
  resolutionConfidence     Float?
  observedAt               DateTime
  translatedAt             DateTime
  createdAt                DateTime @default(now())
  lineageKey               String   @unique

  @@index([tenantId, businessId, observedAt])
  @@index([tenantId, connectionId, provider])
  @@index([rawRecordId])
  @@index([canonicalProductRef])
}

// @req FR-096 — the SoT pipeline's generic human-decision queue: the data plane
// submits pending facts, a human decides in the browser, the data plane pulls
// decided rows by cursor and applies them to its own stores (ADR-043 interim).
// @spec FR-096, BR-002, SEC-002
// @tested tests/unit/sot-decision-service.test.js
model SotDecision {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String?
  decisionType      String
  subjectRef        String
  phaseId           String?
  payloadJson       String    @default("{}")
  payloadSha256     String
  decisionVersion   Int       @default(1)
  status            String    @default("PENDING")
  submittedBy       String?
  decidedByPersonId String?
  reason            String?
  auditEventId      String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([tenantId, decisionType, subjectRef, decisionVersion])
  @@index([tenantId, status, decisionType])
  @@index([businessId, status])
  @@index([phaseId, status])
  @@index([updatedAt])
}

// @req FR-102 — a bearer credential scoped to exactly one Tenant lets the SoT
// pipeline's external data plane authenticate to the FR-100 decision
// submit/export endpoints without a browser session and without a Person
// identity. The raw secret exists only at mint time; only its SHA-256 hash is
// ever persisted, and a revoked key is refused immediately (no session grace
// period, unlike Session — a leaked non-interactive credential has no user to
// notice and log out).
// @spec ADR-047, SEC-019
// @tested tests/unit/sot-data-plane-auth.test.js
model SotDataPlaneKey {
  id           String    @id @default(uuid())
  label        String
  tenantId     String
  keyHash      String    @unique
  keyPrefix    String
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokeReason String?
  lastUsedAt   DateTime?
  version      Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// @req FR-106 — a bearer credential scoped to exactly one Tenant lets an
// enterprise integrator authenticate to the FR-019 Enterprise API
// (dry-run/commit/resolve) without a browser session, generalizing the FR-102
// SotDataPlaneKey pattern per ADR-047 D3's named follow-up rather than
// inventing a second mechanism. The raw secret exists only at mint time; only
// its SHA-256 hash is ever persisted, it is never readable back, and a revoked
// key is refused on the next request (no grace period — a leaked
// non-interactive credential has no user to notice and log out).
// @spec SEC-006, SEC-001, BR-002, ADR-047
// @tested tests/unit/api-access-auth.test.js
model ApiAccessKey {
  id           String    @id @default(uuid())
  label        String
  tenantId     String
  keyHash      String    @unique
  keyPrefix    String
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokeReason String?
  lastUsedAt   DateTime?
  version      Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// @req FR-144 — a Business-scoped bearer credential a Zuri Edge Device presents
/// to claim extraction work and to send heartbeats. Mirrors ApiAccessKey (FR-106):
/// high-entropy random secret, stored only as a SHA-256 lookup hash, a display
/// prefix that identifies a row in an admin listing without helping guess the
/// secret. Scoped to one Business, never a Tenant — the device belongs to one
/// customer premise (ADR-041), and a Tenant-wide device credential would widen
/// the blast radius of a stolen key past the site that holds it.
/// @spec SEC-025, ADR-059 D2, ADR-041 D3
model EdgeDeviceCredential {
  id           String    @id @default(uuid())
  tenantId     String
  businessId   String
  deviceId     String
  label        String
  keyHash      String    @unique
  keyPrefix    String
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokeReason String?
  lastUsedAt   DateTime?
  version      Int       @default(1)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([businessId, deviceId])
}

/// @req FR-143 — one unit of extraction work handed to an edge device. The cloud
/// queues it, a device claims it under a time-boxed lease, and the device posts a
/// candidate back through the same schema the OpenAI adapter produces. The job is
/// the whole record of that exchange: no bucket URL and no storage credential ever
/// leaves the cloud (ADR-041 D3), and a candidate is evidence, never approval
/// (BR-025).
/// @spec SDD-085, ADR-059 D1/D3
model AssetExtractionJob {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String
  evidenceId        String
  status            String    @default("QUEUED")
  claimedByDeviceId String?
  claimedAt         DateTime?
  leaseExpiresAt    DateTime?
  attempts          Int       @default(0)
  lastError         String?
  resultJson        String    @default("{}")
  provider          String?
  model             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  version           Int       @default(1)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  evidence AssetEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([businessId, status, createdAt])
  @@index([evidenceId, status])
}

// @req FR-146 — LINE OA Studio account aggregate (ADR-060 D2/D3/D5): one row per
// LINE Official Account a Business operates, many per Business, one Business
// each. References the integration lane's LINE_OA connection 1:1 and the agent
// lane's binding code; holds no credential material. `status` is the stored
// machine (DRAFT → CONNECTED → PAUSED | ARCHIVED); LIVE is derived from the
// binding and never stored. `transportMode` is EDGE or CLOUD.
// @spec BR-002 — basicId is a LINE attribute, never a key; SEC-001 — every row
// carries tenantId and businessId.
// @tested tests/unit/line-oa-account-schema-contract.test.js, tests/integration/fr146-line-oa-account.test.js
model LineOaAccount {
  id                      String    @id @default(uuid())
  code                    String
  tenantId                String
  businessId              String
  integrationConnectionId String    @unique
  bindingCode             String?
  displayName             String
  basicId                 String?
  status                  String    @default("DRAFT")
  transportMode           String    @default("CLOUD")
  // @req FR-149, FR-150 — transport ownership and compute placement are independent.
  serverEnabled           Boolean   @default(false)
  executionMode           String    @default("SERVER")
  modelAccess             String    @default("LOCAL_ONLY")
  allowDelayedPush         Boolean   @default(false)
  transportEpoch          Int       @default(1)
  conversationJobs        LineConversationJob[]
  richMenuJobs            LineOaRichMenuJob[]
  liffApps                LineOaLiffApp[]
  isDefaultForBusiness    Boolean   @default(false)
  botProfileJson          String    @default("{}")
  archivedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  version                 Int       @default(1)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [integrationConnectionId], references: [id])
  richMenus  LineOaRichMenu[]

  @@unique([tenantId, code])
  @@unique([tenantId, bindingCode])
  @@index([businessId, status])
}

// FR-151 — a rich menu design of one LineOaAccount (ADR-060 D3): identity,
// alias and default flag live here; every body is an immutable-once-frozen
// LineOaRichMenuVersion. The external richMenuId LINE assigns at deployment is
// recorded on the version that was deployed, as an attribute (BR-002).
model LineOaRichMenu {
  id              String    @id @default(uuid())
  code            String
  tenantId        String
  businessId      String
  lineOaAccountId String
  name            String
  alias           String?
  status          String    @default("DRAFT")
  isDefault       Boolean   @default(false)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  version         Int       @default(1)

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account  LineOaAccount           @relation(fields: [lineOaAccountId], references: [id], onDelete: Cascade)
  versions LineOaRichMenuVersion[]
  jobs     LineOaRichMenuJob[]

  @@unique([tenantId, code])
  @@unique([lineOaAccountId, alias])
  @@index([lineOaAccountId, status])
}

// FR-151 — one numbered body of a rich menu: layout, chat-bar text, tap areas
// with their actions, and the FileAsset image it was designed against. DRAFT is
// editable; FROZEN never changes again; PUBLISHED / RETIRED are set by the
// transport lane (a later slice), never by the designer.
model LineOaRichMenuVersion {
  id                 String    @id @default(uuid())
  richMenuId         String
  tenantId           String
  businessId         String
  lineOaAccountId    String
  versionNumber      Int
  status             String    @default("DRAFT")
  layout             String
  chatBarText        String
  selected           Boolean   @default(false)
  imageFileAssetId   String?
  imageWidth         Int
  imageHeight        Int
  areasJson          String    @default("[]")
  externalRichMenuId String?
  frozenAt           DateTime?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  richMenu LineOaRichMenu @relation(fields: [richMenuId], references: [id], onDelete: Cascade)
  image    FileAsset?     @relation(fields: [imageFileAssetId], references: [id], onDelete: SetNull)
  jobs     LineOaRichMenuJob[]

  @@unique([richMenuId, versionNumber])
  @@index([lineOaAccountId, status])
}

// FR-152 — one server-owned unit of rich menu work against LINE (ADR-061 D1,
// D6, D7): PUBLISH a frozen version (create the menu, upload its image),
// SET_DEFAULT or SET_ALIAS for a published one. Claimed with compare-and-set
// and a bounded lease; an ambiguous external outcome ends as UNKNOWN for an
// operator, never as a silent retry that could duplicate a menu. Holds no
// secret: the worker resolves the account's credential per attempt.
// FR-153 — the LIFF app registry of one LineOaAccount (SRS LOS-RQ-070): what
// the account's LIFF apps are called, where they open, at what size, with which
// scopes. The external liffId LINE Developers assigns is recorded as an
// attribute (BR-002) by a publisher; nothing here calls LINE. A rich menu LIFF
// action resolves through an ACTIVE row to https://liff.line.me/{liffId}.
model LineOaLiffApp {
  id              String    @id @default(uuid())
  code            String
  tenantId        String
  businessId      String
  lineOaAccountId String
  name            String
  description     String?
  viewSize        String    @default("FULL")
  endpointUrl     String
  scopesJson      String    @default("[]")
  botPrompt       String    @default("NORMAL")
  status          String    @default("DRAFT")
  externalLiffId  String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  version         Int       @default(1)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account  LineOaAccount @relation(fields: [lineOaAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@unique([lineOaAccountId, externalLiffId])
  @@index([lineOaAccountId, status])
}

model LineOaRichMenuJob {
  id                 String    @id @default(uuid())
  tenantId           String
  businessId         String
  accountId          String
  richMenuId         String
  richMenuVersionId  String
  kind               String
  stage              String    @default("CREATE")
  status             String    @default("QUEUED")
  transportEpoch     Int
  attempts           Int       @default(0)
  availableAt        DateTime  @default(now())
  expiresAt          DateTime
  claimantId         String?
  leaseExpiresAt     DateTime?
  externalRichMenuId String?
  providerRequestId  String?
  errorCode          String?
  correlationId      String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  version            Int       @default(1)

  account  LineOaAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  richMenu LineOaRichMenu        @relation(fields: [richMenuId], references: [id], onDelete: Cascade)
  menuVersion LineOaRichMenuVersion @relation(fields: [richMenuVersionId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([accountId, status])
  @@index([richMenuId, status])
}

// @req FR-149, FR-150 — durable server-owned conversation execution and acceptance ledger.
// @spec ADR-061, SEC-001 — internal identities, scoped account, cascaded with CRM erasure.
// @tested tests/integration/server-line-jobs.test.js
model LineConversationJob {
  id                 String   @id @default(uuid())
  accountId          String
  inboundMessageId   String   @unique
  eventId            String
  tenantId           String
  businessId         String
  executionId        String?
  channelAccountId   String
  transportEpoch     Int
  executionMode      String
  modelAccess        String
  allowDelayedPush   Boolean  @default(false)
  recipientId        String
  sourceUserId       String
  sealedReplyToken   String?
  replyExpiresAt     DateTime?
  status             String   @default("QUEUED")
  answerText         String?
  sendMethod         String?
  retryKey           String   @unique @default(uuid())
  attempts           Int      @default(0)
  availableAt        DateTime @default(now())
  expiresAt          DateTime
  firstSendAt        DateTime?
  claimantId         String?
  leaseExpiresAt     DateTime?
  providerRequestId  String?
  providerMessageId  String?
  acceptedAt         DateTime?
  errorCode          String?
  correlationId      String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  version            Int      @default(1)

  account LineOaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inbound Message @relation(fields: [inboundMessageId], references: [id], onDelete: Cascade)
  @@unique([accountId, eventId])
  @@index([status, executionMode, availableAt])
  @@index([tenantId, businessId, status])
}

// @req FR-159 — Business-scoped strategy identity and immutable evidence.
// @spec SDD-086, SEC-001, SEC-003
// @tested tests/integration/marketing-plan.test.js
model MarketingPlan {
  id              String    @id @default(uuid())
  tenantId        String
  businessId      String
  code            String
  title           String
  status          String    @default("DRAFT")
  currentRevision Int       @default(1)
  version         Int       @default(1)
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant    Tenant                 @relation(fields: [tenantId], references: [id])
  business  Business               @relation(fields: [businessId], references: [id])
  revisions MarketingPlanVersion[]
  reviews   MarketingReview[]
  decisions MarketingDecision[]
  handoffs  MarketingHandoff[]
  initiative MarketingInitiative?

  @@unique([businessId, code])
  @@index([tenantId, businessId, status])
}

// @req FR-159 — canonical content and its hash are append-only.
model MarketingPlanVersion {
  id          String   @id @default(uuid())
  planId      String
  revision    Int
  payloadJson String
  payloadHash String
  createdBy   String
  createdAt   DateTime @default(now())

  plan      MarketingPlan       @relation(fields: [planId], references: [id])
  reviews   MarketingReview[]
  decisions MarketingDecision[]
  handoffs  MarketingHandoff[]

  @@unique([planId, revision])
}

// @req FR-159 — independent reviewer evidence binds the exact artifact.
model MarketingReview {
  id            String   @id @default(uuid())
  planId        String
  planVersionId String
  payloadHash   String
  verdict       String
  rationale     String
  reviewerId    String
  createdAt     DateTime @default(now())

  plan        MarketingPlan        @relation(fields: [planId], references: [id])
  planVersion MarketingPlanVersion @relation(fields: [planVersionId], references: [id])
  decisions   MarketingDecision[]

  @@index([planId, createdAt])
}

// @req FR-159 — decisions and revocations append, never overwrite approval history.
model MarketingDecision {
  id            String    @id @default(uuid())
  planId        String
  planVersionId String
  payloadHash   String
  reviewId      String?
  verdict       String
  rationale     String
  actorId       String
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  plan        MarketingPlan        @relation(fields: [planId], references: [id])
  planVersion MarketingPlanVersion @relation(fields: [planVersionId], references: [id])
  review      MarketingReview?     @relation(fields: [reviewId], references: [id])

  @@index([planId, createdAt])
}

// @req FR-158 — accepted PM execution references, one per revision and Workspace.
// @spec SDD-086, BR-007
// @tested tests/integration/marketing-pm-handoff.test.js
model MarketingHandoff {
  id            String   @id @default(uuid())
  planId        String
  planVersionId String
  workspaceId   String
  projectId     String
  payloadHash   String
  envelopeHash  String
  receiptJson   String
  createdBy     String
  createdAt     DateTime @default(now())

  plan        MarketingPlan        @relation(fields: [planId], references: [id])
  planVersion MarketingPlanVersion @relation(fields: [planVersionId], references: [id])
  workspace   Workspace            @relation(fields: [workspaceId], references: [id])
  project     Project              @relation(fields: [projectId], references: [id])

  initiatives MarketingInitiative[]

  @@unique([planVersionId, workspaceId])
  @@index([planId])
}

// @req FR-160 — distinct Campaign identity associated with one Strategy plan and an explicit PM receipt.
// @spec SDD-087, SEC-001, SEC-003
// @tested tests/integration/marketing-campaign.test.js
model MarketingInitiative {
  id            String    @id @default(uuid())
  tenantId      String
  businessId    String
  code          String
  planId        String    @unique
  handoffId     String?
  status        String    @default("OPEN")
  closureReason String?
  version       Int       @default(1)
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  business Business          @relation(fields: [businessId], references: [id])
  plan     MarketingPlan     @relation(fields: [planId], references: [id])
  handoff  MarketingHandoff? @relation(fields: [handoffId], references: [id], onDelete: Restrict)

  @@unique([businessId, code])
  @@index([tenantId, businessId, status])
}

// @req FR-157 — scoped creative intent and optimistic revision root.
// @spec SDD-088, SEC-001
// @tested tests/integration/marketing-content.test.js
model MarketingContentBrief {
  id String @id @default(uuid())
  tenantId String
  businessId String
  code String
  title String
  status String @default("OPEN")
  currentRevision Int @default(1)
  version Int @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id])
  business Business @relation(fields: [businessId], references: [id])
  revisions MarketingContentVersion[]
  reviews MarketingContentReview[]
  decisions MarketingContentDecision[]
  @@unique([businessId, code])
  @@index([tenantId, businessId, status])
}

// @req FR-157 — creative intent and exact owner references are immutable.
model MarketingContentVersion {
  id String @id @default(uuid())
  briefId String
  revision Int
  payloadJson String
  payloadHash String
  createdBy String
  createdAt DateTime @default(now())
  brief MarketingContentBrief @relation(fields: [briefId], references: [id])
  reviews MarketingContentReview[]
  decisions MarketingContentDecision[]
  @@unique([briefId, revision])
}

// @req FR-157 — independent review binds exact content and rights findings.
model MarketingContentReview {
  id String @id @default(uuid())
  briefId String
  contentVersionId String
  payloadHash String
  sequence Int
  verdict String
  rationale String
  rightsConfirmed Boolean @default(false)
  brandConfirmed Boolean @default(false)
  reviewerId String
  createdAt DateTime @default(now())
  brief MarketingContentBrief @relation(fields: [briefId], references: [id])
  contentVersion MarketingContentVersion @relation(fields: [contentVersionId], references: [id])
  decisions MarketingContentDecision[]
  @@unique([briefId, sequence])
  @@index([briefId, createdAt])
}

// @req FR-157 — decisions and revocations preserve exact acceptance history.
model MarketingContentDecision {
  id String @id @default(uuid())
  briefId String
  contentVersionId String
  payloadHash String
  sequence Int
  reviewId String?
  verdict String
  rationale String
  actorId String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  brief MarketingContentBrief @relation(fields: [briefId], references: [id])
  contentVersion MarketingContentVersion @relation(fields: [contentVersionId], references: [id])
  review MarketingContentReview? @relation(fields: [reviewId], references: [id])
  @@unique([briefId, sequence])
  @@index([briefId, createdAt])
}

// @req FR-162 — Business-scoped Marketing Operations intake request; Marketing
// is the only writer and PM/CRM/Commerce/provider records remain projections.
// @spec SDD-089, SEC-001, SEC-003
// @tested tests/integration/marketing-operations.test.js
model MarketingOperationsIntake {
  id                  String   @id @default(uuid())
  tenantId            String
  businessId          String
  title               String
  capability          String
  objective           String
  requiredAt          DateTime?
  evidenceReference   String?
  responsibleOwnerId  String?
  status              String   @default("NEW")
  version             Int      @default(1)
  createdBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@index([tenantId, businessId, status])
  @@index([businessId, requiredAt])
}
// ── Inventory (คลังสินค้า) — FR-154 catalogue identity, FR-155 stock ledger ──
// @req FR-154 — catalogue identity: category → family → master → product (SKU),
//   the factory that makes it and the bundle that packs several SKUs. Every row
//   is Tenant- and Business-scoped, keyed by an internal UUID with a human
//   `code` unique per Tenant (BR-002: no external id is ever a key).
// @req FR-155 — the stock ledger: a lot, a serial unit and an append-only
//   movement. On-hand is never stored on the product; it is the sum of the
//   product's movements (a pure calculator, the same rule progress follows).
// @spec BR-002, SEC-001, ADR-025
// @tested tests/integration/fr154-inventory-catalog.test.js,
//   tests/integration/fr155-inventory-stock.test.js

model InventoryCategory {
  id              String   @id @default(uuid())
  code            String
  tenantId        String
  businessId      String
  nameTh          String
  nameEn          String
  slug            String?
  vibe            String?
  targetRecipient String?
  guardrail       String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productMasters ProductMaster[]

  @@unique([tenantId, code])
  @@unique([businessId, slug])
  @@index([businessId, status])
}

model ProductFamily {
  id          String   @id @default(uuid())
  code        String
  tenantId    String
  businessId  String
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productMasters ProductMaster[]

  @@unique([tenantId, code])
  @@index([businessId, status])
}

model Factory {
  id         String   @id @default(uuid())
  code       String
  tenantId   String
  businessId String
  name       String
  country    String?
  contact    String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  version    Int      @default(1)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productMasters ProductMaster[]
  lots           ProductLot[]

  @@unique([tenantId, code])
  @@index([businessId, status])
}

model ProductMaster {
  id         String   @id @default(uuid())
  code       String
  tenantId   String
  businessId String
  categoryId String
  familyId   String?
  factoryId  String?
  nameTh     String
  nameEn     String
  baseCost   Float    @default(0)
  specsJson  String   @default("{}")
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  version    Int      @default(1)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category InventoryCategory @relation(fields: [categoryId], references: [id])
  family   ProductFamily?    @relation(fields: [familyId], references: [id], onDelete: SetNull)
  factory  Factory?          @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  products Product[]

  @@unique([tenantId, code])
  @@index([businessId, status])
  @@index([categoryId])
  @@index([familyId])
}

model Product {
  id              String    @id @default(uuid())
  code            String
  tenantId        String
  businessId      String
  productMasterId String
  name            String?
  color           String?
  material        String?
  unit            String    @default("EA")
  stockPolicy     String    @default("TRACKED")
  trackingMode    String    @default("NONE")
  safetyStock     Int       @default(10)
  status          String    @default("ACTIVE")
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  version         Int       @default(1)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productMaster ProductMaster       @relation(fields: [productMasterId], references: [id])
  lots          ProductLot[]
  serialUnits   SerialUnit[]
  bundleItems   ProductBundleItem[]
  movements     StockMovement[]
  recipes       ProductRecipe[]
  recipeLines   ProductRecipeLine[]
  salesOrderLines SalesOrderLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([tenantId, code])
  @@index([businessId, status])
  @@index([productMasterId])
}

model ProductLot {
  id             String    @id @default(uuid())
  code           String
  tenantId       String
  businessId     String
  productId      String
  factoryId      String?
  manufacturedAt DateTime?
  expiresAt      DateTime?
  receivedQty    Int       @default(0)
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  factory     Factory?        @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  serialUnits SerialUnit[]
  movements   StockMovement[]

  @@unique([productId, code])
  @@index([businessId, status])
  @@index([factoryId])
}

model SerialUnit {
  id         String   @id @default(uuid())
  serialNo   String
  tenantId   String
  businessId String
  productId  String
  lotId      String?
  status     String   @default("IN_STOCK")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  version    Int      @default(1)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  lot       ProductLot?     @relation(fields: [lotId], references: [id], onDelete: SetNull)
  movements StockMovement[]

  @@unique([productId, serialNo])
  @@index([businessId, status])
  @@index([lotId])
}

model ProductBundle {
  id               String   @id @default(uuid())
  code             String
  tenantId         String
  businessId       String
  name             String
  description      String?
  targetRecipients Int?
  totalPrice       Float?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  version          Int      @default(1)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    ProductBundleItem[]

  @@unique([tenantId, code])
  @@index([businessId, status])
}

model ProductBundleItem {
  id        String @id @default(uuid())
  bundleId  String
  productId String
  qty       Int    @default(1)

  bundle  ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@unique([bundleId, productId])
  @@index([productId])
}

model StockMovement {
  id           String   @id @default(uuid())
  tenantId     String
  businessId   String
  productId    String
  lotId        String?
  serialUnitId String?
  kind         String
  quantity     Int
  reason       String?
  reference    String?
  actorId      String?
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  lot        ProductLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  serialUnit SerialUnit? @relation(fields: [serialUnitId], references: [id], onDelete: SetNull)

  @@index([productId, occurredAt])
  @@index([businessId, occurredAt])
  @@index([lotId])
  @@index([serialUnitId])
}

// ── Inventory recipe / bill of materials — FR-156 ───────────────────────────
// @req FR-156 — a recipe (recipe_id) is the bill of materials of one output SKU
//   at one batch size: "the recipe for 10 seats" and "for 20 seats" are two
//   rows on the same product, exactly as a gift box has a BOM at 10, 50, 100
//   and 500 sets. Lines name component SKUs with a quantity per batch; a
//   `fixed` line (tooling, one crate per batch) does not scale with quantity.
//   A bundle (FR-154) is the special case "a kit at batch size 1".
// @spec BR-002 (codes are attributes, never keys)
// @tested tests/integration/fr156-inventory-recipe.test.js

model ProductRecipe {
  id         String    @id @default(uuid())
  code       String
  tenantId   String
  businessId String
  productId  String
  name       String
  batchSize  Int
  yieldQty   Int
  unit       String    @default("EA")
  notes      String?
  status     String    @default("ACTIVE")
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  version    Int       @default(1)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines    ProductRecipeLine[]

  @@unique([tenantId, code])
  @@unique([productId, batchSize])
  @@index([businessId, status])
}

model ProductRecipeLine {
  id                 String  @id @default(uuid())
  recipeId           String
  componentProductId String
  qty                Float
  unit               String?
  fixed              Boolean @default(false)
  note               String?

  recipe    ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  component Product       @relation(fields: [componentProductId], references: [id])

  @@unique([recipeId, componentProductId])
  @@index([componentProductId])
}

// ── CRM sales task — FR-161 ─────────────────────────────────────────────────
// @req FR-161 — a sales task is a follow-up a salesperson owes a customer: a
//   call, a LINE message, a meeting, a demo, a quote — Business-scoped, with an
//   optional Customer and Conversation of the same Tenant (BR-001 CRM sharing)
//   and an optional assignee Person. It is deliberately NOT a project-manager
//   WorkItem: no milestones, no progress roll-up, no Workstream. The legacy
//   product's "PROJECT" task kind stays with project-manager, its "URGENT"
//   status is a priority here, and its Notion id would be an ExternalRef.
// @spec ADR-064; ADR-054 D3/D4; BR-001; BR-002; SEC-001
// @tested tests/integration/fr161-sales-task.test.js

model SalesTask {
  id                  String    @id @default(uuid())
  code                String
  tenantId            String
  businessId          String
  customerId          String?
  conversationId      String?
  assigneePersonId    String?
  createdByPersonId   String?
  title               String
  description         String?
  type                String    @default("FOLLOW_UP")
  priority            String    @default("NORMAL")
  status              String    @default("OPEN")
  scheduleKind        String    @default("SINGLE")
  dueDate             DateTime
  startDate           DateTime?
  timeStart           String?
  timeEnd             String?
  outcome             String?
  completedAt         DateTime?
  completedByPersonId String?
  cancelledAt         DateTime?
  cancelReason        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  version             Int       @default(1)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignee     Person?       @relation("SalesTaskAssignee", fields: [assigneePersonId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([businessId, status, dueDate])
  @@index([assigneePersonId, status])
  @@index([customerId])
  @@index([conversationId])
}

// ── Commerce — FR-166 sales orders, FR-163 payments ─────────────────────────
// @req FR-166 — a sales order (order_id) is what a Business sold: lines that
//   may name an inventory SKU, an optional Customer and the Conversation the
//   sale came from (chat-first attribution), a status machine, and money kept
//   as integer satang. Totals, paid, balance and payment state are computed
//   on read from the lines and the verified payments — never stored.
// @req FR-163 — a payment (or refund) against an order, PENDING until a
//   verifier confirms the slip; the bank reference is an attribute unique per
//   Tenant (BR-002), the slip image is a FileAsset of the same Business.
// @spec ADR-065; ADR-054 D3/D4/D5; BR-001; BR-002; SEC-001
// @tested tests/integration/fr166-sales-order.test.js,
//   tests/integration/fr163-payment.test.js

model SalesOrder {
  id                String    @id @default(uuid())
  code              String
  tenantId          String
  businessId        String
  customerId        String?
  conversationId    String?
  origin            String    @default("WALK_IN")
  status            String    @default("DRAFT")
  currency          String    @default("THB")
  discountSatang    Int       @default(0)
  notes             String?
  orderedAt         DateTime  @default(now())
  confirmedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  stockIssuedAt     DateTime?
  closedByPersonId  String?
  createdByPersonId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  version           Int       @default(1)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  lines        SalesOrderLine[]
  payments     Payment[]

  @@unique([tenantId, code])
  @@index([businessId, status, orderedAt])
  @@index([customerId])
  @@index([conversationId])
}

model SalesOrderLine {
  id              String  @id @default(uuid())
  orderId         String
  productId       String?
  description     String
  qty             Int
  unitPriceSatang Int
  discountSatang  Int     @default(0)
  sortOrder       Int     @default(0)

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                 String    @id @default(uuid())
  code               String
  tenantId           String
  businessId         String
  orderId            String
  kind               String    @default("PAYMENT")
  method             String
  amountSatang       Int
  status             String    @default("PENDING")
  bankReference      String?
  slipFileAssetId    String?
  note               String?
  paidAt             DateTime  @default(now())
  verifiedAt         DateTime?
  verifiedByPersonId String?
  rejectReason       String?
  createdByPersonId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  version            Int       @default(1)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  slip     FileAsset? @relation(fields: [slipFileAssetId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@unique([tenantId, bankReference])
  @@index([orderId, status])
  @@index([businessId, status, paidAt])
}

// ── Procurement — FR-164 suppliers & purchase orders, FR-165 goods receipts ──
// @req FR-164 — the buy side (ADR-066): a Supplier of the Business (code
//   unique per Tenant, archived never deleted) and a PurchaseOrder against it
//   with lines that may name an Inventory SKU at the agreed unit cost (integer
//   satang). No stored total or received quantity: both are computed on read
//   from the lines and the receipt lines.
// @req FR-165 — a GoodsReceipt posts what arrived against a SENT order; each
//   of its lines names one order line, and a line naming a counted SKU writes
//   RECEIPT rows into the Inventory ledger in the same transaction with
//   `PO:<code>/GRN:<code>` as the reference. A receipt is never edited.
// @spec ADR-066; ADR-054 D3/D4; BR-001; BR-002; SEC-001
model Supplier {
  id           String    @id @default(uuid())
  code         String
  tenantId     String
  businessId   String
  name         String
  taxId        String?
  contactName  String?
  phone        String?
  email        String?
  address      String?
  paymentTerms String?
  leadTimeDays Int?
  notes        String?
  status       String    @default("ACTIVE")
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  version      Int       @default(1)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([businessId, status])
}

model PurchaseOrder {
  id                String    @id @default(uuid())
  code              String
  tenantId          String
  businessId        String
  supplierId        String
  status            String    @default("DRAFT")
  currency          String    @default("THB")
  expectedAt        DateTime?
  notes             String?
  orderedAt         DateTime  @default(now())
  sentAt            DateTime?
  receivedAt        DateTime?
  closedAt          DateTime?
  closeReason       String?
  cancelledAt       DateTime?
  cancelReason      String?
  createdByPersonId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  version           Int       @default(1)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([tenantId, code])
  @@index([businessId, status, orderedAt])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id              String  @id @default(uuid())
  purchaseOrderId String
  productId       String?
  description     String
  qty             Int
  unitCostSatang  Int
  sortOrder       Int     @default(0)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  receiptLines  GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id                String   @id @default(uuid())
  code              String
  tenantId          String
  businessId        String
  purchaseOrderId   String
  supplierReference String?
  notes             String?
  receivedAt        DateTime @default(now())
  postedByPersonId  String?
  createdAt         DateTime @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lines         GoodsReceiptLine[]

  @@unique([tenantId, code])
  @@index([purchaseOrderId])
  @@index([businessId, receivedAt])
}

model GoodsReceiptLine {
  id                  String    @id @default(uuid())
  receiptId           String
  purchaseOrderLineId String
  qty                 Int
  lotCode             String?
  expiresAt           DateTime?
  serialNosJson       String?

  receipt           GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([purchaseOrderLineId])
}
