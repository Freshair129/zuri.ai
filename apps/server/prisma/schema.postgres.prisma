  @@index([workspaceId])
  @@index([status])
  @@index([priority])
  @@index([picPersonId])

  marketingHandoffs MarketingHandoff[]
}

// @req FR-089 — a Team records who works together. It is an organisational
// grouping and grants nothing: `resolveViewer` never reads these models, no
// route guard consults them, and adding a Person to a Team changes no role, no
// domain grant and no visible or owned Business (BR-018, ADR-037 D1).
//
// Business-scoped for the same reason Project and Membership are (SEC-001): the
// Business is the operating unit, and a Team spanning Businesses would be a
// group whose members cannot all see the same Projects.
model Team {
  id          String    @id @default(uuid())
  code        String    @unique
  businessId  String
  name        String
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business         @relation(fields: [businessId], references: [id])
  members  TeamMembership[]
  projects ProjectTeam[]

  @@index([businessId])
}

// @req FR-089 — Person ↔ Team, deliberately separate from `Membership`. Same
// distinct-authority-layer discipline BR-016 applies to WorkspaceMembership:
// `Membership` is the authority record `resolveViewer` reads, so folding a
// grouping into it would put grouping and authority in one row — which is how a
// single unauthenticated POST minted business-owner authority on 2026-08-17.
// There is no `role` column here on purpose (ADR-037 D3, "Let Team carry a
// role" rejected): a role on a Team is authority on a Team.
model TeamMembership {
  id        String   @id @default(uuid())
  teamId    String
  personId  String
  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([teamId, personId])
  @@index([teamId])
  @@index([personId])
}

// @req FR-089 — many-to-many, because a Project is worked by several Teams and a
// Team works several Projects. One Team per Project would force a fake "primary
// team" the first time two teams share an initiative, which is the normal case
// (ADR-037 D3).
model ProjectTeam {
  id        String   @id @default(uuid())
  projectId String
  teamId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
  @@index([projectId])
  @@index([teamId])
}

