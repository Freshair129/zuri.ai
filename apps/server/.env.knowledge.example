# .env.knowledge.example — ADR-075 Phase 3 (P-4), names only, never values.
#
# Copy to apps/server/.env.knowledge (gitignored) and fill in at deploy time.
# docs/plans/GENESISRAG17-EDGE-DEPLOYMENT.md §7 is the authority for this list;
# this file is that table in the order an operator fills it.
#
# WHY ONE FILE. genesis-worker loads this as its ONLY env file, marked required, so
# the worker never receives web's database, LINE or model credentials. web loads it
# as an EXTRA optional file next to .env and .env.docker. The shared values —
# MSP_PIPELINE_PRINCIPALS, the relay credential, the worker URL and token — therefore
# exist once and cannot drift between two copies.
#
# NEVER commit a filled copy, paste one into a pull request or report, or log a value
# from it. Values are generated by the operator at deploy time.
#
# Compose does NOT interpolate docker-compose.yml from this file (that is .env's job),
# so nothing here can be referenced as ${...} in the compose file. It only ever
# becomes container environment.

# =============================================================================
# 1. READ THIS BEFORE SETTING ZURI_MSP_COMMAND — risk R-5 (§12)
# =============================================================================
# Setting ZURI_MSP_COMMAND turns MSP on for EVERY caller of
# createMspTransportFromEnvironment, not only knowledge. Those callers are the
# knowledge runtime and executor, the source worker, the evidence pull route
# (POST /api/pipelines/knowledge/evidence/pull), Phase 1 thread memory — and the
# server LINE thread-memory scanner, which is gated ONLY by
# ZURI_MSP_THREAD_SERVICE_KEY, with no enable flag of its own
# (src/modules/agent/server-line-runtime.js).
#
# So: the moment this file gives web a working ZURI_MSP_COMMAND, the LINE
# thread-memory scanner starts too if a thread service key happens to be set
# anywhere in web's environment. Thread memory is OUTSIDE ADR-075's approval.
#
# KEEP BOTH OF THESE UNSET, HERE AND IN .env / .env.docker, and confirm they are
# absent from the running container before §10 step 2:
#
#   ZURI_MSP_THREAD_MEMORY_ENABLED   <- leave unset
#   ZURI_MSP_THREAD_SERVICE_KEY      <- leave unset
#
#   docker exec zuri-ai-web-1 sh -c 'printf "[%s][%s]" "$ZURI_MSP_THREAD_MEMORY_ENABLED" "$ZURI_MSP_THREAD_SERVICE_KEY"'
#   # must print [][]
#
# Also left unset on purpose: GKS_DEFAULT_PORTFOLIO_ID. The pipeline path carries an
# explicit scope on every request; gate G-3 confirms that holds.

# =============================================================================
# 2. web — the admission runtime (§7). FLIP ZURI_KNOWLEDGE_ENABLED LAST (§10 step 5)
# =============================================================================
# 1 starts the knowledge admission runtime inside the Next.js process. Leave this
# unset through steps 2-4; admission answers 503 and the runtime does not start.
ZURI_KNOWLEDGE_ENABLED=
# Exactly one entry: the SmartGift scope plus {allowEmbedding, allowPublication}.
# The runtime accepts exactly one binding (R-9); a second Business needs its own decision.
ZURI_KNOWLEDGE_BINDINGS=
ZURI_KNOWLEDGE_TIMEOUT_MS=
# Private JSON-only FileAsset bucket for structured catalog projections. This is
# separate from asset-evidence (PDF/image evidence) and from the raw-artifact
# S3/MinIO binding below. Production sets the reviewed bucket explicitly.
ZURI_KNOWLEDGE_CATALOG_BUCKET=

# =============================================================================
# 3. web — how zuri-ai spawns MSP (C1). Read section 1 first.
# =============================================================================
# The /opt/ki17 Node 24 runtime, running MSP's own entrypoint from the image.
ZURI_MSP_COMMAND=/opt/ki17/node/bin/node
ZURI_MSP_ARGS=["apps/msp-server/bin/msp-server.mjs"]
ZURI_MSP_CWD=/opt/ki17/msp
ZURI_MSP_TIMEOUT_MS=

# =============================================================================
# 4. web AND genesis-worker — the shared MSP/GKS runtime (C4, C8, C13)
# =============================================================================
# The two files on the ki17-state volume, opened by both MSP sides and every GKS child.
MSP_DB_PATH=/var/lib/zuri-ki17/state/msp.sqlite
GKS_DB_PATH=/var/lib/zuri-ki17/state/gks.sqlite
# How MSP spawns GKS. GKS is never a daemon: one child per relay call.
MSP_GKS_COMMAND=/opt/ki17/node/bin/node
MSP_GKS_ARGS=["apps/gks-server/bin/gks-server.mjs"]
MSP_GKS_CWD=/opt/ki17/gks
# One source grant and one worker grant, on the EXACT same six-field scope object.
# The source credential is the single role:"source" entry whose scope matches the
# binding exactly — more or fewer than one and admission fails closed (C3).
MSP_PIPELINE_PRINCIPALS=
# C13: these two must be EQUAL.
MSP_GKS_PIPELINE_CREDENTIAL=
GKS_PIPELINE_RELAY_CREDENTIAL=
# C5: an explicit loopback origin, no path, no query, no redirect. Inside web's
# network namespace, which the worker shares. Must match GENESIS_WORKER_PORT, must
# not be 3000, and must not be 0 (an ephemeral port cannot be named here).
MSP_PIPELINE_WORKER_URL=http://127.0.0.1:19417
# C13: this must EQUAL GENESIS_WORKER_QUERY_TOKEN below.
MSP_PIPELINE_WORKER_TOKEN=

# =============================================================================
# 5. genesis-worker only — identity, store, model, fixture (C6, C7, C9)
# =============================================================================
GENESIS_WORKER_DB_PATH=/var/lib/zuri-ki17/genesis
# The same scope object as the grants above, as JSON.
GENESIS_WORKER_SCOPE=
# The worker grant's credential from MSP_PIPELINE_PRINCIPALS.
GENESIS_WORKER_CREDENTIAL=
# Must EQUAL MSP_PIPELINE_WORKER_TOKEN above.
GENESIS_WORKER_QUERY_TOKEN=
# The ki17-model volume, read-only, at the pinned revision directory. The worker
# re-verifies all five files' size and SHA-256 at start and fails closed (G-7).
GENESIS_WORKER_MODEL_DIR=/opt/ki17/model/614241f622f53c4eeff9890bdc4f31cfecc418b3
#
# P-6 — baked into the worker image at /opt/ki17/fixtures (see deploy/ki17/README.md):
#
#   genesisrag17-smartgift-benchmark-v1.json  <- DERIVED, and what this points at
#   genesisrag17-smartgift-corpus-v1.json     <- the Phase 2 acceptance corpus
#   smartgift-catalog/                        <- the raw PII-free source fixture
#   genesisrag17-corpus-v1.json               <- the generic ki17 corpus
#
# The worker takes ONE fixture and requires a top-level `queries` array. The SmartGift
# acceptance corpus keeps its queries per record (benchmarks[].queries) because the
# acceptance re-boots the worker once per record; a container boots once. The derived
# file is the union of those queries, with its provenance recorded inside it. Gate G-3
# decides whether the ADR-073 thresholds hold against the union or whether the
# acceptance must keep booting per record — read deploy/ki17/build-smartgift-benchmark.mjs.
#
# PRODUCTION OVERRIDES THIS. The baked file's gold texts are Phase 2 test records: for
# the 22 real catalog records, 20 have no applicable query (Stage 16 fails with
# BENCHMARK_NO_APPLICABLE_QUERIES) and 2 would be scored on one test query only. Production points at the real-record fixture on the
# ki17-state volume, /var/lib/zuri-ki17/state/smartgift-real-benchmark-v1.json, installed
# and extended per record by docs/plans/GENESISRAG17-EDGE-DEPLOYMENT.md §10.1 (ADR-073
# amendment 2026-09-24). Keep that override when rebuilding .env.knowledge from here.
GENESIS_WORKER_BENCHMARK_FIXTURE=/opt/ki17/fixtures/genesisrag17-smartgift-benchmark-v1.json
# A FIXED port, not 0: MSP_PIPELINE_WORKER_URL names it. Not 3000: shared namespace.
GENESIS_WORKER_PORT=19417
GENESIS_WORKER_POLL_MS=

# =============================================================================
# 6. genesis-worker only — the worker's own MSP child (C7)
# =============================================================================
GENESIS_WORKER_MSP_COMMAND=/opt/ki17/node/bin/node
GENESIS_WORKER_MSP_ARGS=["apps/msp-server/bin/msp-server.mjs"]
GENESIS_WORKER_MSP_CWD=/opt/ki17/msp
GENESIS_WORKER_MSP_TIMEOUT_MS=

# The embedding sidecar's interpreter. Already set in the image; listed because §7
# names it and an operator overriding it must know it has to be the baked venv.
GENESISRAG17_PYTHON=/opt/ki17/venv/bin/python

# =============================================================================
# 7. TASK-ZAI-049 — durable knowledge raw artifact storage (PENDING)
# =============================================================================
# Leave this section disabled until the target manifest is READY and the owner
# records a production receipt. The web process reads these names; it never
# receives the provider admin credential used by the storage container.
#
# Isolated overlay example: http://knowledge-storage:9000
# Production: private HTTPS origin only; never an ngrok/public endpoint.
ZURI_KNOWLEDGE_STORAGE_ENABLED=
ZURI_KNOWLEDGE_STORAGE_ENDPOINT=
ZURI_KNOWLEDGE_STORAGE_ACCESS_KEY=
ZURI_KNOWLEDGE_STORAGE_SECRET_KEY=
ZURI_KNOWLEDGE_STORAGE_BUCKET=
ZURI_KNOWLEDGE_STORAGE_REGION=us-east-1
ZURI_KNOWLEDGE_STORAGE_BINDING_ID=
ZURI_KNOWLEDGE_STORAGE_BINDING_REVISION=1
