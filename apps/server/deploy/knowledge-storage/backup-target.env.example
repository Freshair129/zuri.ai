# TASK-ZAI-049 backup target template.
# This target must be on a separate host/storage failure domain. It is a
# contract-only template until the approved backup runner is wired and measured;
# the web process does not read these values.
# Never commit a filled copy or place credentials in a manifest or receipt.

ZURI_KNOWLEDGE_BACKUP_ENDPOINT=
ZURI_KNOWLEDGE_BACKUP_ACCESS_KEY=
ZURI_KNOWLEDGE_BACKUP_SECRET_KEY=
ZURI_KNOWLEDGE_BACKUP_BUCKET=
ZURI_KNOWLEDGE_BACKUP_REGION=us-east-1
ZURI_KNOWLEDGE_BACKUP_LOCATION_ID=
ZURI_KNOWLEDGE_BACKUP_BINDING_ID=
ZURI_KNOWLEDGE_BACKUP_BINDING_REVISION=1
