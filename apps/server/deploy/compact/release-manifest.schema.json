{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zuri:compact-release:v1",
  "$comment": "ADR-115; build-time data contract, not installation or production acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "sourceRevision", "platform", "images", "files", "schemaBaseline", "profiles", "storageQualification", "componentPins", "modelArtifacts", "capabilities"],
  "properties": {
    "schemaVersion": {"const": "compact-release.v1"},
    "releaseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "sourceRevision": {"$ref": "#/$defs/revision"},
    "platform": {"const": "linux/amd64"},
    "images": {
      "type": "object", "additionalProperties": false,
      "required": ["web", "tools", "postgres", "storage"],
      "properties": {
        "web": {"$ref": "#/$defs/image"}, "tools": {"$ref": "#/$defs/image"},
        "postgres": {"$ref": "#/$defs/image"}, "storage": {"$ref": "#/$defs/image"},
        "lineWorker": {"$ref": "#/$defs/image"}, "genesisWorker": {"$ref": "#/$defs/image"}, "ngrok": {"$ref": "#/$defs/image"}
      }
    },
    "files": {"$ref": "#/$defs/files"},
    "schemaBaseline": {"$ref": "#/$defs/file"},
    "profiles": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["core", "line", "knowledge", "public"]}, "contains": {"const": "core"}},
    "storageQualification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "provider", "image", "command", "licenseRequired", "evidence", "licenseEvidence"],
      "properties": {
        "status": {"const": "QUALIFIED"}, "provider": {"const": "S3_COMPATIBLE"}, "image": {"$ref": "#/$defs/image"},
        "command": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9_./:=+@-]+$"}},
        "licenseRequired": {"type": "boolean"}, "evidence": {"$ref": "#/$defs/file"}, "licenseEvidence": {"$ref": "#/$defs/file"}
      }
    },
    "componentPins": {"type": "object", "additionalProperties": false, "properties": {"msp": {"$ref": "#/$defs/revision"}, "gks": {"$ref": "#/$defs/revision"}, "genesisblock": {"$ref": "#/$defs/revision"}}},
    "modelArtifacts": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["id", "repository", "revision", "files"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "repository": {"type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9._/-]+$"}, "revision": {"$ref": "#/$defs/revision"}, "files": {"$ref": "#/$defs/files"}}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["core", "line", "knowledge", "public"], "properties": {"core": {"const": "NOT_QUALIFIED"}, "line": {"enum": ["NOT_QUALIFIED", "NOT_SELECTED"]}, "knowledge": {"enum": ["NOT_QUALIFIED", "NOT_SELECTED"]}, "public": {"enum": ["NOT_QUALIFIED", "NOT_SELECTED"]}}}
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "image": {"type": "string", "maxLength": 300, "pattern": "^[a-z0-9][a-z0-9._:/-]*@sha256:[a-f0-9]{64}$"},
    "files": {"type": "object", "minProperties": 1, "maxProperties": 100000, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "file": {"type": "object", "additionalProperties": false, "required": ["file", "sha256"], "properties": {"file": {"type": "string", "minLength": 1, "maxLength": 240}, "sha256": {"$ref": "#/$defs/hash"}}}
  }
}
