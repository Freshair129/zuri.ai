{
  "name": "zuri-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Zuri v2 Project Manager — offline-first standalone lab build",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "compact:package": "node scripts/compact-package.mjs",
    "compact:baseline": "node scripts/compact-baseline.mjs",
    "compact:self-host": "node scripts/compact-self-host.mjs",
    "test:compact:core": "node scripts/assert-tests-ran.mjs playwright test --config playwright.compact.config.js --fail-on-flaky",
    "test:compact:storage": "node scripts/assert-tests-ran.mjs vitest run --config vitest.compact-storage.config.js",
    "test:compact:provider": "node scripts/assert-tests-ran.mjs vitest run --config vitest.compact-provider.config.js",
    "test:compact:profiles": "node scripts/assert-tests-ran.mjs vitest run --config vitest.compact-profiles.config.js",
    "test:compact:recovery": "node scripts/assert-tests-ran.mjs vitest run --config vitest.compact-recovery.config.js",
    "test:compact:operator-browser": "node scripts/assert-tests-ran.mjs vitest run --config vitest.or3-browser.config.js",
    "compact:test": "node --test tests/node/compact-prepare-input.test.mjs tests/node/compact-manifest.test.mjs tests/node/compact-package.test.mjs tests/node/compact-oci-reference.test.mjs tests/node/compact-workflow.test.mjs tests/node/compact-target.test.mjs tests/node/compact-baseline.test.mjs tests/node/compact-executor.test.mjs tests/node/compact-bootstrap.test.mjs tests/node/compact-profile.test.mjs tests/node/compact-qualification.test.mjs",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:clean": "prisma db push --force-reset",
    "db:reset": "prisma db push --force-reset && node prisma/seed.js",
    "db:pg:schema": "node scripts/gen-postgres-schema.mjs",
    "programme:containers": "node scripts/programme-containers.mjs",
    "programme:usage": "node scripts/programme-usage-meter.mjs",
    "db:pg:sql": "npm run db:pg:schema && prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.postgres.prisma --script > prisma/postgres/0001_init.sql",
    "db:pg:export": "node scripts/migrate-to-postgres.mjs export snapshot.json",
    "db:pg:import": "node scripts/migrate-to-postgres.mjs import snapshot.json",
    "test": "node scripts/assert-tests-ran.mjs vitest run",
    "test:unit": "node scripts/assert-tests-ran.mjs vitest run tests/unit",
    "test:integration": "node scripts/assert-tests-ran.mjs vitest run tests/integration",
    "test:production-migration:isolated": "node scripts/run-production-migration-isolated-postgres.mjs",
    "test:postgres": "node scripts/assert-tests-ran.mjs vitest run --config vitest.postgres.config.js",
    "test:knowledge-restore:isolated": "node scripts/assert-tests-ran.mjs vitest run --config vitest.knowledge-restore.config.js",
    "test:genesisrag17": "node scripts/run-genesisrag17-acceptance.mjs",
    "test:knowledge-admission": "node scripts/run-knowledge-admission-acceptance.mjs",
    "test:e2e": "node scripts/assert-tests-ran.mjs playwright test --fail-on-flaky",
    "test:e2e:changed": "node scripts/e2e-changed.mjs",
    "verify": "npm run govern && npm test && npm run build && npm run test:e2e",
    "postinstall": "node scripts/generate-prisma-clients.mjs",
    "docs:graph": "node scripts/doc-graph.mjs",
    "docs:check": "node scripts/doc-graph.mjs --check",
    "docs:preflight": "node scripts/doc-preflight.mjs --strict",
    "docs:preflight:report": "node scripts/doc-preflight.mjs",
    "docs:ids": "node scripts/id-ledger.mjs",
    "docs:registry:check": "node ../../tools/document-registry.mjs --check",
    "docs:identity:check": "node ../../tools/document-identity.mjs --check",
    "docs:inventory:check": "node ../../tools/document-inventory.mjs --check",
    "docs:views:check": "node ../../tools/generate-document-views.mjs --check",
    "govern": "node ../../scripts/verification-plan.mjs --map && npm run docs:registry:check && npm run docs:inventory:check && npm run docs:identity:check && npm run docs:graph && npm run docs:views:check && npm run docs:check && npm run docs:preflight",
    "phase1:evaluate": "node scripts/evaluate-phase1-golden.mjs",
    "phase1:isolation:verify": "node scripts/verify-line-runtime-isolation.mjs",
    "phase1:canary:plan": "node scripts/plan-line-canary.mjs",
    "phase1:line-binding": "node scripts/manage-line-binding.mjs",
    "asset:production:receipt:verify": "node scripts/verify-asset-production-receipt.mjs",
    "self:plan": "node scripts/self-plan.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@prisma/client": "5.22.0",
    "date-fns": "3.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "0.474.0",
    "next": "15.5.28",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "saxes": "6.0.0",
    "three": "^0.186.0",
    "yauzl": "3.4.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "10.4.20",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "0.21.5",
    "pg-connection-string": "^2.14.0",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "supabase": "2.114.0",
    "tailwindcss": "3.4.17",
    "vitest": "2.1.9",
    "yaml": "2.9.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.31"
    }
  }
}
