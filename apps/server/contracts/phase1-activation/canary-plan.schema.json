{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zuri.local/contracts/phase1-activation/canary-plan.schema.json",
  "title": "Phase 1 LINE Canary Dry-Run Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "mode", "ready", "receiptState", "scope", "evidence", "checks", "capabilities", "failureGuidance"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "mode": { "const": "DRY_RUN" },
    "ready": { "const": true },
    "receiptState": { "const": "EVIDENCE_VERIFIED" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRef", "tenantId", "businessId", "bindingId", "providerId", "modelId", "goldenReportSha256", "isolationReportSha256"],
      "properties": {
        "projectRef": { "type": "string", "minLength": 1 },
        "tenantId": { "type": "string", "format": "uuid" },
        "businessId": { "type": "string", "format": "uuid" },
        "bindingId": { "type": "string", "format": "uuid" },
        "providerId": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "goldenReportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "isolationReportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goldenReportSha256", "isolationReportSha256"],
      "properties": {
        "goldenReportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "isolationReportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "const": "PASS" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canActivateBinding", "canSendLine"],
      "properties": {
        "canActivateBinding": { "const": false },
        "canSendLine": { "const": false }
      }
    },
    "failureGuidance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
