{
  "schema": "zuri-document-kinds/1",
  "authority": "ADR-118 adopts the kind matrix; this file is its machine form. It classifies paths for the generated catalog, docs:find and the added-document checks (ADR-118 amendments 1 to 3: WARNING, except enforce:critical on the named legacy homes). It moves nothing, grants no ownership, and is not an approval list.",
  "ownerRole": "governance integrator (AGENTS.md section 19)",
  "homes": {
    "write": "new documents of this kind go here",
    "legacy": "existing documents stay; no new documents of this kind",
    "frozen": "pinned, historical or external; never edited as a source",
    "generated": "produced by a generator; never hand-edited",
    "local": "untracked local memory; never a document home",
    "external": "separate namespace with its own governance (Edge)",
    "tolerated": "active practice with no write home in the kind matrix yet: new documents are neither flagged for placement nor asked for metadata, pending an owner decision to adopt or retire the home"
  },
  "kinds": {
    "K1": { "name": "product", "aliases": ["product"], "sot": "docs/PRODUCT.md and accepted ADRs", "writeHome": "docs/PRODUCT.md (edit only)" },
    "K2": { "name": "requirement", "aliases": ["requirement", "feature", "fr", "feat", "record"], "sot": "canonical per-ID records (ids pinned by ADR-039)", "writeHome": "docs/features/FEAT-nnn/, docs/requirements/ via the reviewed record workflow" },
    "K3": { "name": "decision", "aliases": ["decision", "adr"], "sot": "the ADR with its recorded lifecycle", "writeHome": "docs/decisions/ADR-nnn-*" },
    "K4": { "name": "change-request", "aliases": ["change-request", "cr", "change"], "sot": "the change record's recorded state", "writeHome": "docs/change-requests/<area>/ (intake), docs/changes/ (issued ZV2-CR only)" },
    "K5": { "name": "domain", "aliases": ["domain", "charter", "srs"], "sot": "the domain charter", "writeHome": "docs/domains/<d>/CHARTER.md (optional SRS.md beside it)" },
    "K6": { "name": "architecture", "aliases": ["architecture", "design"], "sot": "accepted ADRs, then ARCHITECTURE.md; code for implementation", "writeHome": "docs/architecture/" },
    "K7": { "name": "service", "aliases": ["service"], "sot": "package scripts and wire schemas; service docs explain", "writeHome": "docs/services/<svc>/" },
    "K8": { "name": "contract", "aliases": ["contract", "api", "schema"], "sot": "the source-owned schema file", "writeHome": "apps/server/contracts/, prisma/, route code" },
    "K9": { "name": "plan", "aliases": ["plan"], "sot": "ROADMAP.md for state; the plan for its bounded scope only", "writeHome": "docs/plans/" },
    "K10": { "name": "delivery-state", "aliases": ["roadmap", "delivery"], "sot": "the ledger in docs/roadmap/ROADMAP.md", "writeHome": "docs/roadmap/ROADMAP.md (edit only)" },
    "K11": { "name": "operations", "aliases": ["runbook", "operations", "deployment", "migration"], "sot": "the runbook for its procedure", "writeHome": "docs/runbooks/, docs/deployment/" },
    "K12": { "name": "evidence", "aliases": ["report", "evidence", "assessment"], "sot": "dated evidence for its scope only, never current state", "writeHome": "reports/" },
    "K13": { "name": "rca", "aliases": ["rca", "incident"], "sot": "the RCA for its incident", "writeHome": ".brain/rca/" },
    "K14": { "name": "instruction", "aliases": ["instruction", "agents", "governance", "entry"], "sot": "AGENTS.md", "writeHome": "AGENTS.md, CLAUDE.md, .agents/, .claude/" },
    "K15": { "name": "template", "aliases": ["template"], "sot": "the template", "writeHome": "docs/templates/" },
    "K16": { "name": "archive", "aliases": ["archive", "frozen", "history"], "sot": "frozen by pinned path and hash", "writeHome": "docs/archive/" },
    "K17": { "name": "session-memory", "aliases": ["session"], "sot": "none; a lead, not an authority", "writeHome": ".brain/session-memory/ (untracked)" },
    "K18": { "name": "generated", "aliases": ["generated", "view"], "sot": "the generator and its sources", "writeHome": "never written by hand" },
    "EDGE": { "name": "edge", "aliases": ["edge"], "sot": "apps/edge governance (ADR-062)", "writeHome": "apps/edge/docs/" }
  },
  "rules": [
    { "path": "docs/PRD-SDD-v1.0.md", "kind": "K18", "home": "generated" },
    { "path": "docs/FEATURES.md", "kind": "K18", "home": "generated" },
    { "path": "docs/product/README.md", "kind": "K18", "home": "generated" },
    { "path": "docs/architecture/README.md", "kind": "K18", "home": "generated" },
    { "path": "docs/operations/README.md", "kind": "K18", "home": "generated" },
    { "path": "docs/governance/README.md", "kind": "K18", "home": "generated" },
    { "path": "registry/document-registry/index.json", "kind": "K18", "home": "generated" },
    { "prefix": "registry/document-registry/", "kind": "K15", "home": "write" },
    { "prefix": "registry/", "kind": "K16", "home": "frozen" },

    { "prefix": "apps/edge/", "kind": "EDGE", "home": "external" },
    { "prefix": ".claude/worktrees/", "kind": "K17", "home": "local" },
    { "prefix": ".brain/session-memory/", "kind": "K17", "home": "local" },
    { "prefix": ".brain/rca/evidence/", "kind": "K16", "home": "frozen", "addAllowed": true, "note": "evidence copies are created together with the RCA they support" },
    { "prefix": ".brain/rca/", "kind": "K13", "home": "write" },
    { "prefix": ".brain/plans/", "kind": "K9", "home": "legacy", "enforce": "critical", "note": "no new documents; new plans go in docs/plans/ (ADR-118 amendments 1 and 3). Existing plans and task-readiness files stay where they are" },
    { "prefix": ".brain/reports/", "kind": "K12", "home": "legacy", "note": "existing reports stay; new reports go in reports/ (ADR-118 amendment 3, delegated decision D-D1)" },
    { "prefix": ".brain/reviews/", "kind": "K12", "home": "legacy", "note": "existing reviews stay (cited by ADR-117); new reviews go in reports/ (ADR-118 amendment 3, delegated decision D-D1)" },
    { "prefix": ".brain/", "kind": "K12", "home": "legacy" },

    { "prefix": "docs/requirements/", "kind": "K2", "home": "write" },
    { "prefix": "docs/features/", "kind": "K2", "home": "write" },
    { "prefix": "docs/decisions/", "kind": "K3", "home": "write" },
    { "prefix": "docs/changes/artifacts/", "kind": "K4", "home": "legacy" },
    { "prefix": "docs/changes/", "kind": "K4", "home": "write" },
    { "prefix": "docs/change-requests/marketing/", "kind": "K4", "home": "write", "priorArt": false, "note": "bundle of phase and flow documents under one intake" },
    { "prefix": "docs/change-requests/zuri_inference_pool_v0.1.1b_approved/", "kind": "K4", "home": "write", "priorArt": false, "note": "approved bundle; its parts share one subject" },
    { "prefix": "docs/change-requests/", "kind": "K4", "home": "write" },
    { "prefix": "docs/domains/", "kind": "K5", "home": "write", "priorArt": false, "note": "domain notes explain canonical records and cite them by id (AGENTS.md section 19) rather than starting a new subject" },
    { "pattern": "^docs/architecture/project-manager-system/\\d{2}-[^/]+\\.md$", "kind": "K6", "home": "write", "priorArt": false, "note": "numbered chapters of one specification" },
    { "prefix": "docs/architecture/", "kind": "K6", "home": "write" },
    { "prefix": "docs/services/", "kind": "K7", "home": "write" },
    { "prefix": "docs/appendices/", "kind": "K8", "home": "legacy" },
    { "path": "docs/roadmap/ROADMAP.md", "kind": "K10", "home": "write" },
    { "pattern": "^docs/roadmap/PLAN-[^/]+\\.md$", "kind": "K9", "home": "legacy", "enforce": "critical", "note": "no new plans here; new plans go in docs/plans/ (docs/roadmap/README.md; ADR-118 amendment 3)" },
    { "prefix": "docs/roadmap/", "kind": "K9", "home": "legacy" },
    { "prefix": "docs/plans/", "kind": "K9", "home": "write" },
    { "prefix": "docs/superpowers/specs/", "kind": "K9", "home": "legacy", "enforce": "critical", "note": "no new documents; brainstorming specs and plans go in docs/plans/ (ADR-118 amendment 1)" },
    { "prefix": "docs/superpowers/plans/", "kind": "K9", "home": "legacy", "enforce": "critical", "note": "no new documents; the skill default path is not a write home (ADR-118 amendment 1)" },
    { "prefix": "docs/superpowers/", "kind": "K9", "home": "legacy", "enforce": "critical", "note": "no new documents; new specs and plans go in docs/plans/ (ADR-118 amendments 1 and 3); the two FR-293 files stay (deferred)" },
    { "prefix": "docs/runbooks/", "kind": "K11", "home": "write" },
    { "prefix": "docs/deployment/", "kind": "K11", "home": "write" },
    { "pattern": "^docs/migrations/document-reintegration/record-migrations/[^/]+\\.approval\\.md$", "kind": "K16", "home": "frozen", "addAllowed": true, "note": "sealed approval copies are created by the reviewed record workflow" },
    { "prefix": "docs/migrations/document-reintegration/record-migrations/", "kind": "K16", "home": "frozen" },
    { "prefix": "docs/migrations/", "kind": "K11", "home": "write", "note": "migration procedures are K11 (ADR-118 amendment 3, delegated decision D-D1); the more specific frozen record-migrations rules above win" },
    { "prefix": "docs/templates/", "kind": "K15", "home": "write" },
    { "prefix": "docs/archive/", "kind": "K16", "home": "frozen" },
    { "prefix": "docs/prompts/", "kind": "K16", "home": "legacy" },
    { "prefix": "docs/governance/", "kind": "K14", "home": "write", "note": "governance policies and registers (ADR-118 amendment 3, delegated decision D-D1)" },
    { "path": "docs/PRODUCT.md", "kind": "K1", "home": "write" },
    { "path": "docs/README.md", "kind": "K14", "home": "write" },
    { "pattern": "^docs/GOVERNANCE-[^/]+\\.md$", "kind": "K14", "home": "legacy" },
    { "pattern": "^docs/[^/]+\\.md$", "kind": "K6", "home": "legacy", "note": "direct children of docs/ are registered legacy entrypoints (ROOT-FILE-REGISTER.md)" },

    { "pattern": "^reports/[^/]+-\\d{4}-\\d{2}-\\d{2}/.+", "kind": "K12", "home": "write", "priorArt": false, "note": "documents inside a dated assessment folder (name ending -YYYY-MM-DD) belong to that assessment" },
    { "prefix": "reports/", "kind": "K12", "home": "write" },
    { "prefix": ".agent/", "kind": "K12", "home": "legacy", "enforce": "critical", "note": "August 2026 phase machinery; existing reports, inventories and evidence stay (cited by issued change records); no new documents" },
    { "prefix": "agent/", "kind": "K12", "home": "legacy", "enforce": "critical", "note": "phase briefs paired with .agent/reports; existing files stay; no new documents" },
    { "prefix": ".rwang-tasks/", "kind": "K12", "home": "legacy", "enforce": "critical", "note": "existing report stays; no new documents" },
    { "prefix": "reference/", "kind": "K16", "home": "frozen" },

    { "path": "AGENTS.md", "kind": "K14", "home": "write" },
    { "path": "CLAUDE.md", "kind": "K14", "home": "write" },
    { "path": "README.md", "kind": "K14", "home": "write" },
    { "path": "llms.txt", "kind": "K14", "home": "write" },
    { "path": "MASTER-PROMPT.md", "kind": "K16", "home": "legacy" },
    { "path": "todo.md", "kind": "K16", "home": "legacy" },
    { "path": "hardware-performance-audit.md", "kind": "K12", "home": "legacy" },
    { "prefix": ".agents/", "kind": "K14", "home": "write" },
    { "prefix": ".claude/", "kind": "K14", "home": "write" },
    { "prefix": "skills/", "kind": "K14", "home": "tolerated", "note": "skill documentation sits beside the skill" },
    { "prefix": "services/", "kind": "K7", "home": "tolerated", "note": "READMEs and notes beside code; explanations of a service belong in docs/services/" },
    { "prefix": "apps/", "kind": "K7", "home": "tolerated", "note": "READMEs and notes beside code; explanations of a service belong in docs/services/" },
    { "prefix": "experiments/", "kind": "K16", "home": "frozen" }
  ],
  "requiredFields": {
    "K1": ["status", "version"],
    "K3": ["doc_type", "status", "version", "last_update"],
    "K4": ["status", "version"],
    "K5": ["status", "version"],
    "K6": ["doc_type", "status", "version"],
    "K7": ["status", "version"],
    "K9": ["id", "doc_type", "status", "version"],
    "K10": ["status", "version"],
    "K11": ["status", "version"],
    "K12": ["doc_type", "status", "version"],
    "K13": ["status", "version"]
  },
  "vocabulary": {
    "K3": { "statuses": ["approved", "beta"], "docTypes": ["architecture-decision"] },
    "K4": { "statuses": ["approved", "beta"], "docTypes": ["change-request", "intake-note", "interface-contract", "contract", "feature-contract-proposal", "domain-design-proposal", "capability-proposal"] },
    "K5": { "statuses": ["beta", "approved", "building", "implemented", "declared", "partial", "active-foundation", "phase-1-building"], "docTypes": ["supporting-document", "feature-specification", "feature-note", "context-map", "design-contract", "implementation-spec-proposal"] },
    "K6": { "statuses": ["approved", "beta"], "docTypes": ["architecture-specification", "architecture-spec", "implementation-baseline", "implementation-packet", "requirements-specification", "data-design", "execution-specification"] },
    "K9": { "statuses": ["approved", "beta"], "docTypes": ["design", "deployment-design"] },
    "K11": { "statuses": ["beta", "current", "approved"], "docTypes": ["runbook", "deployment-guide"] },
    "K12": { "statuses": ["reviewed", "local-evidence"], "docTypes": ["implementation-evidence", "verification-evidence", "assessment", "assessment-index", "code-requirements-assessment", "source-assessment", "implementation-verification-record"] },
    "K13": { "statuses": ["beta", "under review", "resolved", "open"], "docTypes": ["root-cause-analysis", "rca"] }
  },
  "priorArtKinds": ["K3", "K4", "K6", "K9", "K12"],
  "docTypes": ["product", "requirement-record", "decision", "change-request", "domain-charter", "domain-srs-view", "architecture", "service", "contract", "implementation-plan", "design-proposal", "roadmap", "runbook", "assessment", "rca", "instruction", "template", "generated-view", "archive-record"],
  "statuses": ["draft", "candidate", "proposed", "accepted", "active", "superseded", "retired", "generated"]
}
