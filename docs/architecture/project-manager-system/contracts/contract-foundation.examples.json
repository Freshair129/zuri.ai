  "negativeAndRaceCases": [
    {
      "case": "same-idempotency-retry",
      "setup": "Commit succeeds, client retries with the same method, scope, key and normalized hash.",
      "expected": "Same durable receiptId, effect fields, recordedAt and ETag; fresh requestId/X-Request-ID for the second HTTP attempt; no second allocation or AuditEvent."
    },
    {
      "case": "changed-idempotency-payload",
      "setup": "Reuse a committed key with a changed person, interval, unit or scope.",
      "expected": "409 IDEMPOTENCY_KEY_REUSED; no write."
    },
    {
      "case": "concurrent-capacity",
      "setup": "Two valid previews commit overlapping remainingMinutes for one person at the same time.",
      "expected": "At most one consumes the contested capacity; loser receives 409 CAPACITY_CONFLICT or 412 VERSION_MISMATCH; no partial state."
    },
    {
      "case": "foreign-scope",
      "setup": "Use a real Person, WorkItem or Project from another Business.",
      "expected": "Same redacted 404 RESOURCE_NOT_FOUND as an unknown id."
    },
    {
      "case": "team-membership-is-not-auth",
      "setup": "Caller belongs to TeamMembership but has no Identity workforce.plan permission.",
      "expected": "403 CAPABILITY_DENIED; TeamMembership is not consulted as authority."
    },
    {
      "case": "legacy-nonintegral-hours",
      "setup": "Submit effortHours=1.333.",
      "expected": "422 ALLOCATION_UNIT_CONVERSION_REQUIRED; no rounded minute is stored."
    },
    {
      "case": "legacy-nonperson-resource",
      "setup": "Submit resourceId for an asset or agent under HUMAN_PERSON_V1.",
      "expected": "422 RESOURCE_TYPE_UNSUPPORTED or ALLOCATION_COMPATIBILITY_INCOMPLETE; no Person, membership or capacity row is created."
    }
  ],
