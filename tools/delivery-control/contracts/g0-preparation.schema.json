{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G0 draft preparation sidecar; never an admission",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "policyVersion", "rootLineageId", "packetDigest", "mandateReference", "readSet", "acceptanceCommands"],
  "properties": {
    "kind": { "const": "g0-preparation" },
    "schemaVersion": { "const": "g0-preparation/v1" },
    "policyVersion": { "type": "integer", "minimum": 1 },
    "rootLineageId": { "$ref": "#/$defs/text" },
    "packetDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "mandateReference": { "$ref": "#/$defs/text" },
    "readSet": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "acceptanceCommands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterionId", "shell", "executable", "argv", "cwd", "environmentReceiptSha256"],
        "properties": {
          "criterionId": { "$ref": "#/$defs/text" },
          "shell": { "const": false },
          "executable": { "$ref": "#/$defs/text" },
          "argv": { "type": "array", "items": { "type": "string" } },
          "cwd": { "$ref": "#/$defs/text" },
          "environmentReceiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "$defs": { "text": { "type": "string", "minLength": 1, "pattern": "\\S" } }
}
