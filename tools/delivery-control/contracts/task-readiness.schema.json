{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task readiness input for automatic preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "objective",
    "acceptance",
    "writeScope",
    "checks",
    "mandateReference"
  ],
  "properties": {
    "schemaVersion": { "const": "task-readiness/v1" },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "objective": { "$ref": "#/$defs/nonempty" },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "writeScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty" },
      "description": "Repository-relative slash paths. Preflight rejects traversal and symlink or junction escapes."
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" },
      "description": "Declared checks are capability-validated and never executed by preflight."
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "mandateReference": {
      "$ref": "#/$defs/nonempty",
      "description": "Provenance pointer only; this field does not authenticate authority."
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shell", "executable", "argv", "cwd"],
      "properties": {
        "shell": { "const": false },
        "executable": { "$ref": "#/$defs/nonempty" },
        "argv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cwd": {
          "$ref": "#/$defs/nonempty",
          "description": "Repository-relative working directory."
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId"],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "$ref": "#/$defs/nonempty",
          "description": "Optional revision which must resolve to an ancestor of the selected base."
        }
      }
    }
  }
}
