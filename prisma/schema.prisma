// Zuri v2 Lab — local MVP schema.
// SQLite-compatible strategy: persisted enums are strings (see src/lib/validation/enums.js).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Portfolio {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  tenants              Tenant[]
  legalEntities        LegalEntity[]
  workspaces           Workspace[]
  // @req FR-067 — the top-level collaboration Workspace the user sees IS this
  // Portfolio (ADR-027 §D2); membership and invites key off portfolioId.
  workspaceMemberships WorkspaceMembership[]
  workspaceInvites     WorkspaceInvite[]
}

model Tenant {
  id          String   @id @default(uuid())
  code        String   @unique
  portfolioId String
  name        String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  portfolio                 Portfolio                  @relation(fields: [portfolioId], references: [id])
  businesses                Business[]
  workspaces                Workspace[]
  memberships               Membership[]
  externalIdentities        ExternalIdentity[]
  channelIdentities         ChannelIdentity[]
  identityLinkTokens        IdentityLinkToken[]
  customers                 Customer[]
  roleBindings              RoleBinding[]
  customerImportBatches     CustomerImportBatch[]
  customerImportReviewCases CustomerImportReviewCase[]
  localWorkspaceMounts      LocalWorkspaceMount[]
  fileAssets                FileAsset[]
  integrationConnections    IntegrationConnection[]
  ingestionRuns             IngestionRun[]
  rawExternalRecords        RawExternalRecord[]
  syncCursors               SyncCursor[]
  externalEntityRefs        ExternalEntityRef[]
  deadLetterRecords         DeadLetterRecord[]
  pipelineRuns              PipelineRun[]
  sotDecisions              SotDecision[]
  sotDataPlaneKeys          SotDataPlaneKey[]
  apiAccessKeys             ApiAccessKey[]

  @@index([portfolioId])
}

model LegalEntity {
  id          String   @id @default(uuid())
  code        String   @unique
  portfolioId String
  legalName   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolio   Portfolio               @relation(fields: [portfolioId], references: [id])
  identifiers LegalEntityIdentifier[]
  businesses  Business[]

  @@index([portfolioId])
}

model LegalEntityIdentifier {
  id            String    @id @default(uuid())
  legalEntityId String
  country       String    @default("TH")
  type          String
  value         String
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([country, type, value])
  @@index([legalEntityId])
}

model Business {
  id            String   @id @default(uuid())
  code          String   @unique
  tenantId      String
  legalEntityId String?
  name          String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  version       Int      @default(1)

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  legalEntity               LegalEntity?               @relation(fields: [legalEntityId], references: [id])
  branches                  Branch[]
  workspaces                Workspace[]
  memberships               Membership[]
  // @req FR-089 — Teams are Business-scoped (ADR-037 D2).
  teams                     Team[]
  customers                 Customer[]
  roleBindings              RoleBinding[]
  customerImportBatches     CustomerImportBatch[]
  customerImportReviewCases CustomerImportReviewCase[]
  roadmaps                  BusinessRoadmap[]
  goals                     BusinessGoal[]
  projects                  Project[]
  localWorkspaceMounts      LocalWorkspaceMount[]
  fileAssets                FileAsset[]
  integrationConnections    IntegrationConnection[]
  ingestionRuns             IngestionRun[]
  rawExternalRecords        RawExternalRecord[]
  syncCursors               SyncCursor[]
  externalEntityRefs        ExternalEntityRef[]
  deadLetterRecords         DeadLetterRecord[]
  repositories              Repository[]
  pipelineRuns              PipelineRun[]
  sotDecisions              SotDecision[]

  @@index([tenantId])
}

model Branch {
  id         String   @id @default(uuid())
  code       String   @unique
  tenantId   String
  businessId String
  name       String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  memberships Membership[]

  @@index([tenantId])
  @@index([businessId])
}

model Person {
  id          String   @id @default(uuid())
  code        String   @unique
  displayName String
  email       String?
  // @req FR-122 — What the Profile step collects about the person themselves.
  // Nullable here and required at the profile boundary instead, because Person
  // rows exist that can never supply them: the seed, FR-107's operator
  // bootstrap, and every Person FR-023's LINE ingest creates from a lineUserId
  // on first contact, which has a channel subject and nothing else. A NOT NULL
  // on these columns would make that intake path unwritable.
  firstName   String?
  lastName    String?
  phone       String?
  // @req FR-066 — Profile completion marker: an identity step over Person
  // (ADR-027 D1), never an authorization grant (BR-016). Null = the person has
  // not finished the profile-first onboarding step yet.
  profileCompletedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships                   Membership[]
  credential                    PersonCredential?
  passwordResetTokens           PasswordResetToken[]
  teamMemberships               TeamMembership[]
  // @req FR-088 — Projects this Person is accountable for (PIC).
  picProjects                   Project[]                      @relation("ProjectPic")
  externalIdentities            ExternalIdentity[]
  channelIdentities             ChannelIdentity[]
  sessions                      Session[]
  identityLinkTokens            IdentityLinkToken[]
  pluginAuthorizationCodes      PluginAuthorizationCode[]
  pluginSessions                PluginSession[]
  customers                     Customer[]
  roleBindings                  RoleBinding[]
  customerImportApprovals       CustomerImportBatch[]          @relation("CustomerImportBatchApprover")
  customerImportProvenance      CustomerImportProvenance[]     @relation("CustomerImportProvenancePerson")
  customerImportReviewDecisions CustomerImportReviewDecision[] @relation("CustomerImportReviewDecisionActor")
  // @req FR-103 — the staff member who attested a Customer's PDPA consent (SEC-005).
  customerConsentAttestations   Customer[]                     @relation("CustomerConsentRecordedBy")
  // @req FR-107 — server-held installation-operator grants (FR-075's isOperator store).
  platformGrants                PlatformGrant[]                @relation("PlatformGrantPerson")
  platformGrantsIssued          PlatformGrant[]                @relation("PlatformGrantIssuer")
  // @req FR-067 — Workspace collaboration grants and the invites this person issued.
  workspaceMemberships          WorkspaceMembership[]
  workspaceInvitesIssued        WorkspaceInvite[]              @relation("WorkspaceInviteInviter")
}

// @req FR-107 — the server-held store behind FR-075's `isOperator` capability.
// A row here is the ONLY thing that makes a web session an installation
// operator: the session port resolves it per request (revocation takes effect
// on the next request, NFR-019 discipline), and nothing else — not role, not
// ownership, not `isPlatform` — is ever read as operator authority.
// @spec FR-075, SEC-008
model PlatformGrant {
  id                String    @id @default(uuid())
  personId          String
  capability        String    @default("OPERATOR")
  status            String    @default("ACTIVE")
  grantedByPersonId String?
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  revokeReason      String?

  person   Person  @relation("PlatformGrantPerson", fields: [personId], references: [id], onDelete: Cascade)
  grantedBy Person? @relation("PlatformGrantIssuer", fields: [grantedByPersonId], references: [id], onDelete: SetNull)

  @@unique([personId, capability])
  @@index([capability, status])
}

// @req FR-067 — Workspace collaboration membership, keyed by `portfolioId`:
// the user-facing top-level Workspace IS schema Portfolio (ADR-027 §D2/D5),
// never schema `Workspace`, which is a Space one level below Business.
// @spec BR-016 — a DISTINCT authority layer, same discipline as FR-089's
// TeamMembership: `resolveViewer` never reads this table, so holding one grants
// nothing on the existing viewer contract — no visibleBusinessIds, no
// ownedBusinessIds, no domains. Tenant/Business/Space/Project access remains a
// separate server-authorized assignment (AC-067.5).
// @tested tests/integration/workspace-onboarding-flow.test.js
model WorkspaceMembership {
  id                String   @id @default(uuid())
  portfolioId       String
  personId          String
  role              String   @default("MEMBER")
  status            String   @default("ACTIVE")
  invitedByPersonId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  version           Int      @default(1)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id])
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, personId])
  @@index([personId, status])
  @@index([portfolioId, status])
}

// @req FR-067 — scoped, expiring, single-use Workspace invite. `tokenHash` is a
// SHA-256 digest (SEC-014, the FR-104 discipline): the raw token appears exactly
// once in the authenticated mint response and is never persisted or logged.
// EXPIRED is deliberately not a persisted status — expiry is a fail-closed
// comparison against `expiresAt` at acceptance time, so a clock cannot be
// outrun by a status column that nobody updated.
// @spec SEC-014, BR-016, SDD-038
// @tested tests/unit/workspace-invite-service.test.js
model WorkspaceInvite {
  id                 String    @id @default(uuid())
  portfolioId        String
  invitedByPersonId  String
  targetPersonId     String?
  invitedEmail       String?
  role               String    @default("MEMBER")
  status             String    @default("PENDING")
  tokenHash          String    @unique
  expiresAt          DateTime
  acceptedByPersonId String?
  acceptedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id])
  invitedBy Person    @relation("WorkspaceInviteInviter", fields: [invitedByPersonId], references: [id])

  @@index([portfolioId, status])
  @@index([targetPersonId, status])
  @@index([invitedEmail, status])
}

// @req FR-090 — the production authentication credential and its password-reset
// token, declared here because both tables already exist on the Supabase database
// and `PersonCredential` holds a live row. They were pushed there from the
// unmerged branch `codex/postgres-primary-runtime`; without them in this file
// `prisma migrate diff` proposes DROPping both, which is how an ordinary
// `db push` would have destroyed a real credential without anyone reading the SQL.
//
// This declares the shape that exists, not that the feature has landed: the
// service and routes that use these tables still live on that branch. When it
// merges, its own FR ids must not reuse FR-082/FR-083 — `main` already spent
// those on the pipeline canvas (ADR-035), and an id is a key (AGENTS.md §18).
model PersonCredential {
  id           String   @id @default(uuid())
  personId     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  personId  String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([token])
}

// @req FR-123 — durable public-client authorization-code and plugin-session
// boundary. A PluginInstallation is a named public-client binding, distinct
// from FR-106's `ApiAccessKey`: that one is a long-lived Tenant-scoped service
// credential, this one is a short-lived per-Person delegation.
// @spec ADR-052, SDD-074, SEC-022
// @tested tests/unit/fr123-plugin-auth-service.test.js
model PluginInstallation {
  id             String   @id @default(uuid())
  installationId String   @unique
  clientId       String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  authorizationCodes PluginAuthorizationCode[]
  sessions           PluginSession[]

  @@index([clientId, status])
}

// @req FR-123 — the code is single-use, PKCE-bound, exact-client/redirect bound
// and short-lived. Raw authorization codes are never persisted, only their hash.
// @spec ADR-052, SEC-022
// @tested tests/unit/fr123-plugin-auth-service.test.js
model PluginAuthorizationCode {
  id                   String    @id @default(uuid())
  codeHash             String    @unique
  clientId             String
  redirectUri          String
  codeChallenge        String
  codeChallengeMethod  String    @default("S256")
  pluginInstallationId String
  personId             String
  expiresAt            DateTime
  consumedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())

  pluginInstallation PluginInstallation @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  person             Person             @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([pluginInstallationId, expiresAt])
  @@index([personId, expiresAt])
}

// @req FR-123 — opaque bearer material is hash-only, short-lived and revocable.
// @spec ADR-052, SEC-022
// @tested tests/unit/fr123-plugin-auth-service.test.js
model PluginSession {
  id                   String    @id @default(uuid())
  tokenHash            String    @unique
  clientId             String
  pluginInstallationId String
  personId             String
  // @req FR-123 — the code this session was minted from, so that replaying a
  // consumed code revokes the session it already produced (RFC 9700 §4.1.1).
  // Nullable because the code row may be pruned after it expires; a session
  // whose origin has been forgotten is still a valid, revocable session.
  authorizationCodeId  String?
  expiresAt            DateTime
  revokedAt            DateTime?
  lastUsedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  pluginInstallation PluginInstallation @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  person             Person             @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([pluginInstallationId, expiresAt])
  @@index([personId, expiresAt])
  @@index([authorizationCodeId])
}

model Membership {
  id             String   @id @default(uuid())
  personId       String
  tenantId       String
  businessId     String?
  branchId       String?
  employeeRef    String?
  role           String   @default("OWNER")
  status         String   @default("ACTIVE")
  domainKeysJson String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  version        Int      @default(1)

  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])

  @@index([personId])
  @@index([personId, status])
  @@index([tenantId])
  @@index([tenantId, status])
}

// @req FR-095 — the signed cookie is transport only; the live session row is
// the revocable server-side request authority.
// @req FR-096 — authorization recomputes from trusted server state.
// @spec ADR-045 D2-D4, SDD-052, SEC-018
model Session {
  id           String    @id @default(uuid())
  personId     String
  tokenHash    String    @unique
  status       String    @default("ACTIVE")
  assurance    String    @default("PASSWORD")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?
  version      Int       @default(1)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, status])
  @@index([expiresAt, status])
}

// @req FR-094 — external channel subjects are namespaced attributes, never
// canonical principals or primary keys.
// @req FR-097 — channel binding has an explicit pending/verified lifecycle.
// @spec ADR-045 D1, D5, SDD-052, BR-020
model ChannelIdentity {
  id               String    @id @default(uuid())
  personId         String
  tenantId         String
  channel          String
  channelAccountId String
  providerSubject  String
  status           String    @default("PENDING")
  verifiedAt       DateTime?
  linkedAt         DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  version          Int       @default(1)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, channel, channelAccountId, providerSubject])
  @@index([personId, status])
  @@index([tenantId, status])
}

model RoleBinding {
  id         String    @id @default(uuid())
  personId   String
  tenantId   String
  businessId String
  roleKey    String
  scopeType  String    @default("BUSINESS")
  status     String    @default("ACTIVE")
  assignedBy String?
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt  DateTime?

  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@unique([personId, businessId, roleKey])
  @@index([tenantId, businessId, status])
  @@index([personId, status])
  @@index([roleKey, status])
}

model Workspace {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  scopeType   String
  portfolioId String?
  tenantId    String?
  businessId  String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  portfolio Portfolio? @relation(fields: [portfolioId], references: [id])
  tenant    Tenant?    @relation(fields: [tenantId], references: [id])
  business  Business?  @relation(fields: [businessId], references: [id])
  projects  Project[]

  @@index([portfolioId])
  @@index([tenantId])
  @@index([businessId])
}

// @req FR-043 - direct Business owner plus Development Space context.
// @spec ADR-014, SDD-021, BR-001
model Project {
  id          String    @id @default(uuid())
  code        String    @unique
  businessId  String?
  workspaceId String
  name        String
  description String?
  type        String    @default("GENERAL")
  status      String    @default("PLANNED")
  // @req FR-087 — priority is stored, never derived. "Top 5 Priority" cannot be
  // computed from anything else here: ordering by `targetAt` is a deadline list,
  // and a deadline list under a "Priority" heading is a wrong answer the reader
  // cannot detect. Values live in `src/lib/validation/enums.js`; nullable at
  // rest because every existing row predates the column (ADR-036 D3).
  priority    String?
  // @req FR-088 — the one accountable Person (PIC). Deliberately not FR-036
  // Team membership (who *may* work here, Business-scoped) and not
  // `WorkItem.assigneeRef` (who does one piece). Nullable for the same reason,
  // and `onDelete` is left to the default: a Person who leaves must not take
  // their Projects with them (ADR-036 D4).
  picPersonId String?
  startAt     DateTime?
  targetAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)

  business           Business?           @relation(fields: [businessId], references: [id])
  workspace          Workspace           @relation(fields: [workspaceId], references: [id])
  pic                Person?             @relation("ProjectPic", fields: [picPersonId], references: [id])
  workstreams        Workstream[]
  repositories       ProjectRepository[]
  files              ProjectFile[]
  fileAssets         FileAsset[]
  milestones         Milestone[]
  gates              Gate[]
  goalLinks          ProjectGoal[]
  planImportReceipts PlanImportReceipt[]
  teams              ProjectTeam[]

  @@index([businessId])
  @@index([workspaceId])
  @@index([status])
  @@index([priority])
  @@index([picPersonId])
}

// @req FR-089 — a Team records who works together. It is an organisational
// grouping and grants nothing: `resolveViewer` never reads these models, no
// route guard consults them, and adding a Person to a Team changes no role, no
// domain grant and no visible or owned Business (BR-018, ADR-037 D1).
//
// Business-scoped for the same reason Project and Membership are (SEC-001): the
// Business is the operating unit, and a Team spanning Businesses would be a
// group whose members cannot all see the same Projects.
model Team {
  id          String    @id @default(uuid())
  code        String    @unique
  businessId  String
  name        String
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business         @relation(fields: [businessId], references: [id])
  members  TeamMembership[]
  projects ProjectTeam[]

  @@index([businessId])
}

// @req FR-089 — Person ↔ Team, deliberately separate from `Membership`. Same
// distinct-authority-layer discipline BR-016 applies to WorkspaceMembership:
// `Membership` is the authority record `resolveViewer` reads, so folding a
// grouping into it would put grouping and authority in one row — which is how a
// single unauthenticated POST minted business-owner authority on 2026-08-17.
// There is no `role` column here on purpose (ADR-037 D3, "Let Team carry a
// role" rejected): a role on a Team is authority on a Team.
model TeamMembership {
  id        String   @id @default(uuid())
  teamId    String
  personId  String
  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([teamId, personId])
  @@index([teamId])
  @@index([personId])
}

// @req FR-089 — many-to-many, because a Project is worked by several Teams and a
// Team works several Projects. One Team per Project would force a fake "primary
// team" the first time two teams share an initiative, which is the normal case
// (ADR-037 D3).
model ProjectTeam {
  id        String   @id @default(uuid())
  projectId String
  teamId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
  @@index([projectId])
  @@index([teamId])
}

model BusinessRoadmap {
  id          String    @id @default(uuid())
  businessId  String
  code        String    @unique
  title       String
  description String?
  status      String    @default("ACTIVE")
  startAt     DateTime?
  targetAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)

  business Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  horizons BusinessRoadmapHorizon[]
  goals    BusinessGoal[]

  @@index([businessId, status])
}

model BusinessRoadmapHorizon {
  id          String    @id @default(uuid())
  roadmapId   String
  key         String
  label       String
  position    Int
  description String?
  targetAt    DateTime?
  createdAt   DateTime  @default(now())

  roadmap BusinessRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  goals   BusinessGoal[]

  @@unique([roadmapId, key])
  @@unique([roadmapId, position])
  @@index([roadmapId])
}

model BusinessGoal {
  id          String    @id @default(uuid())
  businessId  String
  roadmapId   String?
  horizonId   String?
  code        String    @unique
  title       String
  description String?
  status      String    @default("PLANNED")
  priority    String    @default("MEDIUM")
  progress    Float     @default(0)
  startAt     DateTime?
  targetAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)

  business Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roadmap  BusinessRoadmap?        @relation(fields: [roadmapId], references: [id])
  horizon  BusinessRoadmapHorizon? @relation(fields: [horizonId], references: [id])
  projects ProjectGoal[]

  @@index([businessId, status])
  @@index([roadmapId])
  @@index([horizonId])
}

model ProjectGoal {
  projectId String
  goalId    String
  createdAt DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal    BusinessGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([projectId, goalId])
  @@index([goalId])
}

model Workstream {
  id                      String    @id @default(uuid())
  code                    String    @unique
  projectId               String
  name                    String
  executionMode           String
  executionModeId         String?
  // @req FR-090 — same reason as PersonCredential above: the column is live on
  // the Supabase database with a distinct value on every Workstream row, so
  // leaving it undeclared made a DROP COLUMN the diff's recommendation.
  laneId                  String?
  executionContractId     String?
  contractVersion         String?
  primaryDomainId         String?
  supportingDomainIdsJson String    @default("[]")
  technicalOwnerDomainId  String?
  identityRefsJson        String    @default("{}")
  progressStrategy        String
  progressWeight          Float     @default(1)
  status                  String    @default("PLANNED")
  progressCache           Float     @default(0)
  viewConfigJson          String    @default("{}")
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  version                 Int       @default(1)

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  containers WorkContainer[]
  items      WorkItem[]
  milestones Milestone[]
  gates      Gate[]

  @@index([projectId])
  @@index([executionMode])
  @@index([executionModeId])
  @@index([laneId])
}

// @req FR-069, FR-070 — server-owned import identity and idempotency receipt.
// One receipt binds a client idempotency key to the exact normalized payload
// and execution run. It is not a second Plan model.
model PlanImportReceipt {
  idempotencyKey          String   @id
  payloadHash             String
  executionRunId          String   @unique
  executionStepId         String?
  attemptId               String?
  stepKey                 String   @default("plan.import.commit")
  status                  String   @default("SUCCEEDED")
  correlationId           String
  schemaVersion           String
  projectId               String
  replayOfExecutionRunId  String?
  replayOfExecutionStepId String?
  auditEventId            String?
  createdAt               DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([correlationId])
  @@index([replayOfExecutionRunId])
}

model WorkContainer {
  id           String    @id @default(uuid())
  code         String    @unique
  workstreamId String
  parentId     String?
  subtype      String
  title        String
  status       String    @default("PLANNED")
  startAt      DateTime?
  targetAt     DateTime?
  metadataJson String    @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  version      Int       @default(1)

  workstream Workstream      @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  parent     WorkContainer?  @relation("ContainerHierarchy", fields: [parentId], references: [id])
  children   WorkContainer[] @relation("ContainerHierarchy")
  items      WorkItem[]

  @@index([workstreamId])
  @@index([parentId])
  @@index([subtype])
}

model WorkItem {
  id             String    @id @default(uuid())
  code           String    @unique
  workstreamId   String
  containerId    String?
  subtype        String
  title          String
  status         String    @default("PLANNED")
  assigneeRef    String?
  weight         Float     @default(1)
  numericValue   Float?
  probability    Float?
  metricDataJson String    @default("{}")
  metadataJson   String    @default("{}")
  startAt        DateTime?
  targetAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)

  workstream Workstream     @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  container  WorkContainer? @relation(fields: [containerId], references: [id])
  files      ProjectFile[]
  fileAssets FileAsset[]

  @@index([workstreamId])
  @@index([containerId])
  @@index([subtype])
  @@index([status])
}

model Milestone {
  id           String    @id @default(uuid())
  code         String    @unique
  projectId    String
  workstreamId String?
  title        String
  status       String    @default("PLANNED")
  weight       Float     @default(1)
  targetAt     DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream Workstream? @relation(fields: [workstreamId], references: [id])

  @@index([projectId])
  @@index([workstreamId])
}

model Gate {
  id           String    @id @default(uuid())
  code         String    @unique
  projectId    String
  workstreamId String?
  title        String
  status       String    @default("OPEN")
  required     Boolean   @default(true)
  evidenceJson String    @default("{}")
  targetAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream Workstream? @relation(fields: [workstreamId], references: [id])

  @@index([projectId])
  @@index([workstreamId])
}

model Dependency {
  id             String   @id @default(uuid())
  sourceType     String
  sourceId       String
  targetType     String
  targetId       String
  dependencyType String
  createdAt      DateTime @default(now())

  @@unique([sourceType, sourceId, targetType, targetId, dependencyType])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}

model Repository {
  id             String   @id @default(uuid())
  code           String   @unique
  // The owning Business. Nullable for the same reason Project.businessId was
  // (FR-043): the column is additive over rows that predate it. A Repository
  // with no Business is governed by nobody and is refused for every principal
  // (FR-073), which is why the backfill exists — see
  // scripts/backfill-repository-business.mjs.
  //
  // Business rather than Tenant or Portfolio, and that is forced rather than
  // chosen: the viewer contract carries only Business-keyed grants, so no
  // principal can hold authority above Business (SDD-037). A Tenant-scoped
  // Repository would be ungovernable — the same dead end that keeps
  // /api/scope and /api/backup/import unrepayable.
  businessId     String?
  provider       String
  externalRepoId String?
  ownerName      String?
  repoName       String?
  fullName       String?
  url            String?
  defaultBranch  String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business?           @relation(fields: [businessId], references: [id])
  projects ProjectRepository[]

  @@index([provider, fullName])
  @@index([businessId])
}

model ProjectRepository {
  id        String   @id @default(uuid())
  projectId String
  repoId    String
  role      String
  pathScope String?
  branch    String?
  createdAt DateTime @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo    Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([projectId, repoId, role])
  @@index([repoId])
}

// FR-037 — metadata/reference record for a Project document or attachment.
// Binary bytes are intentionally outside the offline MVP. `url`/`blobRef` are
// storage references, never identifiers; the record keeps its own UUID + code.
model ProjectFile {
  id         String   @id @default(uuid())
  code       String   @unique
  projectId  String
  workItemId String?
  name       String
  mime       String
  size       Int
  url        String?
  blobRef    String?
  version    Int      @default(1)
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([workItemId])
}

// @req FR-045 - device-local root for the authoritative SQLite file metadata graph.
// @spec ADR-016, SDD-023, ZV2-CR-001
model LocalWorkspaceMount {
  id         String    @id @default(uuid())
  tenantId   String
  businessId String
  deviceKey  String
  rootPath   String
  status     String    @default("ACTIVE")
  lastScanAt DateTime?
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, deviceKey])
  @@index([tenantId])
}

// @req FR-045 - authoritative, portable metadata identity for managed local files.
// @spec ADR-016, SDD-023, ZV2-CR-001
model FileAsset {
  id           String    @id @default(uuid())
  code         String    @unique
  tenantId     String
  businessId   String
  projectId    String?
  workItemId   String?
  storageKind  String
  relativePath String?
  externalUrl  String?
  blobRef      String?
  name         String
  mime         String
  size         Int
  sha256       String?
  status       String    @default("ACTIVE")
  version      Int       @default(1)
  uploadedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  business Business   @relation(fields: [businessId], references: [id])
  project  Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workItem WorkItem?  @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  links    FileLink[]

  @@index([tenantId])
  @@index([businessId])
  @@index([projectId])
  @@index([workItemId])
}

// @req FR-045 - typed secondary FileAsset relation with indexed entity lookup.
// @spec ADR-016, SDD-023, ZV2-CR-001
model FileLink {
  id           String   @id @default(uuid())
  fileId       String
  entityType   String
  entityId     String
  relationType String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  file FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, entityType, entityId, relationType])
  @@index([entityType, entityId])
}

// FR-019 — Enterprise integration: a customer's own core id mapped onto our
// internal UUID. Generalizes LegalEntityIdentifier / Repository.externalRepoId.
// An external value is NEVER a primary key and never becomes our `code`
// (code = our namespace, value = the customer's namespace).
// @req FR-021 — a channel/auth identity (a LINE user) mapped to a Person (the
// principal), tenant-scoped. Because V2 unified identity into Person (ADR-003 §D10),
// principalId is a real FK to Person — no polymorphic CUSTOMER|EMPLOYEE landmine.
// providerSubject (the lineUserId) is an attribute, never a PK (BR-002).
model ExternalIdentity {
  id              String    @id @default(uuid())
  tenantId        String
  personId        String
  provider        String // 'LINE' (later FACEBOOK | GOOGLE)
  providerSubject String // the lineUserId
  verifiedAt      DateTime?
  linkedAt        DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider, providerSubject])
  @@index([personId])
}

// FR-022 — account linking: a single-use, expiring nonce that binds a channel
// subject (a LINE user) to an EXISTING Person, instead of minting a fresh one.
// Persisted because redemption crosses a stateless webhook boundary.
model IdentityLinkToken {
  id         String    @id @default(uuid())
  tenantId   String
  personId   String
  provider   String    @default("LINE")
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([personId])
  @@index([tenantId])
}

model ExternalRef {
  id         String    @id @default(uuid())
  entityType String // PROJECT | WORKSTREAM | WORK_CONTAINER | WORK_ITEM | MILESTONE | GATE
  entityId   String // internal UUID
  system     String // "SAP" | "SALESFORCE" | "LEGACY_POS" | ...
  value      String // the customer's core id, e.g. CUST-88421
  labelAs    Boolean   @default(true) // show value as the display label
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([system, value])
  @@index([entityType, entityId])
}

// @req FR-023 — the Zuri Backend Slice's CRM core (ADR-007 P2). A Customer is a
// per-tenant CRM record linked to a Person principal (personId), so businesses in
// one tenant share the customer (the CRM-sharing decision) while the channel
// identity stays on ExternalIdentity. Soft-delete + version like other aggregates.
model Customer {
  id             String    @id @default(uuid())
  code           String    @unique
  tenantId       String
  businessId     String?
  personId       String
  displayName    String
  lifecycleStage String    @default("LEAD")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  version        Int       @default(1)

  // @req FR-103 — SEC-005 PDPA consent. Lives directly on Customer rather than a
  // separate per-business join: the FR-023 docstring above already makes this row
  // the CRM-sharing unit ("businesses in one tenant share the customer"), so a
  // second table keyed by (Customer, Business) would duplicate a scope this row
  // already carries. `consentStatus` defaults to PENDING for every new Customer;
  // `GRANDFATHERED` is the one-time backfill value for rows that predate this
  // column (see the paired migration) — it is never written by the service.
  consentStatus             String    @default("PENDING")
  consentRecordedAt         DateTime?
  consentRecordedByPersonId String?
  consentNote               String?

  tenant                Tenant                         @relation(fields: [tenantId], references: [id])
  business              Business?                      @relation(fields: [businessId], references: [id])
  person                Person                         @relation(fields: [personId], references: [id])
  consentRecordedBy     Person?                        @relation("CustomerConsentRecordedBy", fields: [consentRecordedByPersonId], references: [id])
  conversations         Conversation[]
  importProvenance      CustomerImportProvenance[]     @relation("CustomerImportProvenanceCustomer")
  importReviewDecisions CustomerImportReviewDecision[] @relation("CustomerImportReviewDecisionTargetCustomer")

  @@unique([tenantId, personId])
  @@index([businessId])
  @@index([consentStatus])
}

model CustomerImportBatch {
  id                 String   @id @default(uuid())
  contractId         String
  missionId          String
  versionId          String
  tenantId           String
  businessId         String
  sourceRef          String
  snapshotSha256     String
  sourceRowCount     Int
  publishRowCount    Int      @default(0)
  heldRowCount       Int      @default(0)
  status             String
  approvedByPersonId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant      Tenant                     @relation(fields: [tenantId], references: [id])
  business    Business                   @relation(fields: [businessId], references: [id])
  approvedBy  Person?                    @relation("CustomerImportBatchApprover", fields: [approvedByPersonId], references: [id])
  provenance  CustomerImportProvenance[]
  reviewCases CustomerImportReviewCase[]

  @@unique([contractId, missionId, versionId, snapshotSha256])
  @@index([tenantId, businessId, status])
}

model CustomerImportProvenance {
  id               String   @id @default(uuid())
  batchId          String
  sourceSystem     String
  sourceTable      String
  sourceRecordKey  String
  sourceRow        Int?
  sourceSha256     String
  snapshotSha256   String
  idempotencyKey   String   @unique
  resolutionStatus String
  matchMethod      String
  disposition      String
  personId         String?
  customerId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  batch              CustomerImportBatch            @relation(fields: [batchId], references: [id])
  person             Person?                        @relation("CustomerImportProvenancePerson", fields: [personId], references: [id])
  customer           Customer?                      @relation("CustomerImportProvenanceCustomer", fields: [customerId], references: [id])
  reviewCase         CustomerImportReviewCase?      @relation(fields: [reviewCaseId], references: [id])
  reviewDecisions    CustomerImportReviewDecision[]
  reviewCaseId       String?
  reviewReasonCode   String?
  reviewEvidenceJson String?

  @@unique([sourceSystem, sourceTable, sourceRecordKey, snapshotSha256])
  @@index([batchId, resolutionStatus, disposition])
  @@index([personId, customerId])
  @@index([reviewCaseId])
}

model CustomerImportReviewCase {
  id                  String   @id @default(uuid())
  batchId             String
  tenantId            String
  businessId          String
  reasonCode          String
  groupFingerprint    String
  status              String   @default("OPEN")
  itemCount           Int      @default(0)
  evidenceSummaryJson String   @default("{}")
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  batch     CustomerImportBatch            @relation(fields: [batchId], references: [id])
  tenant    Tenant                         @relation(fields: [tenantId], references: [id])
  business  Business                       @relation(fields: [businessId], references: [id])
  items     CustomerImportProvenance[]
  decisions CustomerImportReviewDecision[]

  @@unique([batchId, groupFingerprint])
  @@index([tenantId, businessId, status])
}

model CustomerImportReviewDecision {
  id                String   @id @default(uuid())
  reviewCaseId      String
  provenanceId      String
  decisionVersion   Int      @default(1)
  action            String
  targetCustomerId  String?
  decidedByPersonId String
  decidedAt         DateTime @default(now())
  note              String?
  createdAt         DateTime @default(now())

  reviewCase     CustomerImportReviewCase @relation(fields: [reviewCaseId], references: [id])
  provenance     CustomerImportProvenance @relation(fields: [provenanceId], references: [id])
  targetCustomer Customer?                @relation("CustomerImportReviewDecisionTargetCustomer", fields: [targetCustomerId], references: [id])
  decidedBy      Person                   @relation("CustomerImportReviewDecisionActor", fields: [decidedByPersonId], references: [id])

  @@unique([provenanceId, decisionVersion])
  @@index([reviewCaseId, provenanceId, decisionVersion])
  @@index([targetCustomerId])
}

model Conversation {
  id               String   @id @default(uuid())
  tenantId         String
  businessId       String?
  customerId       String
  channel          String // LINE | FACEBOOK | WEB
  externalThreadId String
  status           String   @default("OPEN")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]

  // @spec BR-002, SEC-001 — a provider thread id is envelope data, not a key. Scoping
  // it by tenant and channel is what makes the external namespace tenant-partitioned:
  // a global unique let one tenant's thread id resolve another tenant's conversation.
  @@unique([tenantId, channel, externalThreadId])
  @@index([customerId])
  @@index([tenantId])
}

model Message {
  id                String   @id @default(uuid())
  conversationId    String
  direction         String // INBOUND | OUTBOUND
  body              String
  externalMessageId String?
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // @spec BR-002, SEC-001 — scoped to the conversation that owns the message rather
  // than to a tenant column: a Message has no tenant of its own, and denormalising one
  // would create a second copy of the truth that could drift from its Conversation.
  // The conversation is already tenant-scoped, so isolation follows and cannot drift.
  // NULL stays non-conflicting in both engines, so unkeyed outbound messages are free.
  @@unique([conversationId, externalMessageId])
  @@index([conversationId])
}

model AuditEvent {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      String
  payloadJson String   @default("{}")
  actorType   String   @default("LOCAL_USER")
  actorId     String?
  occurredAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([occurredAt])
}

// @req FR-071 — server-owned full data-pipeline execution ledger.
// @spec ADR-030 D2-D6, SDD-042, SEC-003, SEC-008
// @tested tests/unit/platform/pipeline-tracking-service.test.js, tests/unit/platform/pipeline-tracking-migration.test.js
model PipelineRun {
  id                       String    @id @default(uuid())
  executionRunId           String    @unique
  dataPipelineDefinitionId String
  executionContractId      String
  tenantId                 String
  businessId               String?
  status                   String    @default("QUEUED")
  currentStageId           String?
  sourceRef                String?
  sourceSha256             String?
  artifactRef              String?
  artifactSha256           String?
  bootstrapBatchId         String?
  correlationId            String
  idempotencyKey           String    @unique
  requestHash              String
  expectedCount            Int       @default(0)
  actualCount              Int       @default(0)
  insertedCount            Int       @default(0)
  updatedCount             Int       @default(0)
  unchangedCount           Int       @default(0)
  failedCount              Int       @default(0)
  rejectedCount            Int       @default(0)
  duplicateCount           Int       @default(0)
  tagIdsJson               String    @default("[]")
  identityRefsJson         String    @default("{}")
  primaryFailureCode       String?
  primaryErrorRef          String?
  primaryRetryable         Boolean?
  auditEventId             String?
  replayScope              String?
  replayOfExecutionRunId   String?
  replayOfExecutionStepId  String?
  replayOfPipelineRecordId String?
  startedAt                DateTime?
  finishedAt               DateTime?
  lastHeartbeatAt          DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business        Business?                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  steps           PipelineStep[]
  eventReceipts   PipelineEventReceipt[]   @relation("PipelineRunEventReceipts")
  recordEvents    PipelineRecordEvent[]    @relation("PipelineRunRecordEvents")
  reconciliations PipelineReconciliation[] @relation("PipelineRunReconciliations")
  gateDecisions   PipelineGateDecision[]   @relation("PipelineRunGateDecisions")

  @@index([tenantId, status])
  @@index([businessId, status, createdAt])
  @@index([correlationId])
  @@index([replayOfExecutionRunId])
}

model PipelineStep {
  id                      String    @id @default(uuid())
  executionStepId         String    @unique
  runId                   String
  pipelineStageId         String
  sequence                Int
  attemptId               String    @unique
  status                  String    @default("NOT_STARTED")
  inputHash               String?
  outputHash              String?
  expectedCount           Int       @default(0)
  actualCount             Int       @default(0)
  insertedCount           Int       @default(0)
  updatedCount            Int       @default(0)
  unchangedCount          Int       @default(0)
  failedCount             Int       @default(0)
  skippedCount            Int       @default(0)
  failureCode             String?
  errorRef                String?
  retryable               Boolean?
  tagIdsJson              String    @default("[]")
  identityRefsJson        String    @default("{}")
  auditEventId            String?
  replayOfExecutionStepId String?
  startedAt               DateTime?
  finishedAt              DateTime?
  lastHeartbeatAt         DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  run             PipelineRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  recordEvents    PipelineRecordEvent[]    @relation("PipelineStepRecordEvents")
  reconciliations PipelineReconciliation[] @relation("PipelineStepReconciliations")

  @@index([runId, pipelineStageId, sequence])
  @@index([runId, status])
}

model PipelineEventReceipt {
  id             String   @id @default(uuid())
  runId          String
  idempotencyKey String   @unique
  eventType      String
  eventHash      String
  resultJson     String   @default("{}")
  auditEventId   String?
  createdAt      DateTime @default(now())

  run PipelineRun @relation("PipelineRunEventReceipts", fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, eventType])
}

model PipelineRecordEvent {
  id                       String   @id @default(uuid())
  runId                    String
  stepId                   String?
  attemptId                String
  pipelineRecordId         String
  sourceRecordKey          String?
  sourceRowNumber          Int?
  sourceSha256             String?
  docId                    String?
  picId                    String?
  factId                   String?
  sourceDocIdsJson         String   @default("[]")
  sourcePicIdsJson         String   @default("[]")
  destinationRecordId      String?
  status                   String
  failureCode              String?
  errorRef                 String?
  retryable                Boolean?
  tagIdsJson               String   @default("[]")
  identityRefsJson         String   @default("{}")
  idempotencyKey           String   @unique
  auditEventId             String?
  replayOfPipelineRecordId String?
  occurredAt               DateTime @default(now())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  run  PipelineRun   @relation("PipelineRunRecordEvents", fields: [runId], references: [id], onDelete: Cascade)
  step PipelineStep? @relation("PipelineStepRecordEvents", fields: [stepId], references: [id], onDelete: SetNull)

  @@index([runId, status])
  @@index([pipelineRecordId])
  @@index([docId])
  @@index([picId])
  @@index([factId])
}

model PipelineReconciliation {
  id              String   @id @default(uuid())
  runId           String
  stepId          String?
  expectedCount   Int      @default(0)
  actualCount     Int      @default(0)
  insertedCount   Int      @default(0)
  updatedCount    Int      @default(0)
  unchangedCount  Int      @default(0)
  rejectedCount   Int      @default(0)
  duplicateCount  Int      @default(0)
  sourceSha256    String?
  artifactSha256  String?
  stagingHash     String?
  destinationHash String?
  rlsProbeResult  String?
  isolationResult String?
  result          String
  evidenceJson    String   @default("{}")
  auditEventId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  run  PipelineRun   @relation("PipelineRunReconciliations", fields: [runId], references: [id], onDelete: Cascade)
  step PipelineStep? @relation("PipelineStepReconciliations", fields: [stepId], references: [id], onDelete: SetNull)

  @@index([runId, result])
  @@index([stepId])
}

model PipelineGateDecision {
  id                String   @id @default(uuid())
  runId             String
  gateId            String?
  status            String
  required          Boolean  @default(true)
  decidedByPersonId String?
  reason            String?
  evidenceJson      String   @default("{}")
  auditEventId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  run PipelineRun @relation("PipelineRunGateDecisions", fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([gateId])
}

// @req FR-079 — provider-neutral Business-scoped runtime connection metadata.
// @spec ADR-031 §D2/D3, SDD-043, SEC-015 — opaque secret references only;
// the production partial active-primary invariant is an additive Postgres DDL gate.
// @tested tests/unit/fr079-schema-contract.test.js
model IntegrationProvider {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  status           String   @default("ACTIVE")
  capabilitiesJson String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  version          Int      @default(1)

  connections IntegrationConnection[]
}

model IntegrationConnection {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String?
  providerId        String
  name              String
  authorizationType String    @default("SECRET_MANAGER")
  externalAccountId String?
  purpose           String    @default("GENERAL")
  role              String    @default("SECONDARY")
  status            String    @default("DRAFT")
  metadataJson      String    @default("{}")
  lastSyncAt        DateTime?
  lastSuccessAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  version           Int       @default(1)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  business      Business?              @relation(fields: [businessId], references: [id])
  provider      IntegrationProvider    @relation(fields: [providerId], references: [id])
  credential    IntegrationCredential?
  ingestionRuns IngestionRun[]
  rawRecords    RawExternalRecord[]
  cursors       SyncCursor[]
  externalRefs  ExternalEntityRef[]
  deadLetters   DeadLetterRecord[]

  @@unique([tenantId, providerId, externalAccountId])
  @@index([tenantId, businessId, purpose, status, role])
}

model IntegrationCredential {
  id                    String    @id @default(uuid())
  connectionId          String    @unique
  secretRef             String
  status                String    @default("ACTIVE")
  expiresAt             DateTime?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  rotatedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  version               Int       @default(1)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model IngestionRun {
  id             String    @id @default(uuid())
  tenantId       String
  businessId     String?
  connectionId   String
  lane           String
  resourceType   String
  runType        String    @default("INCREMENTAL")
  status         String    @default("RUNNING")
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  fetchedCount   Int       @default(0)
  createdCount   Int       @default(0)
  updatedCount   Int       @default(0)
  unchangedCount Int       @default(0)
  failedCount    Int       @default(0)
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  business    Business?             @relation(fields: [businessId], references: [id])
  connection  IntegrationConnection @relation(fields: [connectionId], references: [id])
  rawRecords  RawExternalRecord[]
  deadLetters DeadLetterRecord[]

  @@index([tenantId, status])
  @@index([businessId])
  @@index([connectionId, resourceType])
  @@index([startedAt])
}

model RawExternalRecord {
  id               String    @id @default(uuid())
  tenantId         String
  businessId       String?
  connectionId     String
  ingestionRunId   String?
  provider         String
  lane             String
  entityType       String
  externalId       String
  sourceType       String
  sourceUri        String?
  schemaVersion    String
  payloadJson      String
  payloadHash      String
  idempotencyKey   String    @unique
  // FR-109 AC-109.3 — the id a downstream knowledge-ingestion run carries as
  // `artifactRef`/`identityRefs.artifactIds`. Nullable: most raw records are
  // never fed into knowledge ingestion, and the two ids are assigned by
  // different callers at different times (this row is written by FR-081's own
  // ingestion path; the artifact id is minted by whoever builds the FR-109
  // run input). Not @unique — a caller that never sets it must be able to
  // insert more than one such row.
  artifactId       String?
  receivedAt       DateTime
  processingStatus String    @default("RECEIVED")
  processingError  String?
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  business     Business?             @relation(fields: [businessId], references: [id])
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id])
  ingestionRun IngestionRun?         @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)
  deadLetters  DeadLetterRecord[]

  @@index([tenantId, entityType])
  @@index([businessId])
  @@index([connectionId, entityType, externalId])
  @@index([ingestionRunId])
  @@index([processingStatus])
  @@index([artifactId])
}

model SyncCursor {
  id            String    @id @default(uuid())
  tenantId      String
  businessId    String?
  connectionId  String
  resourceType  String
  strategy      String
  cursorValue   String?
  watermarkAt   DateTime?
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  business   Business?             @relation(fields: [businessId], references: [id])
  connection IntegrationConnection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, resourceType])
  @@index([tenantId, resourceType])
  @@index([businessId])
}

model ExternalEntityRef {
  id                 String    @id @default(uuid())
  tenantId           String
  businessId         String?
  connectionId       String
  provider           String
  entityType         String
  externalId         String
  internalEntityType String?
  internalEntityId   String?
  externalCode       String?
  documentNumber     String?
  payloadHash        String?
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  business   Business?             @relation(fields: [businessId], references: [id])
  connection IntegrationConnection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, entityType, externalId])
  @@index([tenantId, entityType])
  @@index([businessId])
  @@index([internalEntityType, internalEntityId])
}

model DeadLetterRecord {
  id             String    @id @default(uuid())
  tenantId       String
  businessId     String?
  connectionId   String
  ingestionRunId String?
  rawRecordId    String?
  lane           String
  entityType     String
  externalId     String
  failureStage   String
  failureOwner   String
  errorCode      String
  errorMessage   String
  retryCount     Int       @default(0)
  status         String    @default("OPEN")
  nextRetryAt    DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  business     Business?             @relation(fields: [businessId], references: [id])
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id])
  ingestionRun IngestionRun?         @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)
  rawRecord    RawExternalRecord?    @relation(fields: [rawRecordId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([businessId])
  @@index([connectionId, status])
  @@index([ingestionRunId])
  @@index([rawRecordId])
}

// @req FR-092 — provider-neutral translated market evidence owned by Market Intelligence.
// @spec SDD-049, BR-019, SEC-017 — scalar provenance refs preserve the Integration boundary;
// unique lineage serializes concurrent replay without making Market own the source records.
model MarketObservation {
  id                       String   @id @default(uuid())
  tenantId                 String
  businessId               String?
  rawRecordId              String
  connectionId             String
  provider                 String
  sourceEntityType         String
  externalId               String
  sourcePayloadHash        String
  sourceUri                String?
  translationSchemaVersion String
  observationType          String
  candidateJson            String
  canonicalProductRef      String?
  canonicalCategoryRef     String?
  resolutionStatus         String
  resolutionConfidence     Float?
  observedAt               DateTime
  translatedAt             DateTime
  createdAt                DateTime @default(now())
  lineageKey               String   @unique

  @@index([tenantId, businessId, observedAt])
  @@index([tenantId, connectionId, provider])
  @@index([rawRecordId])
  @@index([canonicalProductRef])
}

// @req FR-096 — the SoT pipeline's generic human-decision queue: the data plane
// submits pending facts, a human decides in the browser, the data plane pulls
// decided rows by cursor and applies them to its own stores (ADR-043 interim).
// @spec FR-096, BR-002, SEC-002
// @tested tests/unit/sot-decision-service.test.js
model SotDecision {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String?
  decisionType      String
  subjectRef        String
  phaseId           String?
  payloadJson       String    @default("{}")
  payloadSha256     String
  decisionVersion   Int       @default(1)
  status            String    @default("PENDING")
  submittedBy       String?
  decidedByPersonId String?
  reason            String?
  auditEventId      String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([tenantId, decisionType, subjectRef, decisionVersion])
  @@index([tenantId, status, decisionType])
  @@index([businessId, status])
  @@index([phaseId, status])
  @@index([updatedAt])
}

// @req FR-102 — a bearer credential scoped to exactly one Tenant lets the SoT
// pipeline's external data plane authenticate to the FR-100 decision
// submit/export endpoints without a browser session and without a Person
// identity. The raw secret exists only at mint time; only its SHA-256 hash is
// ever persisted, and a revoked key is refused immediately (no session grace
// period, unlike Session — a leaked non-interactive credential has no user to
// notice and log out).
// @spec ADR-047, SEC-019
// @tested tests/unit/sot-data-plane-auth.test.js
model SotDataPlaneKey {
  id           String    @id @default(uuid())
  label        String
  tenantId     String
  keyHash      String    @unique
  keyPrefix    String
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokeReason String?
  lastUsedAt   DateTime?
  version      Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// @req FR-106 — a bearer credential scoped to exactly one Tenant lets an
// enterprise integrator authenticate to the FR-019 Enterprise API
// (dry-run/commit/resolve) without a browser session, generalizing the FR-102
// SotDataPlaneKey pattern per ADR-047 D3's named follow-up rather than
// inventing a second mechanism. The raw secret exists only at mint time; only
// its SHA-256 hash is ever persisted, it is never readable back, and a revoked
// key is refused on the next request (no grace period — a leaked
// non-interactive credential has no user to notice and log out).
// @spec SEC-006, SEC-001, BR-002, ADR-047
// @tested tests/unit/api-access-auth.test.js
model ApiAccessKey {
  id           String    @id @default(uuid())
  label        String
  tenantId     String
  keyHash      String    @unique
  keyPrefix    String
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokeReason String?
  lastUsedAt   DateTime?
  version      Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}
