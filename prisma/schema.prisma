// Zuri v2 Lab — local MVP schema.
// SQLite-compatible strategy: persisted enums are strings (see src/lib/validation/enums.js).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Portfolio {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  tenants       Tenant[]
  legalEntities LegalEntity[]
  workspaces    Workspace[]
}

model Tenant {
  id          String   @id @default(uuid())
  code        String   @unique
  portfolioId String
  name        String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  portfolio          Portfolio           @relation(fields: [portfolioId], references: [id])
  businesses         Business[]
  workspaces         Workspace[]
  memberships        Membership[]
  externalIdentities ExternalIdentity[]
  identityLinkTokens IdentityLinkToken[]
  customers          Customer[]
  roleBindings         RoleBinding[]
  localWorkspaceMounts LocalWorkspaceMount[]
  fileAssets           FileAsset[]
  integrationConnections IntegrationConnection[]

  @@index([portfolioId])
}

model LegalEntity {
  id          String   @id @default(uuid())
  code        String   @unique
  portfolioId String
  legalName   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolio   Portfolio               @relation(fields: [portfolioId], references: [id])
  identifiers LegalEntityIdentifier[]
  businesses  Business[]

  @@index([portfolioId])
}

model LegalEntityIdentifier {
  id            String    @id @default(uuid())
  legalEntityId String
  country       String    @default("TH")
  type          String
  value         String
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([country, type, value])
  @@index([legalEntityId])
}

model Business {
  id            String   @id @default(uuid())
  code          String   @unique
  tenantId      String
  legalEntityId String?
  name          String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  version       Int      @default(1)

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  legalEntity LegalEntity?      @relation(fields: [legalEntityId], references: [id])
  branches    Branch[]
  workspaces  Workspace[]
  memberships Membership[]
  customers   Customer[]
  roleBindings         RoleBinding[]
  roadmaps    BusinessRoadmap[]
  goals       BusinessGoal[]
  projects    Project[]
  localWorkspaceMounts LocalWorkspaceMount[]
  fileAssets           FileAsset[]
  integrationConnections IntegrationConnection[]

  @@index([tenantId])
}

model Branch {
  id         String   @id @default(uuid())
  code       String   @unique
  tenantId   String
  businessId String
  name       String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  memberships Membership[]

  @@index([tenantId])
  @@index([businessId])
}

model Person {
  id          String   @id @default(uuid())
  code        String   @unique
  displayName String
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships        Membership[]
  externalIdentities ExternalIdentity[]
  identityLinkTokens IdentityLinkToken[]
  customers          Customer[]
  roleBindings         RoleBinding[]
}

model Membership {
  id             String   @id @default(uuid())
  personId       String
  tenantId       String
  businessId     String?
  branchId       String?
  employeeRef    String?
  role           String   @default("OWNER")
  domainKeysJson String   @default("[]")
  createdAt      DateTime @default(now())

  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])

  @@index([personId])
  @@index([tenantId])
}

model RoleBinding {
  id         String   @id @default(uuid())
  personId   String
  tenantId   String
  businessId String
  roleKey    String
  scopeType  String   @default("BUSINESS")
  status     String   @default("ACTIVE")
  assignedBy String?
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  revokedAt  DateTime?

  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@unique([personId, businessId, roleKey])
  @@index([tenantId, businessId, status])
  @@index([personId, status])
  @@index([roleKey, status])
}

model Workspace {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  scopeType   String
  portfolioId String?
  tenantId    String?
  businessId  String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  portfolio Portfolio? @relation(fields: [portfolioId], references: [id])
  tenant    Tenant?    @relation(fields: [tenantId], references: [id])
  business  Business?  @relation(fields: [businessId], references: [id])
  projects  Project[]

  @@index([portfolioId])
  @@index([tenantId])
  @@index([businessId])
}

// @req FR-043 - direct Business owner plus Development Space context.
// @spec ADR-014, SDD-021, BR-001
model Project {
  id          String    @id @default(uuid())
  code        String    @unique
  businessId  String?
  workspaceId String
  name        String
  description String?
  type        String    @default("GENERAL")
  status      String    @default("PLANNED")
  startAt     DateTime?
  targetAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)

  business     Business?           @relation(fields: [businessId], references: [id])
  workspace    Workspace           @relation(fields: [workspaceId], references: [id])
  workstreams  Workstream[]
  repositories ProjectRepository[]
  files        ProjectFile[]
  fileAssets   FileAsset[]
  milestones   Milestone[]
  gates        Gate[]
  goalLinks    ProjectGoal[]

  @@index([businessId])
  @@index([workspaceId])
  @@index([status])
}

model BusinessRoadmap {
  id          String    @id @default(uuid())
  businessId  String
  code        String    @unique
  title       String
  description String?
  status      String    @default("ACTIVE")
  startAt     DateTime?
  targetAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)

  business Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  horizons BusinessRoadmapHorizon[]
  goals    BusinessGoal[]

  @@index([businessId, status])
}

model BusinessRoadmapHorizon {
  id          String    @id @default(uuid())
  roadmapId   String
  key         String
  label       String
  position    Int
  description String?
  targetAt    DateTime?
  createdAt   DateTime  @default(now())

  roadmap BusinessRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  goals   BusinessGoal[]

  @@unique([roadmapId, key])
  @@unique([roadmapId, position])
  @@index([roadmapId])
}

model BusinessGoal {
  id          String    @id @default(uuid())
  businessId  String
  roadmapId   String?
  horizonId   String?
  code        String    @unique
  title       String
  description String?
  status      String    @default("PLANNED")
  priority    String    @default("MEDIUM")
  progress    Float     @default(0)
  startAt     DateTime?
  targetAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)

  business Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roadmap  BusinessRoadmap?        @relation(fields: [roadmapId], references: [id])
  horizon  BusinessRoadmapHorizon? @relation(fields: [horizonId], references: [id])
  projects ProjectGoal[]

  @@index([businessId, status])
  @@index([roadmapId])
  @@index([horizonId])
}

model ProjectGoal {
  projectId String
  goalId    String
  createdAt DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal    BusinessGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([projectId, goalId])
  @@index([goalId])
}

model Workstream {
  id               String    @id @default(uuid())
  code             String    @unique
  projectId        String
  name             String
  executionMode    String
  progressStrategy String
  progressWeight   Float     @default(1)
  status           String    @default("PLANNED")
  progressCache    Float     @default(0)
  viewConfigJson   String    @default("{}")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  version          Int       @default(1)

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  containers WorkContainer[]
  items      WorkItem[]
  milestones Milestone[]
  gates      Gate[]

  @@index([projectId])
  @@index([executionMode])
}

model WorkContainer {
  id           String    @id @default(uuid())
  code         String    @unique
  workstreamId String
  parentId     String?
  subtype      String
  title        String
  status       String    @default("PLANNED")
  startAt      DateTime?
  targetAt     DateTime?
  metadataJson String    @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  version      Int       @default(1)

  workstream Workstream      @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  parent     WorkContainer?  @relation("ContainerHierarchy", fields: [parentId], references: [id])
  children   WorkContainer[] @relation("ContainerHierarchy")
  items      WorkItem[]

  @@index([workstreamId])
  @@index([parentId])
  @@index([subtype])
}

model WorkItem {
  id             String    @id @default(uuid())
  code           String    @unique
  workstreamId   String
  containerId    String?
  subtype        String
  title          String
  status         String    @default("PLANNED")
  assigneeRef    String?
  weight         Float     @default(1)
  numericValue   Float?
  probability    Float?
  metricDataJson String    @default("{}")
  metadataJson   String    @default("{}")
  startAt        DateTime?
  targetAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)

  workstream Workstream     @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  container  WorkContainer? @relation(fields: [containerId], references: [id])
  files      ProjectFile[]
  fileAssets FileAsset[]

  @@index([workstreamId])
  @@index([containerId])
  @@index([subtype])
  @@index([status])
}

model Milestone {
  id           String    @id @default(uuid())
  code         String    @unique
  projectId    String
  workstreamId String?
  title        String
  status       String    @default("PLANNED")
  weight       Float     @default(1)
  targetAt     DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream Workstream? @relation(fields: [workstreamId], references: [id])

  @@index([projectId])
  @@index([workstreamId])
}

model Gate {
  id           String    @id @default(uuid())
  code         String    @unique
  projectId    String
  workstreamId String?
  title        String
  status       String    @default("OPEN")
  required     Boolean   @default(true)
  evidenceJson String    @default("{}")
  targetAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream Workstream? @relation(fields: [workstreamId], references: [id])

  @@index([projectId])
  @@index([workstreamId])
}

model Dependency {
  id             String   @id @default(uuid())
  sourceType     String
  sourceId       String
  targetType     String
  targetId       String
  dependencyType String
  createdAt      DateTime @default(now())

  @@unique([sourceType, sourceId, targetType, targetId, dependencyType])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}

model Repository {
  id             String   @id @default(uuid())
  code           String   @unique
  provider       String
  externalRepoId String?
  ownerName      String?
  repoName       String?
  fullName       String?
  url            String?
  defaultBranch  String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projects ProjectRepository[]

  @@index([provider, fullName])
}

model ProjectRepository {
  id        String   @id @default(uuid())
  projectId String
  repoId    String
  role      String
  pathScope String?
  branch    String?
  createdAt DateTime @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo    Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([projectId, repoId, role])
  @@index([repoId])
}

// FR-037 — metadata/reference record for a Project document or attachment.
// Binary bytes are intentionally outside the offline MVP. `url`/`blobRef` are
// storage references, never identifiers; the record keeps its own UUID + code.
model ProjectFile {
  id         String   @id @default(uuid())
  code       String   @unique
  projectId  String
  workItemId String?
  name       String
  mime       String
  size       Int
  url        String?
  blobRef    String?
  version    Int      @default(1)
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([workItemId])
}

// @req FR-045 - device-local root for the authoritative SQLite file metadata graph.
// @spec ADR-016, SDD-023, ZV2-CR-001
model LocalWorkspaceMount {
  id         String    @id @default(uuid())
  tenantId   String
  businessId String
  deviceKey  String
  rootPath   String
  status     String    @default("ACTIVE")
  lastScanAt DateTime?
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, deviceKey])
  @@index([tenantId])
}

// @req FR-045 - authoritative, portable metadata identity for managed local files.
// @spec ADR-016, SDD-023, ZV2-CR-001
model FileAsset {
  id           String    @id @default(uuid())
  code         String    @unique
  tenantId     String
  businessId   String
  projectId    String?
  workItemId   String?
  storageKind  String
  relativePath String?
  externalUrl  String?
  blobRef      String?
  name         String
  mime         String
  size         Int
  sha256       String?
  status       String    @default("ACTIVE")
  version      Int       @default(1)
  uploadedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  business Business  @relation(fields: [businessId], references: [id])
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  links    FileLink[]

  @@index([tenantId])
  @@index([businessId])
  @@index([projectId])
  @@index([workItemId])
}

// @req FR-045 - typed secondary FileAsset relation with indexed entity lookup.
// @spec ADR-016, SDD-023, ZV2-CR-001
model FileLink {
  id           String   @id @default(uuid())
  fileId       String
  entityType   String
  entityId     String
  relationType String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  file FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, entityType, entityId, relationType])
  @@index([entityType, entityId])
}

// FR-019 — Enterprise integration: a customer's own core id mapped onto our
// internal UUID. Generalizes LegalEntityIdentifier / Repository.externalRepoId.
// An external value is NEVER a primary key and never becomes our `code`
// (code = our namespace, value = the customer's namespace).
// @req FR-021 — a channel/auth identity (a LINE user) mapped to a Person (the
// principal), tenant-scoped. Because V2 unified identity into Person (ADR-003 §D10),
// principalId is a real FK to Person — no polymorphic CUSTOMER|EMPLOYEE landmine.
// providerSubject (the lineUserId) is an attribute, never a PK (BR-002).
model ExternalIdentity {
  id              String    @id @default(uuid())
  tenantId        String
  personId        String
  provider        String // 'LINE' (later FACEBOOK | GOOGLE)
  providerSubject String // the lineUserId
  verifiedAt      DateTime?
  linkedAt        DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider, providerSubject])
  @@index([personId])
}

// FR-022 — account linking: a single-use, expiring nonce that binds a channel
// subject (a LINE user) to an EXISTING Person, instead of minting a fresh one.
// Persisted because redemption crosses a stateless webhook boundary.
model IdentityLinkToken {
  id         String    @id @default(uuid())
  tenantId   String
  personId   String
  provider   String    @default("LINE")
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([personId])
  @@index([tenantId])
}

model ExternalRef {
  id         String    @id @default(uuid())
  entityType String // PROJECT | WORKSTREAM | WORK_CONTAINER | WORK_ITEM | MILESTONE | GATE
  entityId   String // internal UUID
  system     String // "SAP" | "SALESFORCE" | "LEGACY_POS" | ...
  value      String // the customer's core id, e.g. CUST-88421
  labelAs    Boolean   @default(true) // show value as the display label
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([system, value])
  @@index([entityType, entityId])
}

// @req FR-023 — the Zuri Backend Slice's CRM core (ADR-007 P2). A Customer is a
// per-tenant CRM record linked to a Person principal (personId), so businesses in
// one tenant share the customer (the CRM-sharing decision) while the channel
// identity stays on ExternalIdentity. Soft-delete + version like other aggregates.
model Customer {
  id             String    @id @default(uuid())
  code           String    @unique
  tenantId       String
  businessId     String?
  personId       String
  displayName    String
  lifecycleStage String    @default("LEAD")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  version        Int       @default(1)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  business      Business?      @relation(fields: [businessId], references: [id])
  person        Person         @relation(fields: [personId], references: [id])
  conversations Conversation[]

  @@unique([tenantId, personId])
  @@index([businessId])
}

model Conversation {
  id               String   @id @default(uuid())
  tenantId         String
  businessId       String?
  customerId       String
  channel          String // LINE | FACEBOOK | WEB
  externalThreadId String   @unique
  status           String   @default("OPEN")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([customerId])
  @@index([tenantId])
}

model Message {
  id                String   @id @default(uuid())
  conversationId    String
  direction         String // INBOUND | OUTBOUND
  body              String
  externalMessageId String?  @unique
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AuditEvent {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      String
  payloadJson String   @default("{}")
  actorType   String   @default("LOCAL_USER")
  actorId     String?
  occurredAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([occurredAt])
}

// @req FR-074 — provider-neutral Business-scoped runtime connection metadata.
// @spec ADR-031 §D2/D3, SDD-043, SEC-015 — opaque secret references only;
// the production partial active-primary invariant is an additive Postgres DDL gate.
// @tested tests/unit/fr074-schema-contract.test.js
model IntegrationProvider {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  status         String   @default("ACTIVE")
  capabilitiesJson String @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  version        Int      @default(1)

  connections IntegrationConnection[]
}

model IntegrationConnection {
  id                String   @id @default(uuid())
  tenantId          String
  businessId        String?
  providerId        String
  name              String
  authorizationType String   @default("SECRET_MANAGER")
  externalAccountId String?
  purpose           String   @default("GENERAL")
  role              String   @default("SECONDARY")
  status            String   @default("DRAFT")
  metadataJson      String   @default("{}")
  lastSyncAt        DateTime?
  lastSuccessAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  version           Int      @default(1)

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  business   Business?           @relation(fields: [businessId], references: [id])
  provider   IntegrationProvider @relation(fields: [providerId], references: [id])
  credential IntegrationCredential?

  @@unique([tenantId, providerId, externalAccountId])
  @@index([tenantId, businessId, purpose, status, role])
}

model IntegrationCredential {
  id         String   @id @default(uuid())
  connectionId String @unique
  secretRef  String
  status     String   @default("ACTIVE")
  expiresAt  DateTime?
  rotatedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  version    Int      @default(1)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}
