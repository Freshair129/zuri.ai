# zuri-ai — environment template (no secrets here). Copy to .env and fill in.
#
# One file serves three readers:
#   npm run dev          — Next.js loads .env (SQLite is fine here)
#   docker compose       — interpolates ${...} in docker-compose.yml from .env AND
#                          passes .env into the `web` container as its env_file
#   .env.docker          — OPTIONAL container-only overrides (e.g. a Postgres
#                          DATABASE_URL while .env keeps SQLite for `npm run dev`);
#                          same format, applied after .env, never committed.
# Never commit .env or .env.docker (.gitignore: .env*). See docs/deployment/docker-ngrok.md.

# =============================================================================
# Application
# =============================================================================
# `docker compose` forces NODE_ENV=production inside the container. Local dev
# leaves it unset (Next decides).
# NODE_ENV=production

# Session signing key — random, >= 32 characters. Required to start; a session
# cookie signed with a different key is simply invalid after a rotation.
ZURI_SESSION_SECRET=""

# =============================================================================
# Public URL (ADR-058 / FR-142 — src/lib/public-base-url.js)
# =============================================================================
# The ONE public origin this deployment is reached at. Development: the dev server.
# Docker + ngrok: https://<NGROK_DOMAIN>. When left empty docker-compose.yml derives
# https://${NGROK_DOMAIN} automatically; without a static domain set it to the
# temporary URL ngrok assigned (scripts/ngrok-url.ps1 prints it).
PUBLIC_BASE_URL="http://localhost:3100"
# Build-time alias read by the root layout (metadataBase); PUBLIC_BASE_URL wins at run time.
# NEXT_PUBLIC_APP_URL="http://localhost:3100"

# =============================================================================
# Docker Compose (ignored by npm run dev)
# =============================================================================
# Host port the app is published on (loopback only by default — ngrok is the public path).
WEB_PORT=3000
# Bind to 0.0.0.0 to also reach the container from the LAN. Default: 127.0.0.1.
# WEB_BIND_ADDRESS=127.0.0.1
# Host loopback port for ngrok's inspection UI/API (http://127.0.0.1:4040).
# NGROK_INSPECT_PORT=4040
# Registry tags for a pulled (not built) image — a later VPS sets these to the
# ghcr.io tags .github/workflows/docker-image.yml publishes.
# ZURI_WEB_IMAGE=ghcr.io/<owner>/<repo>:latest
# ZURI_TOOLS_IMAGE=zuri-ai-tools:local
# Start the bundled Postgres + schema push (`db`, `db-migrate`) with the stack.
# Leave unset when DATABASE_URL points at Supabase or another external Postgres.
# COMPOSE_PROFILES=local-db

# =============================================================================
# ngrok (public HTTPS ingress) — https://dashboard.ngrok.com
# =============================================================================
# Required. Never hardcoded anywhere else; passed to the ngrok container only.
NGROK_AUTHTOKEN=""
# Static / assigned domain (free tier includes one). With it the public URL — and the
# LINE webhook URL https://<NGROK_DOMAIN>/api/agent/line-webhook — survives restarts.
# Empty = temporary URL that changes on every start (fallback mode).
NGROK_DOMAIN=""

# =============================================================================
# Database
# =============================================================================
# Dev/test: SQLite (offline-first lab default). `npm run dev` uses this.
DATABASE_URL="file:./dev.db"
#
# Docker / production: MUST be Postgres — production mode refuses SQLite
# (src/lib/db.js: PRODUCTION_DATABASE_URL_REQUIRED). Put the Postgres URL in
# .env.docker so this file can keep SQLite for local development, or set it here
# if this checkout is deployment-only.
#
# A Supabase pooler URL (below) is normalized to the correct Supavisor MODE
# automatically (FR-145, ADR-058 D9) — session pooling for this long-running
# Docker deployment, transaction pooling only when Vercel's own `VERCEL` env
# var is present. Session mode measured ~5x faster per query on the same host
# (2026-09-04: ~130-145ms vs ~650-750ms, warm pool, no operator action needed).
# ZURI_DB_POOL_MODE="session"   # override: "session" | "transaction" — leave
                                 # unset unless running several replicas
                                 # against one Postgres, which needs
                                 # transaction-mode safety despite not being
                                 # Vercel.
#
# (a) Bundled Postgres (COMPOSE_PROFILES=local-db) — reachable only on the Compose
#     network as host `db`; POSTGRES_PASSWORD must match the URL:
# POSTGRES_USER=zuri
# POSTGRES_PASSWORD=""
# POSTGRES_DB=zuri
# DATABASE_URL="postgresql://zuri:<POSTGRES_PASSWORD>@db:5432/zuri"
#
# (b) Supabase / external Postgres (ADR-007 P4): DATABASE_URL at the pooler and
#     DIRECT_URL at the direct connection (schema work uses DIRECT_URL, runtime the
#     pooler). Deploy the schema with prisma/schema.postgres.prisma — regenerate via
#     `npm run db:pg:schema`, apply prisma/postgres/0001_init.sql, then move data with
#     `npm run db:pg:export` on SQLite and `npm run db:pg:import` against Postgres.
# DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Customer review store: use the dedicated server-side pooler login for the private
# zuri_core schema. Provision it with scripts/provision-customer-review-runtime-login.mjs;
# do not use the migration/admin postgres URL or point the browser/Data API at review tables.
# ZURI_CUSTOMER_REVIEW_DATABASE_URL="postgresql://zuri_customer_review_login.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# CA bundle for the Supabase TLS connections above. Inside the container docker-compose.yml
# fixes this to /app/certs/supabase-prod-ca-2021.crt (the file ships in the image).
# ZURI_CUSTOMER_REVIEW_DB_CA_FILE="<repo>/certs/supabase-prod-ca-2021.crt"

# =============================================================================
# Seed / first account
# =============================================================================
# `npm run db:seed` (SQLite only) provisions the demo owner credential with this
# password; there is no fallback. A Postgres deployment creates its first account
# through /signup or `node scripts/bootstrap-operator.mjs` (FR-107).
# ZURI_SEED_OWNER_PASSWORD=""

# =============================================================================
# First-party plugin auth (FR-123 / ADR-052)
# =============================================================================
# Public client configuration only; never put a client secret or a browser
# session cookie here. Missing client/redirect configuration fails closed.
# ZURI_PLUGIN_REDIRECT_URIS is a comma-separated allowlist matched EXACTLY —
# `localhost` and `127.0.0.1` are two entries, not one. A transport that rewrites
# one spelling into the other must have both registered
# (.brain/rca/2026-08-24-plugin-auth-loopback-verifier.md).
# ZURI_PLUGIN_CLIENT_ID="zuri-plugin-v1"
# ZURI_PLUGIN_CLIENT_NAME="Zuri Plugin"
# ZURI_PLUGIN_REDIRECT_URIS="http://127.0.0.1:43123/callback"
# ZURI_PLUGIN_POLICY_SNAPSHOT_ID="zuri-plugin-policy.v1"

# =============================================================================
# Asset evidence production adapters (CR-016 / ADR-057)
# =============================================================================
# Server-only. Keep both credentials out of NEXT_PUBLIC_* and out of committed
# files. The dedicated storage credential may use the same Supabase service-role
# value operationally, but the application reads it through this narrow name.
SUPABASE_URL=""
SUPABASE_STORAGE_SERVICE_ROLE_KEY=""
ZURI_ASSET_EVIDENCE_BUCKET="asset-evidence"
OPENAI_API_KEY=""
ZURI_ASSET_EVIDENCE_MODEL="gpt-5-mini"

# =============================================================================
# Phase 1 LINE business-knowledge agent (off by default; server secrets only)
# =============================================================================
# The LINE Messaging API webhook itself is owned by the zuri-cli transport (a
# separate process holding the LINE channel secret/token). It forwards normalized
# events to THIS app at POST ${PUBLIC_BASE_URL}/api/agent/line-webhook.
ZURI_LINE_BUSINESS_AGENT_ENABLED="false"
# Required explicitly in production: PRODUCTION_LINE. Local default may be LOCAL_DEV.
ZURI_PHASE1_RUNTIME_SOURCE="LOCAL_DEV"
# Direct Postgres login role has no base-table grants. Runtime queries SET LOCAL ROLE
# to zuri_line_smartgift_ro inside a short transaction; never use postgres/service_role.
# On IPv4-only Windows use the Supavisor session pooler (port 5432). The project-qualified
# username is validated back to the dedicated login role; never substitute postgres/service_role.
# ZURI_LINE_DB_URL="postgresql://zuri_line_smartgift_login.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# ZURI_LINE_DB_CA_FILE="<repo>/certs/supabase-prod-ca-2021.crt"   # container: /app/certs/... (set by compose)
# ZURI_LINE_BINDING_HASH_PEPPER="" # random >=32 chars; secret manager only
# Production default: Supabase Vault via the private zuri_line_runtime resolver.
# Local/dev may use LOCAL_FILE only when ZURI_CREDENTIAL_VAULT_MASTER_KEY is set.
# ZURI_PHASE1_SECRET_BACKEND="SUPABASE_VAULT"
# ZURI_MODEL_PROVIDER="openrouter" # openrouter | openai | anthropic | gemini | groq
# ZURI_MODEL_NAME=""
# ZURI_MODEL_CREDENTIAL="" # OpenRouter OAuth-exchanged key or provider API key
# SUPABASE_SECRET_KEY and SUPABASE_SERVICE_ROLE_KEY are forbidden in this runtime.
# Production Phase 1 must resolve the selected IntegrationConnection secretRef
# through Supabase Vault; store only supabase-vault:<uuid> in metadata. Raw
# ZURI_MODEL_CREDENTIAL and the local file vault are dev/test-only and cannot be
# a production fallback.
# Local/dev evaluation may use Ollama only through an explicit LOCAL_DEV/TEST
# runtime source and an exact loopback URL; it is never a public LINE provider.
# Inside Docker, "loopback" is the container — Ollama on the host is not reachable
# through 127.0.0.1 and is not supported as a container provider.
# ZURI_OLLAMA_BASE_URL="http://127.0.0.1:11434"
ZURI_KNOWLEDGE_TIMEOUT_MS="5000"
ZURI_MODEL_TIMEOUT_MS="10000"

# =============================================================================
# MSP store — SEPARATE from Zuri (ADR-007 P4 boundary: Zuri DB != MSP DB)
# =============================================================================
# MSP persists in its OWN store (the D:\msp repo, reached over stdio). NEVER point this
# at DATABASE_URL — assertDbBoundary() refuses a shared store at startup.
# MSP_DB_PATH="D:/msp/data/msp.db"
# MSP_DB_URL="postgresql://postgres.<ref>:<pw>@.../postgres?schema=msp"
