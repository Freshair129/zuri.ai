# Zuri V2 lab — environment template (no secrets here). Copy to .env.

# --- Zuri database ---
# Local/test: SQLite (offline-first lab adapter). `run-local.bat` sets this
# process-locally even when the ignored .env contains the PostgreSQL runtime.
DATABASE_URL="file:./dev.db"

# PostgreSQL primary runtime: `run.bat` requires these values to be replaced with
# real server-only values. Point DATABASE_URL at the Supabase session pooler and
# DIRECT_URL at the direct connection (migrations use DIRECT_URL, runtime uses the
# pooler). Deploy the schema with
# prisma/schema.postgres.prisma — regenerate it via `npm run db:pg:schema`, apply
# the reviewed migration history, then move data with `npm run db:pg:export` (export)
# on SQLite and the import step against Postgres (UUIDs are preserved).
# DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# PostgreSQL demo seed is never implicit. Use only against an explicitly approved
# non-production target: ZURI_ALLOW_POSTGRES_SEED="1"
# The local demo session is also disabled for PostgreSQL by default. Use only against
# an approved non-production target: ZURI_ALLOW_POSTGRES_LOCAL_DEMO="1"
# Customer review store: use the dedicated server-side pooler login for the private
# zuri_core schema. Provision it with scripts/provision-customer-review-runtime-login.mjs;
# do not use the migration/admin postgres URL or point the browser/Data API at review tables.
# ZURI_CUSTOMER_REVIEW_DATABASE_URL="postgresql://zuri_customer_review_login.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Phase 1 LINE business-knowledge agent (off by default; server secrets only) ---
ZURI_LINE_BUSINESS_AGENT_ENABLED="false"
# Required explicitly in production: PRODUCTION_LINE. Local default may be LOCAL_DEV.
ZURI_PHASE1_RUNTIME_SOURCE="LOCAL_DEV"
# Direct Postgres login role has no base-table grants. Runtime queries SET LOCAL ROLE
# to zuri_line_smartgift_ro inside a short transaction; never use postgres/service_role.
# On IPv4-only Windows use the Supavisor session pooler (port 5432). The project-qualified
# username is validated back to the dedicated login role; never substitute postgres/service_role.
# ZURI_LINE_DB_URL="postgresql://zuri_line_smartgift_login.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# ZURI_LINE_DB_CA_FILE="<repo>/certs/supabase-prod-ca-2021.crt"
# ZURI_LINE_BINDING_HASH_PEPPER="" # random >=32 chars; secret manager only
# Production default: Supabase Vault via the private zuri_line_runtime resolver.
# Local/dev may use LOCAL_FILE only when ZURI_CREDENTIAL_VAULT_MASTER_KEY is set.
# ZURI_PHASE1_SECRET_BACKEND="SUPABASE_VAULT"
# ZURI_MODEL_PROVIDER="openrouter" # openrouter | openai | anthropic | gemini | groq
# ZURI_MODEL_NAME=""
# ZURI_MODEL_CREDENTIAL="" # OpenRouter OAuth-exchanged key or provider API key
# SUPABASE_SECRET_KEY and SUPABASE_SERVICE_ROLE_KEY are forbidden in this runtime.
# Production Phase 1 must resolve the selected IntegrationConnection secretRef
# through Supabase Vault; store only supabase-vault:<uuid> in metadata. Raw
# ZURI_MODEL_CREDENTIAL and the local file vault are dev/test-only and cannot be
# a production fallback.
# Local/dev evaluation may use Ollama only through an explicit LOCAL_DEV/TEST
# runtime source and an exact loopback URL; it is never a public LINE provider.
# ZURI_OLLAMA_BASE_URL="http://127.0.0.1:11434"
ZURI_KNOWLEDGE_TIMEOUT_MS="5000"
ZURI_MODEL_TIMEOUT_MS="10000"

# --- MSP store — SEPARATE from Zuri (ADR-007 P4 boundary: Zuri DB != MSP DB) ---
# MSP persists in its OWN store (the D:\msp repo, reached over stdio). NEVER point this
# at DATABASE_URL — assertDbBoundary() refuses a shared store at startup.
# MSP_DB_PATH="D:/msp/data/msp.db"
# MSP_DB_URL="postgresql://postgres.<ref>:<pw>@.../postgres?schema=msp"
