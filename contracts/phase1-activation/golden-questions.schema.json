{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zuri.local/contracts/phase1-activation/golden-questions.schema.json",
  "title": "Phase 1 Golden Question Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "expectedQueryId",
          "expectedEvidenceCodes",
          "expectedPolicy",
          "allowedNumericClaims"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^GQ-[0-9]{2,}$" },
          "question": { "type": "string", "minLength": 1, "maxLength": 500 },
          "expectedQueryId": {
            "enum": ["product_search", "product_detail", "product_compare"]
          },
          "expectedEvidenceCodes": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "minLength": 1 }
          },
          "expectedPolicy": { "enum": ["ANSWER", "FALLBACK", "DENY_PRIVATE"] },
          "allowedNumericClaims": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" }
          }
        }
      }
    }
  }
}
