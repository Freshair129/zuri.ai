{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zuri-v2://contracts/plan-envelope.schema.json",
  "title": "Zuri Project Manager Plan Envelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "workstreams"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "generatedBy": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portfolioCode": {
          "type": "string"
        },
        "tenantCode": {
          "type": "string"
        },
        "businessCode": {
          "type": "string"
        },
        "workspaceCode": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "code",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "targetAt": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "string", "format": "date" }
          ]
        },
        "externalRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalRef"
          }
        }
      }
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "executionMode",
          "progressStrategy"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "executionMode": {
            "enum": [
              "SOFTWARE_SPRINT",
              "DATA_MIGRATION",
              "B2B_SALES",
              "B2C_CAMPAIGN",
              "PRODUCT_LAUNCH",
              "OPERATIONS",
              "BUSINESS_EXPANSION"
            ]
          },
          "progressStrategy": {
            "enum": [
              "TASK_WEIGHT",
              "RECORD_VALIDATION",
              "WEIGHTED_PIPELINE",
              "KPI_ATTAINMENT",
              "MILESTONE_READINESS",
              "SLA_SCORE",
              "EXPANSION_READINESS"
            ]
          },
          "progressWeight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "containers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/container"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/item"
            }
          },
          "milestones": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/milestone"
            }
          },
          "gates": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/gate"
            }
          },
          "externalRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/externalRef"
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "executionMode": { "const": "SOFTWARE_SPRINT" } } },
            "then": {
              "properties": {
                "progressStrategy": { "const": "TASK_WEIGHT" },
                "containers": { "items": { "properties": { "subtype": { "enum": ["SPRINT", "EPIC", "RELEASE"] } } } },
                "items": { "items": { "properties": { "subtype": { "enum": ["TASK", "BUG"] }, "metrics": { "type": "object", "properties": { "completedWeight": {}, "plannedWeight": {}, "defects": {} }, "additionalProperties": false } } } }
              }
            }
          },
          {
            "if": { "properties": { "executionMode": { "const": "DATA_MIGRATION" } } },
            "then": {
              "properties": {
                "progressStrategy": { "const": "RECORD_VALIDATION" },
                "containers": { "items": { "properties": { "subtype": { "enum": ["MIGRATION_STAGE", "MIGRATION_BATCH"] } } } },
                "items": { "items": { "properties": { "subtype": { "enum": ["DATASET", "VALIDATION", "RECONCILIATION"] }, "metrics": { "type": "object", "properties": { "recordsTotal": {}, "processed": {}, "success": {}, "failed": {}, "validated": {}, "reconciled": {} }, "additionalProperties": false } } } }
              }
            }
          },
          {
            "if": { "properties": { "executionMode": { "const": "B2B_SALES" } } },
            "then": {
              "properties": {
                "progressStrategy": { "const": "WEIGHTED_PIPELINE" },
                "containers": { "items": { "properties": { "subtype": { "enum": ["SALES_PIPELINE", "SALES_STAGE"] } } } },
                "items": { "items": { "properties": { "subtype": { "enum": ["ACCOUNT", "DEAL", "ACTIVITY"] }, "metrics": { "type": "object", "properties": { "target": {}, "wonRevenue": {}, "weightedValue": {} }, "additionalProperties": false } } } }
              }
            }
          },
          {
            "if": { "properties": { "executionMode": { "const": "B2C_CAMPAIGN" } } },
            "then": {
              "properties": {
                "progressStrategy": { "const": "KPI_ATTAINMENT" },
                "containers": { "items": { "properties": { "subtype": { "enum": ["CAMPAIGN", "CAMPAIGN_WAVE", "CHANNEL"] } } } },
                "items": { "items": { "properties": { "subtype": { "enum": ["CREATIVE", "AUDIENCE", "EXPERIMENT"] }, "metrics": { "type": "object", "properties": { "spend": {}, "leads": {}, "cpa": {}, "cac": {}, "conversion": {}, "conversions": {}, "revenue": {}, "roas": {} }, "additionalProperties": false } } } }
              }
            }
          },
          {
            "if": { "properties": { "executionMode": { "const": "PRODUCT_LAUNCH" } } },
            "then": {
              "properties": {
                "progressStrategy": { "const": "MILESTONE_READINESS" },
                "containers": { "items": { "properties": { "subtype": { "enum": ["LAUNCH_PHASE"] } } } },
                "items": { "items": { "properties": { "subtype": { "enum": ["DELIVERABLE"] }, "metrics": { "type": "object", "properties": { "readiness": {}, "blockedGates": {} }, "additionalProperties": false } } } }
              }
            }
          },
          {
            "if": { "properties": { "executionMode": { "const": "OPERATIONS" } } },
            "then": {
              "properties": {
                "progressStrategy": { "const": "SLA_SCORE" },
                "containers": { "items": { "properties": { "subtype": { "enum": ["OPS_PERIOD", "OPS_PROCESS"] } } } },
                "items": { "items": { "properties": { "subtype": { "enum": ["CHECKLIST_ITEM", "ISSUE", "SLA"] }, "metrics": { "type": "object", "properties": { "slaMet": {}, "slaTotal": {}, "throughput": {}, "backlog": {}, "incidents": {}, "completed": {} }, "additionalProperties": false } } } }
              }
            }
          },
          {
            "if": { "properties": { "executionMode": { "const": "BUSINESS_EXPANSION" } } },
            "then": {
              "properties": {
                "progressStrategy": { "const": "EXPANSION_READINESS" },
                "containers": { "items": { "properties": { "subtype": { "enum": ["EXPANSION_INITIATIVE", "EXPANSION_SITE"] } } } },
                "items": { "items": { "properties": { "subtype": { "enum": ["SETUP_ACTION", "APPROVAL"] }, "metrics": { "type": "object", "properties": { "legal": {}, "location": {}, "budget": {}, "hiring": {}, "vendors": {}, "operationalReadiness": {}, "goLive": {} }, "additionalProperties": false } } } }
              }
            }
          }
        ]
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "provider"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "pathScope": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceRef",
          "targetRef",
          "type"
        ],
        "properties": {
          "sourceRef": {
            "type": "string"
          },
          "targetRef": {
            "type": "string"
          },
          "type": {
            "enum": [
              "BLOCKS",
              "REQUIRES",
              "RELATES_TO",
              "START_AFTER",
              "FINISH_BEFORE"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "container": {
      "type": "object",
      "required": [
        "code",
        "subtype",
        "title"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "parentCode": {
          "type": "string"
        },
        "subtype": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "externalRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalRef"
          }
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "code",
        "subtype",
        "title"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "containerCode": {
          "type": "string"
        },
        "subtype": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        },
        "numericValue": {
          "type": "number"
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metrics": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        },
        "externalRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalRef"
          }
        }
      },
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "required": [
        "code",
        "title"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        },
        "externalRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalRef"
          }
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": [
        "code",
        "title"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "evidence": {
          "type": "object"
        },
        "externalRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalRef"
          }
        }
      },
      "additionalProperties": false
    },
    "externalRef": {
      "type": "object",
      "required": [
        "system",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "labelAs": {
          "type": "boolean"
        }
      }
    }
  }
}
