# Market Intelligence service — variable NAMES only. Never commit real values.
# MARKET_ENV=development|test|production (production refuses sqlite, schema creation
# and assumed execution ownership).
MARKET_ENV=development
MARKET_PORT=3082
# Token the console BFF presents to this service (>= 32 chars).
MARKET_API_TOKEN=
# Token this service presents to core's /api/internal/market-intelligence/v1 (>= 32 chars, different).
MARKET_CORE_TOKEN=
MARKET_CORE_URL=http://web:3000
# sqlite (dev/test only) or postgres
MARKET_STORE=postgres
MARKET_SQLITE_PATH=
# Restricted role: SELECT, INSERT on "MarketObservation" only (see ADR-108 runbook).
MARKET_DATABASE_URL=
MARKET_STORE_ENSURE_SCHEMA=0
MARKET_TEST_ASSUME_EXECUTION_OWNER=0
