# @spec ADR-107 - blank, non-secret service configuration template.
# Local disposable configuration only. Supply secrets through a secret manager.
FILE_PORT=4401
FILE_MAX_UPLOAD_BYTES=536870912
FILE_UPLOAD_TIMEOUT_MS=600000
FILE_DATABASE_URL=postgres://file_service:local_only@127.0.0.1:5432/zuri_files
FILE_MIGRATION_DATABASE_URL=postgres://file_migrator:local_only@127.0.0.1:5432/zuri_files
FILE_STORAGE_ENDPOINT=http://127.0.0.1:9000
FILE_STORAGE_BINDING_ID=local-minio-private-files
FILE_STORAGE_BUCKET=zuri-files-private
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_ACCESS_KEY_ID=local_test_only
FILE_STORAGE_SECRET_ACCESS_KEY=local_test_only
FILE_AUTHORITY_URL=http://127.0.0.1:3000
FILE_AUTHORITY_SERVICE_TOKEN=local_test_only
