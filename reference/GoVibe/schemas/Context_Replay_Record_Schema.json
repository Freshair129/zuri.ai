{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoVibe Context Replay Record v1",
  "type": "object",
  "required": ["schema", "replay_id", "context_id", "cache_id", "requested_at", "context_reproducible", "execution_reproducible", "output_identical"],
  "properties": {
    "schema": { "const": "govibe-context-replay/v1" },
    "replay_id": { "type": "string", "minLength": 1 },
    "context_id": { "type": "string", "pattern": "^ctx_" },
    "cache_id": { "type": "string", "pattern": "^cache_" },
    "kv_id": { "type": ["string", "null"] },
    "requested_at": { "type": "string", "format": "date-time" },
    "source_versions_preserved": { "type": "boolean" },
    "context_reproducible": { "type": "boolean" },
    "execution_reproducible": { "type": "boolean" },
    "output_identical": { "type": "boolean" },
    "diagnostics": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}