{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoVibe Context Cache Record v1",
  "type": "object",
  "required": ["schema", "cache_id", "context_id", "packet_hash", "packet"],
  "properties": {
    "schema": { "const": "govibe-context-cache/v1" },
    "cache_id": { "type": "string", "pattern": "^cache_" },
    "context_id": { "type": "string", "pattern": "^ctx_" },
    "packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "packet": { "type": "object" }
  },
  "additionalProperties": false
}