{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoVibe Impact Query v1",
  "type": "object",
  "required": ["schema", "workspace_path", "change_type", "seeds"],
  "properties": {
    "schema": { "const": "govibe-impact-query/v1" },
    "workspace_path": { "type": "string", "minLength": 1 },
    "change_type": { "enum": ["editorial", "schema_additive", "schema_breaking", "semantic_change", "authority_boundary_change", "runtime_behavior_change"] },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "value"],
        "properties": {
          "kind": { "enum": ["path", "document_id", "atom_id", "symbol_id", "concept"] },
          "value": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "max_distance": { "type": "integer", "minimum": 1, "maximum": 8, "default": 3 },
    "minimum_score": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.2 },
    "include_unresolved": { "type": "boolean", "default": true }
  },
  "additionalProperties": false
}
