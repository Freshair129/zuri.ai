{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoVibe KV Cache Record v1",
  "type": "object",
  "required": ["schema", "kv_id", "cache_id", "model_id", "tokenizer_id", "tool_schema_hash", "system_context_hash", "context_hash", "created_at", "status"],
  "properties": {
    "schema": { "const": "govibe-kv-cache-record/v1" },
    "kv_id": { "type": "string", "minLength": 1 },
    "cache_id": { "type": "string", "pattern": "^cache_" },
    "model_id": { "type": "string", "minLength": 1 },
    "model_version": { "type": ["string", "null"] },
    "tokenizer_id": { "type": "string", "minLength": 1 },
    "runtime_id": { "type": ["string", "null"] },
    "tool_schema_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "system_context_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "context_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ordering_version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "invalidated", "expired", "deleted"] },
    "invalidated_reason": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}