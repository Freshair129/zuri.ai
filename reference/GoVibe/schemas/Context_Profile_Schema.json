{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoVibe Context Profile v1",
  "type": "object",
  "required": ["schema", "profile_id", "sources", "sync_mode"],
  "properties": {
    "schema": { "const": "govibe-context-profile/v1" },
    "profile_id": { "enum": ["T-ctx", "V-ctx", "W-ctx", "M-ctx"] },
    "sources": {
      "type": "array",
      "items": { "enum": ["system", "task_event", "global_private_vault", "workspace_private_vault", "shared_vault", "active_workflow", "realtime_shared_context"] }
    },
    "sync_mode": { "enum": ["snapshot", "load_on_start", "workflow_checkpoint", "every_turn"] },
    "workflow_limit": { "type": "integer", "minimum": 0, "maximum": 1 },
    "diff_required": { "type": "boolean" },
    "private_history_implicit": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "profile_id": { "const": "T-ctx" } } }, "then": { "properties": { "private_history_implicit": { "const": false }, "workflow_limit": { "const": 0 }, "sync_mode": { "const": "snapshot" } } } },
    { "if": { "properties": { "profile_id": { "const": "W-ctx" } } }, "then": { "properties": { "workflow_limit": { "const": 1 } } } },
    { "if": { "properties": { "profile_id": { "const": "M-ctx" } } }, "then": { "properties": { "sync_mode": { "const": "every_turn" }, "diff_required": { "const": true } } } }
  ],
  "additionalProperties": false
}