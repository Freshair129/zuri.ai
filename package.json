{
  "name": "zuri-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Zuri v2 Project Manager — offline-first standalone lab build",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "node --env-file-if-exists=.env scripts/assert-sqlite-runtime.mjs && prisma db push",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "db:clean": "node --env-file-if-exists=.env scripts/assert-sqlite-runtime.mjs && prisma db push --force-reset",
    "db:reset": "node --env-file-if-exists=.env scripts/assert-sqlite-runtime.mjs && prisma db push --force-reset && node --env-file-if-exists=.env prisma/seed.js",
    "db:pg:schema": "node scripts/gen-postgres-schema.mjs",
    "db:pg:sql": "npm run db:pg:schema && prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.postgres.prisma --script > prisma/postgres/0001_init.sql",
    "db:pg:verify": "node --env-file-if-exists=.env scripts/verify-postgres-runtime.mjs",
    "db:pg:export": "node scripts/migrate-to-postgres.mjs export snapshot.json",
    "db:pg:import": "node scripts/migrate-to-postgres.mjs import snapshot.json",
    "test": "node scripts/assert-tests-ran.mjs vitest run",
    "test:unit": "node scripts/assert-tests-ran.mjs vitest run tests/unit",
    "test:integration": "node scripts/assert-tests-ran.mjs vitest run tests/integration",
    "test:e2e": "node scripts/assert-tests-ran.mjs playwright test --fail-on-flaky",
    "verify": "npm test && npm run build && npm run govern && npm run test:e2e",
    "postinstall": "node scripts/generate-prisma-clients.mjs",
    "docs:graph": "node scripts/doc-graph.mjs",
    "docs:check": "node scripts/doc-graph.mjs --check",
    "docs:preflight": "node scripts/doc-preflight.mjs --strict",
    "docs:preflight:report": "node scripts/doc-preflight.mjs",
    "govern": "npm run docs:graph && npm run docs:check && npm run docs:preflight",
    "phase1:evaluate": "node scripts/evaluate-phase1-golden.mjs",
    "phase1:isolation:verify": "node scripts/verify-line-runtime-isolation.mjs",
    "phase1:canary:plan": "node scripts/plan-line-canary.mjs",
    "phase1:line-binding": "node scripts/manage-line-binding.mjs",
    "self:plan": "node scripts/self-plan.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@prisma/client": "5.22.0",
    "date-fns": "3.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "0.474.0",
    "next": "14.2.35",
    "pg": "8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "supabase": "2.114.0",
    "tailwindcss": "3.4.17",
    "vitest": "2.1.9"
  }
}
