{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zuri-v2://contracts/plan-envelope.schema.json",
  "title": "Zuri Project Manager Plan Envelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "workstreams"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "generatedBy": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portfolioCode": {
          "type": "string"
        },
        "tenantCode": {
          "type": "string"
        },
        "businessCode": {
          "type": "string"
        },
        "workspaceCode": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "code",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "externalRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalRef"
          }
        }
      }
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "executionMode",
          "progressStrategy"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "executionMode": {
            "enum": [
              "SOFTWARE_SPRINT",
              "DATA_MIGRATION",
              "B2B_SALES",
              "B2C_CAMPAIGN",
              "PRODUCT_LAUNCH",
              "OPERATIONS",
              "BUSINESS_EXPANSION"
            ]
          },
          "progressStrategy": {
            "enum": [
              "TASK_WEIGHT",
              "RECORD_VALIDATION",
              "WEIGHTED_PIPELINE",
              "KPI_ATTAINMENT",
              "MILESTONE_READINESS",
              "SLA_SCORE",
              "EXPANSION_READINESS"
            ]
          },
          "progressWeight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "containers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/container"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/item"
            }
          },
          "milestones": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/milestone"
            }
          },
          "gates": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/gate"
            }
          },
          "externalRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/externalRef"
            }
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "provider"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "pathScope": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceRef",
          "targetRef",
          "type"
        ],
        "properties": {
          "sourceRef": {
            "type": "string"
          },
          "targetRef": {
            "type": "string"
          },
          "type": {
            "enum": [
              "BLOCKS",
              "REQUIRES",
              "RELATES_TO",
              "START_AFTER",
              "FINISH_BEFORE"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "container": {
      "type": "object",
      "required": [
        "code",
        "subtype",
        "title"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "parentCode": {
          "type": "string"
        },
        "subtype": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "externalRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalRef"
          }
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "code",
        "subtype",
        "title"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "containerCode": {
          "type": "string"
        },
        "subtype": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        },
        "numericValue": {
          "type": "number"
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metrics": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        },
        "externalRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalRef"
          }
        }
      },
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "required": [
        "code",
        "title"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        },
        "externalRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalRef"
          }
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": [
        "code",
        "title"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "evidence": {
          "type": "object"
        },
        "externalRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalRef"
          }
        }
      },
      "additionalProperties": false
    },
    "externalRef": {
      "type": "object",
      "required": [
        "system",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "labelAs": {
          "type": "boolean"
        }
      }
    }
  }
}
